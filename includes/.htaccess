# Sherubtse College — /includes access control
# -----------------------------------------------------------------------
# Defence in depth: header.php/footer.php/etc. already refuse to run
# without the SHERUBTSE_INIT constant (see the guard block at the top
# of each file), but on Apache we also block the HTTP requests outright
# so the guard is never even reached from outside.

# Deny all direct requests to anything in this folder.
<FilesMatch "\.(php|inc)$">
    Require all denied
</FilesMatch>

# Disable directory listing.
Options -Indexes

# Belt-and-braces for older Apache (mod_access_compat) environments:
# <FilesMatch "\.(php|inc)$">
#     Order allow,deny
#     Deny from all
# </FilesMatch>
