---
// Self-hosted, Latin subset only, three weights max per family (Style
// Guide §03/§09): Public Sans 400/500/700, Source Serif 4 600/700 (the
// serif is heading-only, so 400 isn't needed).
import '@fontsource/public-sans/latin-400.css';
import '@fontsource/public-sans/latin-500.css';
import '@fontsource/public-sans/latin-700.css';
import '@fontsource/source-serif-4/latin-600.css';
import '@fontsource/source-serif-4/latin-700.css';
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/layout.css';
import '../styles/motion.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomTabs from '../components/BottomTabs.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Sherubtse College</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <a href="#main-content" class="sr-only-focusable">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <BottomTabs />
  </body>
</html>

<style is:global>
  .sr-only-focusable {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--gold);
    color: var(--ink);
    padding: var(--s3) var(--s4);
    z-index: 100;
    font-weight: 700;
  }
  .sr-only-focusable:focus {
    left: var(--s4);
    top: var(--s4);
  }
</style>

<script>
  // Site-wide scroll-reveal: content fades/slides in once, the first time
  // it enters the viewport. Applied here rather than sprinkled through
  // every template — these are the content-block classes that already
  // exist consistently across the ten page templates (cards, unit
  // sections, listing rows, people grids, article bodies, attachments),
  // so this covers the whole site without touching each one individually.
  // No dropdowns, no hover-dependent behaviour — this only ever runs once
  // per element, on scroll-into-view, matching the rest of the site's
  // "no hover-dependent anything" rule.
  const REVEAL_SELECTOR = [
    '#main-content .card',
    '#main-content .band',
    '#main-content .notice-row',
    '#main-content .person',
    '#main-content .article-body',
    '#main-content .attachment',
    // A generic opt-in for a page that wants a specific element revealed
    // individually (not just the whole .band section) — e.g. History &
    // Heritage's portrait cards. Marking an element .reveal in a
    // template does nothing on its own without this: the CSS sets
    // opacity: 0 immediately since it's in the server-rendered HTML, and
    // only this script's own IntersectionObserver ever adds is-visible.
    '#main-content .reveal',
  ].join(', ');

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = Array.from(document.querySelectorAll<HTMLElement>(REVEAL_SELECTOR));

  if (targets.length > 0 && !prefersReducedMotion && 'IntersectionObserver' in window) {
    targets.forEach((el, i) => {
      el.classList.add('reveal');
      el.style.transitionDelay = `${(i % 8) * 60}ms`;
    });

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );

    targets.forEach((el) => observer.observe(el));
  }
</script>
