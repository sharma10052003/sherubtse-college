---
// Listing — announcements, news, events, recruitment, tenders, archive.
// Same look as the section landing pages (About, Academics …): the header
// with eyebrow / title / gold rule, then each item as a bordered card with a
// date block, a serif title and tags. Filters, not a menu (Style Guide §07).
// Paginated at 20 with "Load more" rather than infinite scroll (Stack doc §08);
// rows past the first page ride along in a <template> so nothing needs a
// request.
import Layout from '../../layouts/Layout.astro';
import '../../styles/section-landing.css';
import '../../styles/listing.css';

interface Row {
  id: number | string;
  href: string;
  date?: string;
  title: string;
  tags?: string[];
  meta?: string;
}
interface Props {
  title: string;
  breadcrumb: { label: string; url: string }[];
  rows: Row[];
  archiveHref?: string;
}
const { title, breadcrumb, rows, archiveHref } = Astro.props;
const PAGE_SIZE = 20;
const firstPage = rows.slice(0, PAGE_SIZE);
const rest = rows.slice(PAGE_SIZE);

// The section this listing belongs to (the breadcrumb entry above the current
// page) doubles as the small label over the title.
const eyebrow = breadcrumb.length > 1 ? breadcrumb[breadcrumb.length - 2].label : undefined;

// "21 Jul 2026" -> day / month / year blocks; anything else is shown as-is.
function dateParts(d?: string) {
  const p = (d ?? '').trim().split(/\s+/);
  return p.length === 3 ? { day: p[0], month: p[1], year: p[2] } : null;
}
---
<Layout title={title}>
  <header class="sl-head">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        {breadcrumb.map((b, i) => (
          <>
            {i > 0 && ' › '}
            {i === breadcrumb.length - 1 ? <span class="current">{b.label}</span> : <a href={b.url}>{b.label}</a>}
          </>
        ))}
      </nav>
      {eyebrow && <p class="sl-eyebrow">{eyebrow}</p>}
      <h1 class="sl-title">{title}</h1>
      <span class="sl-rule" aria-hidden="true"></span>
    </div>
  </header>

  <div class="ls-body">
    <div class="wrap">
      <div id="listingRows" class="ls-list">
        {firstPage.map((r) => {
          const d = dateParts(r.date);
          return (
            <article class="ls-row">
              {d ? (
                <div class="ls-date" aria-label={r.date}>
                  <span class="ls-day">{d.day}</span>
                  <span class="ls-month">{d.month}</span>
                  <span class="ls-year">{d.year}</span>
                </div>
              ) : r.date ? (
                <div class="ls-date"><span class="ls-month">{r.date}</span></div>
              ) : null}
              <div class="ls-main">
                <h2 class="ls-title"><a href={r.href} class="ls-link">{r.title}</a></h2>
                {(r.tags?.length || r.meta) && (
                  <p class="ls-meta">
                    {r.tags?.map((t) => <span class="ls-tag">{t}</span>)}
                    {r.meta && <span class="ls-unit">{r.meta}</span>}
                  </p>
                )}
              </div>
              <span class="ls-arrow" aria-hidden="true">→</span>
            </article>
          );
        })}
      </div>

      {rest.length > 0 && (
        <template id="moreRows">
          {rest.map((r) => {
            const d = dateParts(r.date);
            return (
              <article class="ls-row">
                {d ? (
                  <div class="ls-date" aria-label={r.date}>
                    <span class="ls-day">{d.day}</span>
                    <span class="ls-month">{d.month}</span>
                    <span class="ls-year">{d.year}</span>
                  </div>
                ) : r.date ? (
                  <div class="ls-date"><span class="ls-month">{r.date}</span></div>
                ) : null}
                <div class="ls-main">
                  <h2 class="ls-title"><a href={r.href} class="ls-link">{r.title}</a></h2>
                  {(r.tags?.length || r.meta) && (
                    <p class="ls-meta">
                      {r.tags?.map((t) => <span class="ls-tag">{t}</span>)}
                      {r.meta && <span class="ls-unit">{r.meta}</span>}
                    </p>
                  )}
                </div>
                <span class="ls-arrow" aria-hidden="true">→</span>
              </article>
            );
          })}
        </template>
      )}

      {rows.length === 0 && <p class="ls-empty">Nothing to show here yet.</p>}

      <div class="ls-actions">
        {rest.length > 0 && <button type="button" id="loadMoreBtn" class="btn btn-secondary">Load more</button>}
        {archiveHref && <a href={archiveHref} class="btn-quiet">Archive</a>}
      </div>
    </div>
  </div>
</Layout>

<script>
  // The one interactive listing behaviour — "Load more", not infinite scroll
  // (Stack doc §08).
  const btn = document.getElementById('loadMoreBtn');
  const more = document.getElementById('moreRows') as HTMLTemplateElement | null;
  const target = document.getElementById('listingRows');
  btn?.addEventListener('click', () => {
    if (more && target) {
      target.appendChild(more.content.cloneNode(true));
    }
    btn.remove();
  });
</script>
