---
// Line-art icons for the Vision, Mission & Core Values page. Every stroke
// carries pathLength="1" so the page CSS can draw it in with a single
// stroke-dashoffset transition, whatever the path's real length.
interface Props {
  name: string;
  size?: number;
}
const { name, size = 40 } = Astro.props;
---
<svg class="vm-icon" viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'professionalism' && (
    <>
      <path pathLength="1" d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z" />
      <path pathLength="1" d="M8.5 12l2.5 2.5 4.5-5" />
    </>
  )}
  {name === 'innovation' && (
    <>
      <path pathLength="1" d="M12 3a6 6 0 0 0-3.8 10.6c.7.6 1 1.4 1 2.4h5.6c0-1 .3-1.8 1-2.4A6 6 0 0 0 12 3z" />
      <path pathLength="1" d="M9.5 19h5M10.5 21.5h3" />
      <path pathLength="1" d="M12 6.5v3M10.5 8h3" />
    </>
  )}
  {name === 'learning' && (
    <>
      <path pathLength="1" d="M3 5.5c2.7-1 5.7-1 9 1 3.3-2 6.3-2 9-1V19c-2.7-1-5.7-1-9 1-3.3-2-6.3-2-9-1V5.5z" />
      <path pathLength="1" d="M12 6.5V20" />
    </>
  )}
  {name === 'ownership' && (
    <>
      <path pathLength="1" d="M4 11.5L12 5l8 6.5" />
      <path pathLength="1" d="M6 10v9.5h12V10" />
      <path pathLength="1" d="M12 17.5c-2-1.3-3-2.6-3-3.8a1.6 1.6 0 0 1 3-.8 1.6 1.6 0 0 1 3 .8c0 1.2-1 2.5-3 3.8z" />
    </>
  )}
  {name === 'community' && (
    <>
      <path pathLength="1" d="M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
      <path pathLength="1" d="M16 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
      <path pathLength="1" d="M2.5 20c0-3 2.5-5.5 5.5-5.5s5.5 2.5 5.5 5.5" />
      <path pathLength="1" d="M14.5 14.8c.5-.2 1-.3 1.5-.3 3 0 5.5 2.5 5.5 5.5" />
    </>
  )}
  {name === 'excellence' && (
    <>
      <path pathLength="1" d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3z" />
    </>
  )}
  {name === 'mission-learning' && (
    <>
      <path pathLength="1" d="M2 9l10-5 10 5-10 5L2 9z" />
      <path pathLength="1" d="M6 11v5c3.5 2.3 8.5 2.3 12 0v-5" />
      <path pathLength="1" d="M22 9v6" />
    </>
  )}
  {name === 'mission-research' && (
    <>
      <path pathLength="1" d="M12 12L5 6M12 12l7-6M12 12v7" />
      <path pathLength="1" d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" />
      <path pathLength="1" d="M5 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" />
      <path pathLength="1" d="M19 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" />
      <path pathLength="1" d="M12 22a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" />
    </>
  )}
</svg>
