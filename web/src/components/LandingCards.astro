---
// The boxes on landing pages (About, Academics): an even grid of rounded,
// navy-outlined cards that fill with navy, lift and tilt toward the pointer
// on hover, and rise into view one after another. Cards come from the
// page's Strapi overview type; `meta` is an optional small live note
// ("47 faculty profiles"). Styles: landing-cards.css (.lc).
import '../styles/landing-cards.css';

export interface LandingCardItem {
  label: string;
  url: string;
  description?: string | null;
  icon?: string;
  meta?: string;
}
interface Props {
  cards: LandingCardItem[];
  exploreLabel: string;
  label: string;
}
const { cards, exploreLabel, label } = Astro.props;

const ICONS: Record<string, string> = {
  college: '<path d="M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6"/>',
  history: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  vision: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  people: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.4c2 .7 3.5 2.6 3.5 5.6"/>',
  alumni: '<path d="m2 9 10-5 10 5-10 5z"/><path d="M6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/><path d="M22 9v6"/>',
  pin: '<path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  briefcase: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V4h8v3M3 13h18"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 6l9 7 9-7"/>',
  departments: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  cap: '<path d="m2 9 10-5 10 5-10 5z"/><path d="M6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/><path d="M22 9v6"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/><path d="M8 14h3v3H8z"/>',
  exam: '<path d="M7 3h10v18H7z"/><path d="M10 7h4M10 11h4"/><path d="m10 15.5 1.5 1.5 3-3"/>',
  scale: '<path d="M12 3v18M7 21h10"/><path d="M5 7h14"/><path d="m5 7-3 6a3 3 0 0 0 6 0zM19 7l-3 6a3 3 0 0 0 6 0z"/>',
  book: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5"/><path d="M8 7h8M8 11h6"/>',
  support: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/><path d="M9 11h6M12 8v6"/>',
  home: '<path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-5h4v5"/>',
  sport: '<circle cx="12" cy="12" r="8.5"/><path d="M12 3.5v17M3.5 12h17"/><path d="M6 6c3 2.5 3 9.5 0 12M18 6c-3 2.5-3 9.5 0 12"/>',
  clubs: '<circle cx="8" cy="8" r="3"/><circle cx="16.5" cy="9" r="2.5"/><path d="M2.5 20a5.5 5.5 0 0 1 11 0"/><path d="M13.5 15.2A4.5 4.5 0 0 1 21 18.5"/>',
  page: '<path d="M6 2h9l5 5v15H6z"/><path d="M14 2v6h6"/>',
};
const GUESS: [RegExp, string][] = [
  [/counsel|support|wellbeing|well-being|student service/i, 'support'],
  [/hostel|residen|accommod|housing/i, 'home'],
  [/sport|game|recreat|athlet/i, 'sport'],
  [/club|societ|union|associat/i, 'clubs'],
  [/handbook|guide/i, 'book'],
  [/history|heritage/i, 'history'],
  [/vision|mission|value/i, 'vision'],
  [/alumni/i, 'alumni'],
  [/faculty|staff|people/i, 'people'],
  [/campus|facilit|location/i, 'pin'],
  [/unit|office|administration/i, 'briefcase'],
  [/contact/i, 'mail'],
  [/department/i, 'departments'],
  [/programme|program|course|degree/i, 'cap'],
  [/calendar|date|schedule/i, 'calendar'],
  [/exam|assessment|result/i, 'exam'],
  [/regulation|rule|policy|polic/i, 'scale'],
  [/library|journal|resource/i, 'book'],
  [/about|college|leadership/i, 'college'],
];
const iconFor = (c: LandingCardItem) => (c.icon && ICONS[c.icon] ? c.icon : GUESS.find(([re]) => re.test(c.label))?.[1] ?? 'page');
const items = cards.filter((c) => c.label && c.url).map((c) => ({ ...c, icon: iconFor(c) }));
const external = (url: string) => /^https?:\/\//i.test(url);
const arrow = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
{items.length > 0 && (
  <ul class="lc lc-grid" aria-label={label} data-lc>
    {items.map((c, i) => (
      <li class="lc-card" data-lc-card data-lc-reveal style={`--i:${i}`}>
        <span class="lc-card-fill" aria-hidden="true"></span>
        <span class="lc-card-glow" aria-hidden="true"></span>
        <svg class="lc-card-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[c.icon]} />
        <div class="lc-card-top">
          <span class="lc-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[c.icon]} />
          </span>
          {c.meta && <span class="lc-card-meta">{c.meta}</span>}
        </div>
        <div class="lc-card-body">
          <h2 class="lc-card-title">
            <a href={c.url} {...(external(c.url) ? { target: '_blank', rel: 'noopener' } : {})}>{c.label}</a>
          </h2>
          {c.description && <p class="lc-card-text">{c.description}</p>}
        </div>
        <span class="lc-card-go" aria-hidden="true">{exploreLabel} <Fragment set:html={arrow} /></span>
      </li>
    ))}
  </ul>
)}

<script is:inline>
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    document.querySelectorAll('[data-lc]').forEach((grid) => {
      if (grid.dataset.lcReady) return;
      grid.dataset.lcReady = '1';
      // A spotlight that follows the pointer and a gentle 3D tilt.
      if (!reduce && fine) {
        grid.querySelectorAll('[data-lc-card]').forEach((card) => {
          card.addEventListener('pointermove', (e) => {
            const r = card.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width;
            const y = (e.clientY - r.top) / r.height;
            card.style.setProperty('--mx', `${e.clientX - r.left}px`);
            card.style.setProperty('--my', `${e.clientY - r.top}px`);
            card.style.setProperty('--ry', `${(x - 0.5) * 6}deg`);
            card.style.setProperty('--rx', `${(0.5 - y) * 6}deg`);
          });
          card.addEventListener('pointerleave', () => {
            card.style.setProperty('--rx', '0deg');
            card.style.setProperty('--ry', '0deg');
          });
        });
      }
      // Boxes rise into view one after another.
      if (reduce || !('IntersectionObserver' in window)) return;
      grid.classList.add('lc-anim');
      const io = new IntersectionObserver((entries) => entries.forEach((en) => {
        if (!en.isIntersecting) return;
        en.target.classList.add('is-in');
        io.unobserve(en.target);
      }), { rootMargin: '0px 0px -6% 0px', threshold: 0.05 });
      grid.querySelectorAll('[data-lc-reveal]').forEach((el) => io.observe(el));
    });
  })();
</script>
