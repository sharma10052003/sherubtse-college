---
// Mobile-only fixed bottom tab bar — Stack doc §08 / Style Guide §09's
// named exception to "no fixed elements". Exactly four destinations: the
// site's highest-frequency actions, not a second copy of the main menu.
//
// Icons are inline SVG, not emoji (Phase 3.2) — emoji render differently
// per platform/font and can't take the current text colour, so the
// selected tab couldn't turn gold like everything else on the site.
// `stroke="currentColor"` fixes both problems at once.
const currentPath = Astro.url.pathname;
const tabs = [
  {
    href: '/',
    label: 'Home',
    icon: '<path d="M3 11l9-8 9 8"/><path d="M5 10v10a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10"/>',
  },
  {
    href: '/academics/calendar',
    label: 'Calendar',
    icon: '<rect x="3" y="5" width="18" height="16" rx="1"/><path d="M8 3v4M16 3v4M3 10h18"/>',
  },
  {
    href: '/news-notices/announcements',
    label: 'Notices',
    icon: '<path d="M12 3a5 5 0 0 0-5 5v3.5c0 .7-.28 1.37-.78 1.87L5 15h14l-1.22-1.63A2.66 2.66 0 0 1 17 11.5V8a5 5 0 0 0-5-5z"/><path d="M9.5 18a2.5 2.5 0 0 0 5 0"/>',
  },
  {
    href: '/search',
    label: 'Search',
    icon: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.8-4.8"/>',
  },
];
---
<nav class="bottom-tabs" aria-label="Quick access">
  {tabs.map((tab) => (
    <a href={tab.href} aria-current={currentPath === tab.href ? 'page' : undefined}>
      <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={tab.icon} />
      <span>{tab.label}</span>
    </a>
  ))}
</nav>
