---
// Simple link cards (e.g. Academics, Admissions, Research).
import type { LinkCard } from '../../lib/content/homepage';
interface Props { cards: LinkCard[] }
const { cards } = Astro.props;
const arrow = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
<ul class="hm-links hm-links--cards">
  {cards.map((l, i) => (
    <li data-reveal style={`--i:${i}`}>
      <a href={l.url}>
        <span class="hm-link-label">{l.label} <Fragment set:html={arrow} /></span>
        {l.description && <span class="hm-link-desc">{l.description}</span>}
      </a>
    </li>
  ))}
</ul>
