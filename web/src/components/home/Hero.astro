---
// Homepage hero (Home – Page → hero fields). The photo is the poster, the
// phone fallback and the reduced-motion fallback; the video is attached by
// HomeRuntime only after the page has loaded, only on wide screens (unless
// “Hero video on phones” is ticked) and never for visitors who prefer
// reduced motion — so it never delays the first paint.
import type { Homepage, HomeLabels } from '../../lib/content/homepage';
import Img from './Img.astro';

interface Props { hero: Homepage['hero']; labels: HomeLabels }
const { hero, labels } = Astro.props;
const arrow = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
<section class:list={['hm-hero', `hm-hero--${hero.overlay}`, `hm-hero--${hero.align}`, { 'hm-hero--ticker': hero.ticker.length > 0 }]} aria-labelledby="hm-hero-h">
  <div class="hm-hero-media" aria-hidden={hero.image?.alt ? undefined : 'true'}>
    {hero.image && <Img image={hero.image} class="hm-hero-img" eager sizes="100vw" />}
    {hero.video_url && (
      <video
        class="hm-hero-video"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        poster={hero.image?.src}
        data-hero-video={hero.video_url}
        data-phones={hero.video_on_phones ? '1' : '0'}
      ></video>
    )}
  </div>
  <div class="hm-hero-shade" aria-hidden="true"></div>
  <div class="wrap hm-hero-inner">
    {hero.eyebrow && <p class="hm-hero-eyebrow hm-rise" style="--d:0">{hero.eyebrow}</p>}
    <h1 class="hm-hero-title hm-rise" id="hm-hero-h" style="--d:1">{hero.heading}</h1>
    {hero.statement && <p class="hm-hero-text hm-rise" style="--d:2">{hero.statement}</p>}
    {hero.buttons.length > 0 && (
      <div class="hm-hero-actions hm-rise" style="--d:3">
        {hero.buttons.map((b, i) => (
          <a class:list={['hm-hero-btn', i === 0 ? 'hm-hero-btn--gold' : i === 1 ? 'hm-hero-btn--line' : 'hm-hero-btn--text']} href={b.url}>
            {b.label} {i === 2 && <Fragment set:html={arrow} />}
          </a>
        ))}
      </div>
    )}
    {hero.badge && (
      <p class="hm-hero-badge hm-rise" style="--d:4">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 2 7l10 5 10-5-10-5z" /><path d="M6 10v6c0 1.5 3 3 6 3s6-1.5 6-3v-6" /></svg>
        {hero.badge}
      </p>
    )}
  </div>
  {hero.ticker.length > 0 && (
    <div class="hm-ticker" role="region" aria-label={labels.ticker_label} style={`--dur:${Math.max(30, hero.ticker.length * 7)}s`}>
      <span class="hm-ticker-label"><span class="hm-ticker-dot" aria-hidden="true"></span>{labels.ticker_label}</span>
      <div class="hm-ticker-viewport">
        {[0, 1].map((copy) => (
          <ul class="hm-ticker-track" aria-hidden={copy === 1 ? 'true' : undefined}>
            {hero.ticker.map((t) => (
              <li class:list={{ 'is-urgent': t.urgent }}>
                <span class="hm-ticker-tag">{t.label}</span>
                <a href={t.href} tabindex={copy === 1 ? -1 : undefined}>{t.title}</a>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  )}
  {hero.video_url && (
    <button type="button" class="hm-hero-toggle" data-hero-toggle aria-pressed="false" hidden data-pause={labels.pause_video} data-play={labels.play_video}>
      <span class="hm-hero-toggle-icon" aria-hidden="true"></span>
      <span class="hm-sr" data-hero-toggle-label>{labels.pause_video}</span>
    </button>
  )}
</section>
