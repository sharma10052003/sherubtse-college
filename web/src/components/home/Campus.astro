---
// Student Life & Campus — kept minimal on the homepage: one row of campus facilities read from
// Strapi (featured first), each with its photo or a designed icon tile. Everything else
// (all facilities, clubs, filters) lives on the Campus Facilities and Student Life pages that the
// section's "view all" button opens. Picture cards added to this section in Strapi come first.
import Img from './Img.astro';
import { icon } from '../../lib/facility-icons';
import type { Section, HomeLabels } from '../../lib/content/homepage';
type S = Extract<Section, { kind: 'campus' }>;
interface Props { s: S; labels: HomeLabels }
const { s, labels } = Astro.props;
const SHOWN = 5;
const arrow = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const cards = [
  ...s.items.map((c) => ({ name: c.title, href: c.href ?? null, summary: c.summary ?? null, category: c.category, image: c.image, icon: 'star', featured: false })),
  ...s.facilities.map((f) => ({ name: f.name, href: f.href as string | null, summary: f.summary, category: f.category, image: f.image, icon: f.icon, featured: f.featured })),
].slice(0, SHOWN);
---
<ul class="hm-cp-grid">
  {cards.map((c, i) => (
    <li class="hm-cp-item" data-reveal style={`--i:${i}`}>
      <article class:list={['hm-cp-card', { 'hm-cp-card--featured': c.featured }]}>
        <a class="hm-cp-media" href={c.href ?? '#'} tabindex="-1" aria-hidden="true">
          {c.image
            ? <Img image={c.image} class="hm-cp-img" sizes="(min-width: 1100px) 20vw, (min-width: 640px) 45vw, 100vw" />
            : <span class="hm-cp-tile"><span set:html={icon(c.icon)} /></span>}
        </a>
        <div class="hm-cp-body">
          {c.category && <p class="hm-cp-cat">{c.category}</p>}
          <h3 class="hm-cp-name">{c.href ? <a href={c.href}>{c.name}</a> : c.name}</h3>
          {c.summary && <p class="hm-cp-sum">{c.summary}</p>}
          {c.href && <span class="hm-cp-go" aria-hidden="true">{labels.learn_more} <Fragment set:html={arrow} /></span>}
        </div>
      </article>
    </li>
  ))}
</ul>
