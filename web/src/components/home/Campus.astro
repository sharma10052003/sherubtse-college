---
// Student Life & Campus — everything is read from Strapi, so the numbers and lists are always the
// real ones: every campus facility (Campus Facilities), every active club and unit (Student Life
// → Clubs), and any picture cards added to this section. Three live figures count up; two tabs switch
// between "Campus facilities" and "Clubs & societies"; each tab filters by category. Facilities show
// their photo, or a designed tile with the category icon when there is none.
import Img from './Img.astro';
import { icon } from '../../lib/facility-icons';
import type { Section, HomeLabels } from '../../lib/content/homepage';
type S = Extract<Section, { kind: 'campus' }>;
interface Props { s: S; labels: HomeLabels }
const { s, labels } = Astro.props;
const arrow = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const CLUB_SHOWN = 8;
const facCats = [...new Set(s.facilities.map((f) => f.category).filter(Boolean))] as string[];
const clubCats = [...new Set(s.clubs.map((c) => c.category).filter(Boolean))] as string[];
const has = { fac: s.facilities.length + s.items.length > 0, clubs: s.clubs.length > 0 };
const figures = [
  { n: s.facilities.length, label: labels.campus_facilities },
  { n: s.clubs.length, label: labels.campus_clubs },
  { n: clubCats.length, label: labels.campus_areas },
].filter((f) => f.n > 0);
---
<div class="hm-cp" data-cp>
  {figures.length > 0 && (
    <ul class="hm-cp-figs">
      {figures.map((f) => <li><strong data-cp-count={f.n}>{f.n}</strong><span>{f.label}</span></li>)}
    </ul>
  )}

  {has.fac && has.clubs && (
    <div class="hm-cp-tabs" role="tablist" aria-label="Student life and campus">
      <button type="button" role="tab" class="hm-cp-tab is-on" data-cp-tab="fac" aria-selected="true">{labels.campus_facilities_tab} <em>{s.facilities.length + s.items.length}</em></button>
      <button type="button" role="tab" class="hm-cp-tab" data-cp-tab="clubs" aria-selected="false">{labels.campus_clubs_tab} <em>{s.clubs.length}</em></button>
    </div>
  )}

  {has.fac && (
    <div class="hm-cp-panel" data-cp-panel="fac" role="tabpanel">
      {facCats.length > 1 && (
        <div class="hm-cp-chips" role="group" aria-label="Facility type">
          <button type="button" class="hm-cp-chip is-on" data-cp-cat="" aria-pressed="true">{labels.tab_all}</button>
          {facCats.map((c) => <button type="button" class="hm-cp-chip" data-cp-cat={c} aria-pressed="false">{c}</button>)}
        </div>
      )}
      <ul class="hm-cp-grid">
        {s.items.map((c, i) => (
          <li class="hm-cp-item" data-cp-item data-cat="" data-reveal style={`--i:${i % 4}`}>
            <article class="hm-cp-card">
              <a class="hm-cp-media" href={c.href ?? '#'} tabindex="-1" aria-hidden="true">{c.image ? <Img image={c.image} class="hm-cp-img" sizes="(min-width: 1100px) 24vw, (min-width: 640px) 45vw, 100vw" /> : <span class="hm-cp-tile"><span set:html={icon('star')} /></span>}</a>
              <div class="hm-cp-body">
                {c.category && <p class="hm-cp-cat">{c.category}</p>}
                <h3 class="hm-cp-name">{c.href ? <a href={c.href}>{c.title}</a> : c.title}</h3>
                {c.summary && <p class="hm-cp-sum">{c.summary}</p>}
              </div>
            </article>
          </li>
        ))}
        {s.facilities.map((f, i) => (
          <li class="hm-cp-item" data-cp-item data-cat={f.category ?? ''} data-reveal style={`--i:${i % 4}`}>
            <article class:list={['hm-cp-card', { 'hm-cp-card--featured': f.featured }]}>
              <a class="hm-cp-media" href={f.href} tabindex="-1" aria-hidden="true">
                {f.image
                  ? <Img image={f.image} class="hm-cp-img" sizes="(min-width: 1100px) 24vw, (min-width: 640px) 45vw, 100vw" />
                  : <span class="hm-cp-tile"><span set:html={icon(f.icon)} /></span>}
              </a>
              <div class="hm-cp-body">
                {f.category && <p class="hm-cp-cat">{f.category}</p>}
                <h3 class="hm-cp-name"><a href={f.href}>{f.name}</a></h3>
                {f.summary && <p class="hm-cp-sum">{f.summary}</p>}
                <span class="hm-cp-go" aria-hidden="true">{labels.learn_more} <Fragment set:html={arrow} /></span>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  )}

  {has.clubs && (
    <div class="hm-cp-panel" data-cp-panel="clubs" role="tabpanel" hidden={has.fac}>
      {clubCats.length > 1 && (
        <div class="hm-cp-chips" role="group" aria-label="Club area">
          <button type="button" class="hm-cp-chip is-on" data-cp-cat="" aria-pressed="true">{labels.tab_all}</button>
          {clubCats.map((c) => <button type="button" class="hm-cp-chip" data-cp-cat={c} aria-pressed="false">{c}</button>)}
        </div>
      )}
      <ul class="hm-cp-clubs">
        {s.clubs.map((c, i) => (
          <li class="hm-cp-club" data-cp-item data-cat={c.category ?? ''} data-extra={i >= CLUB_SHOWN ? '1' : undefined} hidden={i >= CLUB_SHOWN}>
            <article class="hm-cp-clubcard">
              {c.category && <p class="hm-cp-cat">{c.category}</p>}
              <h3 class="hm-cp-name"><a href={c.href}>{c.name}</a></h3>
              {c.summary && <p class="hm-cp-sum">{c.summary}</p>}
            </article>
          </li>
        ))}
      </ul>
      {s.clubs.length > CLUB_SHOWN && <p class="hm-cp-more"><button type="button" class="hm-up-more" data-cp-more data-total={s.clubs.length}>{labels.show_more} ({s.clubs.length})</button></p>}
    </div>
  )}
</div>

<script is:inline>
  (() => {
    if (window.__hmCp) return;
    window.__hmCp = true;
    const init = () => {
      document.querySelectorAll('[data-cp]').forEach((root) => {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        // Figures count up once when scrolled into view.
        const figs = [...root.querySelectorAll('[data-cp-count]')];
        const run = (el) => { const end = Number(el.dataset.cpCount) || 0, t0 = performance.now(); const tick = (t) => { const p = Math.min(1, (t - t0) / 1100); el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3)))); if (p < 1) requestAnimationFrame(tick); }; el.textContent = '0'; requestAnimationFrame(tick); };
        if (!reduce && 'IntersectionObserver' in window) {
          const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { run(e.target); io.unobserve(e.target); } }), { threshold: 0.6 });
          figs.forEach((f) => io.observe(f));
        }
        // Tabs and category chips
        const tabs = [...root.querySelectorAll('[data-cp-tab]')];
        const panels = [...root.querySelectorAll('[data-cp-panel]')];
        tabs.forEach((b) => b.addEventListener('click', () => {
          tabs.forEach((t) => { const on = t === b; t.classList.toggle('is-on', on); t.setAttribute('aria-selected', String(on)); });
          panels.forEach((p) => { p.hidden = p.dataset.cpPanel !== b.dataset.cpTab; });
        }));
        panels.forEach((panel) => {
          const chips = [...panel.querySelectorAll('[data-cp-cat]')];
          const items = [...panel.querySelectorAll('[data-cp-item]')];
          const more = panel.querySelector('[data-cp-more]');
          let cat = '', all = false;
          const apply = () => {
            let shown = 0;
            items.forEach((li) => {
              const ok = !cat || li.dataset.cat === cat;
              const extra = li.dataset.extra === '1' && !all && !cat;
              li.hidden = !ok || extra;
              if (!li.hidden) { shown++; li.classList.add('is-in'); }
            });
            chips.forEach((c) => { const on = c.dataset.cpCat === cat; c.classList.toggle('is-on', on); c.setAttribute('aria-pressed', String(on)); });
            if (more) more.hidden = all || !!cat;
          };
          chips.forEach((c) => c.addEventListener('click', () => { cat = c.dataset.cpCat; apply(); }));
          more?.addEventListener('click', () => { all = true; apply(); });
          apply();
        });
      });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  })();
</script>
