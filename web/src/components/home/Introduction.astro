---
// College introduction — a photograph, a short text and links.
import Img from './Img.astro';
import type { Section } from '../../lib/content/homepage';
type S = Extract<Section, { kind: 'introduction' }>;
interface Props { s: S; headingId: string }
const { s, headingId } = Astro.props;
const arrow = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
<div class:list={['hm-intro', { 'hm-intro--noimg': !s.image }]} data-intro-slide>
  {s.image && (
    <figure class="hm-intro-media" data-slide-from="left">
      <span class="hm-intro-frame" aria-hidden="true"></span>
      <span class="hm-intro-parallax" data-parallax>
        <Img image={s.image} class="hm-intro-img" sizes="(min-width: 900px) 45vw, 100vw" />
      </span>
    </figure>
  )}
  <div class="hm-intro-text" data-slide-from="right">
    {s.eyebrow && <p class="hm-eyebrow">{s.eyebrow}</p>}
    {s.heading && <h2 class="hm-h2" id={headingId}>{s.heading}</h2>}
    {s.intro && <p class="hm-lede">{s.intro}</p>}
    {s.body_html && <div class="hm-prose hm-statement" set:html={s.body_html} />}
    {s.links.length > 0 && (
      <ul class="hm-pills">
        {s.links.map((l) => <li><a href={l.url}>{l.label} <Fragment set:html={arrow} /></a></li>)}
      </ul>
    )}
    {s.button && <a class="hm-btn" href={s.button.url}>{s.button.label}</a>}
  </div>
</div>

<script is:inline>
  (() => {
    if (window.__hmIntroSlide) return;
    window.__hmIntroSlide = true;
    const init = () => {
      const boxes = [...document.querySelectorAll('[data-intro-slide]')];
      if (!boxes.length || !('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // Slides in every time the section comes into view — scrolling down or back up — and slides out as it
      // leaves, so the next pass plays again. It arrives from the side it was last seen on (below or above).
      const io = new IntersectionObserver((entries) => entries.forEach((e) => {
        const box = e.target;
        if (e.isIntersecting) {
          box.classList.add('is-slid');
        } else {
          box.classList.remove('is-slid');
          box.style.setProperty('--hm-sy', e.boundingClientRect.top < 0 ? '-70px' : '70px');
        }
      }), { rootMargin: '-12% 0px -12% 0px', threshold: 0 });
      boxes.forEach((b) => { b.style.setProperty('--hm-sy', '70px'); b.classList.add('is-armed'); io.observe(b); });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  })();
</script>
