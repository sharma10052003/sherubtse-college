---
// Heading, intro and optional button shared by every homepage section.
interface Props { id: string; heading: string | null; intro: string | null; button: { label: string; url: string } | null; light?: boolean }
const { id, heading, intro, button, light = false } = Astro.props;
const arrow = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
{(heading || intro || button) && (
  <header class:list={['hm-head', { 'hm-head--light': light }]} data-reveal>
    <div class="hm-head-text">
      {heading && <h2 class="hm-h2" id={id}>{heading}</h2>}
      {intro && <p class="hm-lede">{intro}</p>}
    </div>
    {button && <a class="hm-more" href={button.url}>{button.label} <Fragment set:html={arrow} /></a>}
  </header>
)}
