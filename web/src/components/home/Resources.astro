---
// Resources — featured downloads and useful links.
import type { DocumentLink, LinkCard, HomeLabels } from '../../lib/content/homepage';
interface Props { documents: DocumentLink[]; links: LinkCard[]; labels: HomeLabels }
const { documents, links, labels } = Astro.props;
const file = '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M6 2h8l5 5v15H6z"/><path d="M14 2v5h5M9 13h7M9 17h5"/></svg>';
const down = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>';
const arrow = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
<div class:list={['hm-res', { 'hm-res--nolinks': links.length === 0, 'hm-res--nodocs': documents.length === 0 }]}>
  {documents.length > 0 && (
    <ul class="hm-docs" data-reveal>
      {documents.map((d) => (
        <li>
          <a href={d.url} target="_blank" rel="noopener">
            <span class="hm-doc-icon"><Fragment set:html={file} /></span>
            <span class="hm-doc-text">
              <span class="hm-doc-title">{d.title}</span>
              <span class="hm-doc-meta">{[d.category, d.ext, d.size].filter(Boolean).join(' · ')}</span>
            </span>
            <span class="hm-doc-go"><Fragment set:html={down} /><span class="hm-sr">{labels.download}</span></span>
          </a>
        </li>
      ))}
    </ul>
  )}
  {links.length > 0 && (
    <ul class="hm-pills hm-pills--stack" data-reveal>
      {links.map((l) => (
        <li>
          <a href={l.url} title={l.description ?? undefined}>{l.label} <Fragment set:html={arrow} /></a>
        </li>
      ))}
    </ul>
  )}
</div>
