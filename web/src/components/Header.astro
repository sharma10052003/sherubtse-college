---
import { Image } from 'astro:assets';
import logo from '../assets/sherubtse-logo.png';
import { getNavigation } from '../lib/content/navigation';

const { menu } = await getNavigation();
const currentPath = Astro.url.pathname;
---
<header class="masthead">
  <!-- Single row: crest on the left, nav links and search grouped together
       on the right, all on one line — per direct feedback that the two-row
       version left too much vertical gap between the nav and the search
       box sitting right above it. -->
  <div class="wrap">
    <a href="/" class="brand" aria-label="Sherubtse College — home">
      <Image src={logo} alt="Sherubtse College" width={150} height={150} />
    </a>

    <div class="masthead-right">
      <!-- No dropdowns — each item links straight to its section landing page
           (Stack, Structure & Wireframes section 07, Stanford finding). -->
      <ul class="primary-nav">
        {menu.map((item) => (
          <li><a href={item.url ?? '#'} aria-current={currentPath.startsWith(item.url ?? ' ') ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>

      <!-- Live, as-you-type results via Pagefind's JS module (built site
           only — see search.astro's note on why dev mode has no index).
           Still a plain GET form underneath, so it works with JS off or
           before the module loads: submitting goes to /search?q=... same
           as always. The dropdown is progressive enhancement on top. -->
      <form class="header-search" action="/search" role="search" autocomplete="off">
        <div class="header-search-field">
          <input
            type="search"
            name="q"
            id="headerSearchInput"
            placeholder="Search"
            aria-label="Search the site"
            aria-expanded="false"
            aria-controls="headerSearchResults"
            aria-autocomplete="list"
            required
          />
          <div class="header-search-results" id="headerSearchResults" role="listbox" hidden></div>
        </div>
        <button type="submit" aria-label="Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="M20 20l-4.8-4.8" />
          </svg>
        </button>
      </form>
    </div>

    <button type="button" class="menu-toggle" id="mobileMenuToggle" aria-expanded="false" aria-controls="mobileMenu">
      <span aria-hidden="true">&#9776;</span> Menu
    </button>
  </div>
</header>

<nav class="mobile-menu" id="mobileMenu" hidden>
  <ul>
    {menu.map((item) => <li><a href={item.url ?? '#'}>{item.label}</a></li>)}
  </ul>
</nav>

<script>
  // Toggling the mobile menu panel, plus the three things Phase 3.3 found
  // missing: focus trapped inside the panel while open, Escape closes it,
  // and focus returns to the toggle button afterward. Still no dropdowns,
  // no hover behaviour — matches the Style Guide's "no hover-dependent
  // anything" rule and the 0KB-by-default JS budget. Opening/closing now
  // animates (a slide via max-height, in layout.css) rather than the
  // panel just snapping in and out — kept in sync with this constant so
  // `hidden` is only applied once the closing transition has actually
  // finished, not instantly.
  const MOBILE_MENU_TRANSITION_MS = 300;

  const toggle = document.getElementById('mobileMenuToggle') as HTMLButtonElement | null;
  const menu = document.getElementById('mobileMenu') as HTMLElement | null;
  let closeTimer: ReturnType<typeof setTimeout> | undefined;

  function focusableIn(el: HTMLElement): HTMLElement[] {
    return Array.from(el.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));
  }

  function openMenu() {
    if (!menu || !toggle) return;
    clearTimeout(closeTimer);
    menu.hidden = false;
    // Force a reflow between removing [hidden] and adding the class that
    // drives the transition — otherwise the browser can coalesce both
    // changes into one paint and the slide never plays.
    void menu.offsetHeight;
    menu.classList.add('is-open');
    toggle.setAttribute('aria-expanded', 'true');
    focusableIn(menu)[0]?.focus();
  }

  function closeMenu({ returnFocus = true } = {}) {
    if (!menu || !toggle) return;
    menu.classList.remove('is-open');
    toggle.setAttribute('aria-expanded', 'false');
    clearTimeout(closeTimer);
    closeTimer = setTimeout(() => {
      if (menu) menu.hidden = true;
    }, MOBILE_MENU_TRANSITION_MS);
    if (returnFocus) toggle.focus();
  }

  toggle?.addEventListener('click', () => {
    if (toggle.getAttribute('aria-expanded') === 'true') closeMenu({ returnFocus: false });
    else openMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (!menu || menu.hidden) return;

    if (e.key === 'Escape') {
      closeMenu();
      return;
    }

    if (e.key === 'Tab') {
      const items = focusableIn(menu);
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>

<script>
  // Live search dropdown, powered by Pagefind's own JS module — the same
  // index /search already uses, just driven directly instead of through
  // the bulkier PagefindUI widget (that widget is the right call for a
  // full results page; this header slot needs a compact few-result list).
  // Pagefind only exists after a real `npm run build` (astro build +
  // pagefind), never in `astro dev` — the dynamic import below fails
  // there and the form just falls back to a plain GET submit to /search,
  // exactly as it always has. No dropdowns elsewhere on the site; this is
  // a search-results list, not a navigation menu, so it's a deliberate
  // exception to that rule, not a contradiction of it.
  const input = document.getElementById('headerSearchInput') as HTMLInputElement | null;
  const resultsBox = document.getElementById('headerSearchResults') as HTMLElement | null;
  const field = input?.closest('.header-search-field') as HTMLElement | null;

  function closeResults() {
    if (!resultsBox || !input) return;
    resultsBox.hidden = true;
    resultsBox.innerHTML = '';
    input.setAttribute('aria-expanded', 'false');
  }

  function escapeHtml(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  async function setup() {
    if (!input || !resultsBox || !field) return;

    let pagefind: any;
    try {
      // A plain `import()` here gets rewritten by Vite's build-time module
      // preload helper even with a @vite-ignore comment, because Pagefind's
      // output isn't part of Vite's own module graph — that rewrite throws
      // "__VITE_PRELOAD__ is not defined" at runtime. Hiding the import
      // inside `new Function` keeps it invisible to Vite's static analysis
      // entirely, which is the documented workaround for this exact
      // Pagefind + Vite/Astro interaction.
      const dynamicImport = new Function('specifier', 'return import(specifier)');
      pagefind = await dynamicImport('/pagefind/pagefind.js');
      await pagefind.init();
    } catch {
      return;
    }

    let latestTerm = '';

    input.addEventListener('input', async () => {
      const term = input.value.trim();
      latestTerm = term;

      if (term.length < 2) {
        closeResults();
        return;
      }

      const search = await pagefind.debouncedSearch(term);
      if (!search || term !== latestTerm) return;

      const top = search.results.slice(0, 6);
      if (top.length === 0) {
        resultsBox.innerHTML = '<p class="header-search-empty">No matches.</p>';
        resultsBox.hidden = false;
        input.setAttribute('aria-expanded', 'true');
        return;
      }

      const items = await Promise.all(top.map((r: any) => r.data()));
      resultsBox.innerHTML = items
        .map(
          (d: any) => `
        <a href="${d.url}" class="header-search-result" role="option">
          <span class="header-search-result-title">${escapeHtml(d.meta?.title ?? d.url)}</span>
          <span class="header-search-result-excerpt">${d.excerpt}</span>
        </a>`
        )
        .join('');
      resultsBox.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeResults();
    });

    document.addEventListener('click', (e) => {
      if (!field.contains(e.target as Node)) closeResults();
    });
  }

  setup();
</script>
