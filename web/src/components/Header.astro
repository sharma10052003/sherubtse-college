---
import { Image } from 'astro:assets';
import logo from '../assets/sherubtse-logo.png';
import { getNavigation } from '../lib/content/navigation';

const { menu, logo_url, logo_alt, search_placeholder, menu_button_label } = await getNavigation();
const currentPath = Astro.url.pathname;
---
<header class="masthead">
  <!-- Single row: crest on the left, nav links and search grouped together
       on the right, all on one line — per direct feedback that the two-row
       version left too much vertical gap between the nav and the search
       box sitting right above it. -->
  <div class="wrap">
    <a href="/" class="brand" aria-label={`${logo_alt} — home`}>
      {logo_url ? (
        <img src={logo_url} alt={logo_alt} width="150" height="150" decoding="async" />
      ) : (
        <Image src={logo} alt={logo_alt} width={150} height={150} />
      )}
    </a>

    <div class="masthead-right">
      <!-- No dropdowns — each item links straight to its section landing page
           (Stack, Structure & Wireframes section 07, Stanford finding). -->
      <ul class="primary-nav">
        {menu.map((item) => (
          <li><a href={item.url ?? '#'} aria-current={currentPath.startsWith(item.url ?? ' ') ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>

      <!-- Live, as-you-type results from the site search index
           (/search-index.json, built from Strapi content). Still a plain GET
           form underneath, so it works with JS off: submitting goes to /search?q=... -->
      <form class="header-search" action="/search" role="search" autocomplete="off">
        <div class="header-search-field">
          <input
            type="search"
            name="q"
            id="headerSearchInput"
            placeholder={search_placeholder}
            aria-label="Search the site"
            aria-expanded="false"
            aria-controls="headerSearchResults"
            aria-autocomplete="list"
            required
          />
          <div class="header-search-results" id="headerSearchResults" role="listbox" hidden></div>
        </div>
        <button type="submit" aria-label="Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="M20 20l-4.8-4.8" />
          </svg>
        </button>
      </form>
    </div>

    <button type="button" class="menu-toggle" id="mobileMenuToggle" aria-expanded="false" aria-controls="mobileMenu">
      <span aria-hidden="true">&#9776;</span> {menu_button_label}
    </button>
  </div>

  <!-- Nested inside <header>, not a page-level sibling, so it stays
       attached to the masthead now that the masthead is sticky (position:
       sticky in layout.css) — otherwise the panel would open wherever it
       sits in the normal document flow, not under the visually-pinned
       header. -->
  <nav class="mobile-menu" id="mobileMenu" hidden>
    <ul>
      {menu.map((item) => <li><a href={item.url ?? '#'}>{item.label}</a></li>)}
    </ul>
  </nav>
</header>

<script>
  // Toggling the mobile menu panel, plus the three things Phase 3.3 found
  // missing: focus trapped inside the panel while open, Escape closes it,
  // and focus returns to the toggle button afterward. Still no dropdowns,
  // no hover behaviour — matches the Style Guide's "no hover-dependent
  // anything" rule and the 0KB-by-default JS budget. Opening/closing now
  // animates (a slide via max-height, in layout.css) rather than the
  // panel just snapping in and out — kept in sync with this constant so
  // `hidden` is only applied once the closing transition has actually
  // finished, not instantly.
  const MOBILE_MENU_TRANSITION_MS = 300;

  const toggle = document.getElementById('mobileMenuToggle') as HTMLButtonElement | null;
  const menu = document.getElementById('mobileMenu') as HTMLElement | null;
  let closeTimer: ReturnType<typeof setTimeout> | undefined;

  function focusableIn(el: HTMLElement): HTMLElement[] {
    return Array.from(el.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));
  }

  function openMenu() {
    if (!menu || !toggle) return;
    clearTimeout(closeTimer);
    menu.hidden = false;
    // Force a reflow between removing [hidden] and adding the class that
    // drives the transition — otherwise the browser can coalesce both
    // changes into one paint and the slide never plays.
    void menu.offsetHeight;
    menu.classList.add('is-open');
    toggle.setAttribute('aria-expanded', 'true');
    focusableIn(menu)[0]?.focus();
  }

  function closeMenu({ returnFocus = true } = {}) {
    if (!menu || !toggle) return;
    menu.classList.remove('is-open');
    toggle.setAttribute('aria-expanded', 'false');
    clearTimeout(closeTimer);
    closeTimer = setTimeout(() => {
      if (menu) menu.hidden = true;
    }, MOBILE_MENU_TRANSITION_MS);
    if (returnFocus) toggle.focus();
  }

  toggle?.addEventListener('click', () => {
    if (toggle.getAttribute('aria-expanded') === 'true') closeMenu({ returnFocus: false });
    else openMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (!menu || menu.hidden) return;

    if (e.key === 'Escape') {
      closeMenu();
      return;
    }

    if (e.key === 'Tab') {
      const items = focusableIn(menu);
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>

<script>
  // Live search dropdown, driven by the site search index
  // (/search-index.json, built from the same Strapi content as the pages —
  // works in `astro dev` and in the built site). Up to 6 results, a type
  // label on each, arrow-key navigation, and a link to all results on
  // /search. A search-results list, not a navigation menu, so it is a
  // deliberate exception to the site's no-dropdowns rule.
  import { loadIndex, search, highlight } from '../lib/search-client';

  const input = document.getElementById('headerSearchInput') as HTMLInputElement | null;
  const resultsBox = document.getElementById('headerSearchResults') as HTMLElement | null;
  const field = input?.closest('.header-search-field') as HTMLElement | null;

  function closeResults() {
    if (!resultsBox || !input) return;
    resultsBox.hidden = true;
    resultsBox.innerHTML = '';
    input.setAttribute('aria-expanded', 'false');
    input.removeAttribute('aria-activedescendant');
  }

  if (input && resultsBox && field) {
    // Start loading as soon as the visitor shows interest.
    input.addEventListener('focus', () => void loadIndex(), { once: true });

    let latest = '';
    input.addEventListener('input', async () => {
      const term = input.value.trim();
      latest = term;
      if (term.length < 2) return closeResults();
      const index = await loadIndex();
      if (term !== latest) return;
      const results = search(index, term);
      const all = `/search?q=${encodeURIComponent(term)}`;
      resultsBox.innerHTML = results.length
        ? results
            .slice(0, 6)
            .map(
              (r, i) => `<a href="${r.u}" class="header-search-result" role="option" id="hsr-${i}"${/^https?:/.test(r.u) ? ' target="_blank" rel="noopener"' : ''}>
                <span class="header-search-result-kind">${r.k}</span>
                <span class="header-search-result-title">${highlight(r.t, term)}</span>
                ${r.d ? `<span class="header-search-result-excerpt">${highlight(r.d, term)}</span>` : ''}
              </a>`,
            )
            .join('') + `<a href="${all}" class="header-search-all" role="option" id="hsr-all">See all ${results.length} result${results.length === 1 ? '' : 's'} →</a>`
        : `<p class="header-search-empty">No matches for “${term.replace(/[<>&"]/g, '')}”. <a href="${all}">Search all pages</a></p>`;
      resultsBox.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    });

    // Arrow keys move through the results; Enter opens the highlighted one.
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') return closeResults();
      const options = Array.from(resultsBox.querySelectorAll<HTMLAnchorElement>('[role="option"]'));
      if (!options.length || resultsBox.hidden) return;
      const current = options.findIndex((o) => o.classList.contains('is-active'));
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        const next = e.key === 'ArrowDown' ? (current + 1) % options.length : (current - 1 + options.length) % options.length;
        options.forEach((o, i) => o.classList.toggle('is-active', i === next));
        input.setAttribute('aria-activedescendant', options[next].id);
        options[next].scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter' && current >= 0) {
        e.preventDefault();
        options[current].click();
      }
    });

    document.addEventListener('click', (e) => {
      if (!field.contains(e.target as Node)) closeResults();
    });
  }
</script>
