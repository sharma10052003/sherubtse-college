---
import type { PositionOpening } from '../../lib/content/vacancy-announcements';

interface Props {
  positions: PositionOpening[];
}
const { positions } = Astro.props;
---
<section class="an-table-section">
  <h2 class="an-table-heading">Position{positions.length > 1 ? 's' : ''} Advertised</h2>
  <div class="an-table-card">
    <div class="tbl-wrap">
      <table class="tbl an-data-tbl">
        <thead>
          <tr>
            <th scope="col">Particular</th>
            <th scope="col">Position Title</th>
            <th scope="col">Level</th>
            <th scope="col">Slots</th>
            <th scope="col">Employment</th>
            <th scope="col">Eligibility Criteria</th>
          </tr>
        </thead>
        <tbody>
          {positions.map((p) => (
            <tr>
              <td>{p.particular ?? '—'}</td>
              <td class="an-cell-strong">{p.position_title}</td>
              <td class="mono-num">{p.position_level ?? '—'}</td>
              <td class="mono-num">{p.slots ?? '—'}</td>
              <td>{p.mode_of_employment ?? '—'}</td>
              <td class="an-cell-wide">{p.eligibility_criteria ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
