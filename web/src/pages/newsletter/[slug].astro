---
// One newsletter issue: a large cover, what is in it, and a page-turning reader that opens on
// the PDF (or straight to a shared page, #read=<slug>&p=<page>). Everything comes from Strapi →
// Newsletter – Editions; wording from Newsletter – Page. Styles: newsletter-hub.css (.nlx).
import Layout from '../../layouts/Layout.astro';
import NewsletterReader from '../../components/newsletter/NewsletterReader.astro';
import '../../styles/newsletter-hub.css';
import { icon } from '../../lib/facility-icons';
import { strapiGet } from '../../lib/strapi';
import type { StrapiListResponse } from '../../lib/strapi';
import { getNewsletterBySlug, getRelatedNewsletters, getNeighbours, getNewslettersPage } from '../../lib/content/newsletter';
import { makeNewslettersLabels } from '../../lib/content/newsletters-labels';

export async function getStaticPaths() {
  const res = await strapiGet<StrapiListResponse<{ slug: string }>>('newsletters', { fields: ['slug'], pagination: { pageSize: 300 } });
  return (res?.data ?? []).map((n) => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const n = await getNewsletterBySlug(slug as string);
if (!n) return Astro.redirect('/newsletter', 404);

const [related, { newer, older }, page] = await Promise.all([getRelatedNewsletters(n, 4), getNeighbours(n), getNewslettersPage()]);
const t = makeNewslettersLabels(page.labels);
const initials = (s: string) => s.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
const pageTitle = `${n.title} — ${n.issue_label}`;
const description = n.description ?? `Read ${n.title}, ${n.issue_label}, published by Sherubtse College.`;
const readAttrs = { 'data-nlr-open': '', 'data-pdf': n.pdf_url ?? '', 'data-slug': n.slug, 'data-title': n.title, 'data-sub': n.issue_label, 'data-doc': n.documentId };
const sameSeries = related.filter((r) => r.title === n.title);
const others = related.filter((r) => r.title !== n.title);
---
<Layout title={pageTitle} description={description} ogImage={n.cover_image_url ?? undefined}>
  <div class="nlx" data-nlx>
    <header class="nlx-hero nlx-issue-hero">
      <span class="nlx-glow nlx-glow--a" aria-hidden="true"></span>
      <span class="nlx-glow nlx-glow--b" aria-hidden="true"></span>
      <div class="wrap">
        <nav class="nlx-crumbs nlx-rise" style="--d:0" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">›</span><a href="/news-notices">News &amp; Notices</a><span aria-hidden="true">›</span><a href="/newsletter">Newsletters</a><span aria-hidden="true">›</span><span aria-current="page">{n.issue_label}</span>
        </nav>
        <div class="nlx-issue-grid">
          <div class="nlx-issue-book nlx-rise" style="--d:2" data-nlx-stack>
            <span class="nlx-hero-cover">
              {n.cover_image_url
                ? <img src={n.cover_image_url} alt={`Cover of ${pageTitle}`} />
                : <span class="nlx-plain"><b>{initials(n.title)}</b><i>{n.issue_label}</i></span>}
              <span class="nlx-shine" aria-hidden="true"></span>
            </span>
          </div>
          <div>
            <p class="nlx-issue-series nlx-rise" style="--d:1">{n.title}</p>
            <h1 class="nlx-issue-title nlx-rise" style="--d:2">{n.issue_label}</h1>
            <ul class="nlx-issue-meta nlx-rise" style="--d:3">
              <li>{n.year}</li>
              {n.unit_name && <li>{t('detail_published_by')} {n.unit_name}</li>}
            </ul>
            {n.description && <p class="nlx-issue-text nlx-rise" style="--d:3">{n.description}</p>}
            <div class="nlx-actions nlx-rise" style="--d:4">
              {n.pdf_url ? (
                <>
                  <button type="button" class="nlx-btn nlx-btn--gold" {...readAttrs}><Fragment set:html={icon('journal')} />{t('detail_read')}</button>
                  <a class="nlx-btn nlx-btn--ghost" href={n.pdf_url} download data-nlx-dl><Fragment set:html={icon('download')} />{t('download_label')}</a>
                </>
              ) : n.external_url ? (
                <a class="nlx-btn nlx-btn--gold" href={n.external_url} target="_blank" rel="noopener"><Fragment set:html={icon('external')} />{t('external_label')}</a>
              ) : null}
            </div>
            <div class="nlx-share nlx-rise" style="--d:5">
              <span>{t('detail_share')}</span>
              <button type="button" data-nlx-copy data-copied={t('detail_copied')}><Fragment set:html={icon('link')} /><span>{t('detail_copy')}</span></button>
              <a href="#" data-nlx-share="whatsapp" target="_blank" rel="noopener">WhatsApp</a>
              <a href="#" data-nlx-share="facebook" target="_blank" rel="noopener">Facebook</a>
              <a href="#" data-nlx-share="mail">Email</a>
            </div>
          </div>
        </div>
      </div>
    </header>

    {(n.topics.length > 0 || n.closing_message) && (
      <section class="nlx-section">
        <div class="wrap">
          <header class="nlx-head" data-nlx-reveal><h2>{t('detail_topics')}</h2></header>
          {n.topics.length > 0 && <ul class="nlx-topics" data-nlx-reveal>{n.topics.map((x) => <li>{x}</li>)}</ul>}
          {n.closing_message && <p class="nlx-closing" data-nlx-reveal>{n.closing_message}</p>}
        </div>
      </section>
    )}

    {(newer || older) && (
      <section class="nlx-section">
        <div class="wrap">
          <nav class="nlx-pager" aria-label={n.title} data-nlx-reveal>
            {newer ? <a href={`/newsletter/${newer.slug}`} rel="next"><small>{t('detail_newer')}</small><strong>{newer.issue_label}</strong></a> : <span></span>}
            {older && <a href={`/newsletter/${older.slug}`} rel="prev"><small>{t('detail_older')}</small><strong>{older.issue_label}</strong></a>}
          </nav>
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="nlx-section nlx-section--tint">
        <div class="wrap">
          <header class="nlx-head" data-nlx-reveal><h2>{sameSeries.length > 0 ? t('detail_more') : t('detail_other')}</h2></header>
          <ul class="nlx-grid">
            {[...sameSeries, ...others].map((r, i) => (
              <li class="nlx-item" data-nlx-reveal style={`--d:${i}`}>
                <article class="nlx-card">
                  <a class="nlx-cover" href={`/newsletter/${r.slug}`} tabindex="-1" aria-hidden="true">
                    {r.cover_image_url ? <img src={r.cover_image_url} alt="" loading="lazy" /> : <span class="nlx-plain"><b>{initials(r.title)}</b><i>{r.issue_label}</i></span>}
                    <span class="nlx-shine" aria-hidden="true"></span>
                  </a>
                  <div class="nlx-card-body">
                    <p class="nlx-series">{r.title}</p>
                    <h3><a href={`/newsletter/${r.slug}`}>{r.issue_label}</a></h3>
                  </div>
                </article>
              </li>
            ))}
          </ul>
          <p class="nlx-tip"><a href="/newsletter">{t('browse')} →</a></p>
        </div>
      </section>
    )}
  </div>

  <NewsletterReader />
</Layout>

<script define:vars={{ strapiUrl: import.meta.env.PUBLIC_STRAPI_URL || 'http://localhost:1337', docId: n.documentId, title: pageTitle }}>
  (() => {
    const root = document.querySelector('[data-nlx]');
    if (!root) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const url = location.origin + location.pathname;

    if (!reduce && 'IntersectionObserver' in window) {
      root.classList.add('nlx-anim');
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -6% 0px', threshold: 0.05 });
      root.querySelectorAll('[data-nlx-reveal]').forEach((n) => io.observe(n));
    }
    const book = root.querySelector('[data-nlx-stack]');
    if (book && !reduce && matchMedia('(hover: hover)').matches) {
      book.addEventListener('pointermove', (e) => {
        const r = book.getBoundingClientRect();
        book.style.setProperty('--rx', (((e.clientY - r.top) / r.height - 0.5) * -12).toFixed(2) + 'deg');
        book.style.setProperty('--ry', (((e.clientX - r.left) / r.width - 0.5) * 16).toFixed(2) + 'deg');
      });
      book.addEventListener('pointerleave', () => { book.style.setProperty('--rx', '0deg'); book.style.setProperty('--ry', '0deg'); });
      book.addEventListener('click', () => root.querySelector('[data-nlr-open]')?.click());
    }

    // Share links
    const targets = {
      whatsapp: 'https://wa.me/?text=' + encodeURIComponent(title + ' — ' + url),
      facebook: 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url),
      mail: 'mailto:?subject=' + encodeURIComponent(title) + '&body=' + encodeURIComponent(url),
    };
    root.querySelectorAll('[data-nlx-share]').forEach((a) => { a.href = targets[a.dataset.nlxShare]; });
    const copy = root.querySelector('[data-nlx-copy]');
    copy.addEventListener('click', async () => {
      const label = copy.querySelector('span');
      try { await navigator.clipboard.writeText(url); const was = label.textContent; label.textContent = copy.dataset.copied; setTimeout(() => { label.textContent = was; }, 1800); }
      catch (e) { window.prompt('Copy this link:', url); }
    });
    // Count a download
    root.querySelector('[data-nlx-dl]')?.addEventListener('click', () => { fetch(`${strapiUrl}/api/newsletters/${docId}/track-download`, { method: 'POST' }).catch(() => {}); });
  })();
</script>
