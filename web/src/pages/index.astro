---
// Homepage. Everything comes from Strapi → Home – Page: the hero, then the
// “Sections” list in its order (add, reorder or hide sections there). Two
// consecutive half-width sections share one band, side by side.
// Content rules and data: lib/content/homepage.ts. Styles: home.css (.hm).
import Layout from '../layouts/Layout.astro';
import '../styles/home.css';
import Hero from '../components/home/Hero.astro';
import HomeSection from '../components/home/HomeSection.astro';
import HomeRuntime from '../components/home/HomeRuntime.astro';
import { getHomepage, type Section } from '../lib/content/homepage';

const home = await getHomepage();

type Row = { single: Section } | { pair: [Section, Section] };
const rows: Row[] = [];
for (let i = 0; i < home.sections.length; i++) {
  const s = home.sections[i];
  const next = home.sections[i + 1];
  if (s.width === 'half' && next?.width === 'half') {
    rows.push({ pair: [s, next] });
    i++;
  } else rows.push({ single: s });
}
---
<Layout title={home.seo_title} description={home.seo_description ?? undefined}>
  <div class="hm" data-home>
    <Hero hero={home.hero} labels={home.labels} />
    {rows.map((row) =>
      'single' in row ? (
        <HomeSection s={row.single} labels={home.labels} />
      ) : (
        <div class:list={['hm-band', `hm-band--${row.pair[0].background}`, 'hm-band--pair']}>
          <div class="wrap hm-pair">
            <HomeSection s={row.pair[0]} labels={home.labels} paired />
            <HomeSection s={row.pair[1]} labels={home.labels} paired />
          </div>
        </div>
      ),
    )}
  </div>
</Layout>

<HomeRuntime labels={home.labels} />
