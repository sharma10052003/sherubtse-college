---
import ListingTemplate from '../../../components/templates/ListingTemplate.astro';
import { getOpenRecruitment } from '../../../lib/content/recruitment';

const posts = await getOpenRecruitment();
const rows = posts.map((p) => ({
  id: p.id,
  href: `/news-notices/recruitment/${p.id}`,
  date: p.closing_date ? new Date(p.closing_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : undefined,
  title: p.title,
  tags: [p.stage_label],
  meta: p.owning_unit_name ?? undefined,
}));
---
<ListingTemplate
  title="Recruitment"
  breadcrumb={[{ label: 'Home', url: '/' }, { label: 'News & Notices', url: '/news-notices' }, { label: 'Recruitment', url: '/news-notices/recruitment' }]}
  rows={rows}
/>
