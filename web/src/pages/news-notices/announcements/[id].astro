---
import ArticleTemplate from '../../../components/templates/ArticleTemplate.astro';
import { getAllNoticeIds, getNoticeById } from '../../../lib/content/notices';

export async function getStaticPaths() {
  const ids = await getAllNoticeIds();
  return ids.map((id) => ({ params: { id: String(id) } }));
}

const { id } = Astro.params;
const notice = await getNoticeById(Number(id));
if (!notice) return Astro.redirect('/news-notices/announcements', 404);
---
<ArticleTemplate
  eyebrow={`${notice.category}${notice.owning_unit_name ? ' · ' + notice.owning_unit_name : ''}`}
  title={notice.title}
  meta={`${new Date(notice.publish_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })} · closes ${new Date(notice.expires_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}`}
  body={notice.body}
  urgent={notice.urgency === 'urgent'}
  attachments={notice.attachments}
  breadcrumb={[
    { label: 'Home', url: '/' },
    { label: 'News & Notices', url: '/news-notices' },
    { label: 'Announcements', url: '/news-notices/announcements' },
    { label: notice.title, url: `/news-notices/announcements/${notice.id}` },
  ]}
/>
