---
// Detail page for one item in the Announcements feed. Three shapes share it:
//  - a Notice (numeric id) — also what Tenders and the Archive link to;
//  - a short announcement from "News & Notices – Announcements" (a-<id>);
//  - a vacancy slug from before vacancies moved to the Recruitment page —
//    these just forward to /news-notices/recruitment/<slug> so old links
//    keep working. The Announcements feed itself links vacancies straight
//    to Recruitment.
import ArticleTemplate from '../../../components/templates/ArticleTemplate.astro';
import { getAllNoticeIds, getNoticeById } from '../../../lib/content/notices';
import { getVacancyAnnouncementSlugs } from '../../../lib/content/vacancy-announcements';
import { getAnnouncementEntries, getAnnouncementEntryById, ENTRY_PREFIX } from '../../../lib/content/announcement-feed';

export async function getStaticPaths() {
  const [noticeIds, entries, vacancySlugs] = await Promise.all([
    getAllNoticeIds(),
    getAnnouncementEntries(),
    getVacancyAnnouncementSlugs(),
  ]);
  return [
    ...noticeIds.map((id) => ({ params: { slug: String(id) } })),
    ...entries.map((e) => ({ params: { slug: `${ENTRY_PREFIX}${e.id}` } })),
    ...vacancySlugs.map((slug) => ({ params: { slug } })),
  ];
}

const { slug } = Astro.params as { slug: string };

const entry = slug.startsWith(ENTRY_PREFIX) && /^\d+$/.test(slug.slice(ENTRY_PREFIX.length))
  ? await getAnnouncementEntryById(Number(slug.slice(ENTRY_PREFIX.length)))
  : null;
const notice = !entry && /^\d+$/.test(slug) ? await getNoticeById(Number(slug)) : null;

if (!entry && !notice) {
  const vacancySlugs = await getVacancyAnnouncementSlugs();
  if (vacancySlugs.includes(slug)) return Astro.redirect(`/news-notices/recruitment/${slug}`, 301);
  return Astro.redirect('/news-notices/announcements', 404);
}

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}

// Announcement text is plain text typed in the admin; ArticleTemplate renders
// its body as HTML, so escape it first and add the optional link after it.
function escapeHtml(text: string) {
  return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
const safeLink = entry?.link_url && /^(https?:|mailto:|tel:|\/)/i.test(entry.link_url) ? entry.link_url : null;
const entryBody = entry
  ? escapeHtml(entry.content) +
    (safeLink
      ? `\n\n<a class="btn btn-primary" href="${escapeHtml(safeLink)}"${/^https?:/i.test(safeLink) ? ' target="_blank" rel="noopener"' : ''}>${escapeHtml(entry.link_text || 'More information')}</a>`
      : '')
  : '';

const breadcrumbBase = [
  { label: 'Home', url: '/' },
  { label: 'News & Notices', url: '/news-notices' },
  { label: 'Announcements', url: '/news-notices/announcements' },
];
---
{entry && (
  <ArticleTemplate
    eyebrow={entry.label}
    title={entry.title}
    meta={`${formatDate(entry.date)}${entry.end_date ? ` · until ${formatDate(entry.end_date)}` : ''}`}
    body={entryBody}
    urgent={entry.type === 'danger'}
    breadcrumb={[...breadcrumbBase, { label: entry.title, url: `/news-notices/announcements/${ENTRY_PREFIX}${entry.id}` }]}
  />
)}
{notice && (
  <ArticleTemplate
    eyebrow={`${notice.category}${notice.owning_unit_name ? ' · ' + notice.owning_unit_name : ''}`}
    title={notice.title}
    meta={`${formatDate(notice.publish_at)} · closes ${formatDate(notice.expires_at)}`}
    body={notice.body}
    urgent={notice.urgency === 'urgent'}
    attachments={notice.attachments}
    breadcrumb={[...breadcrumbBase, { label: notice.title, url: `/news-notices/announcements/${notice.id}` }]}
  />
)}
