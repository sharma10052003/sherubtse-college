---
// Announcements — everything the College announces, newest first, in one
// feed (see lib/content/announcement-feed.ts): recruitment postings (the
// same records the Recruitment page lists — entered once, shown in both
// places), short announcements including warnings and urgent notices, and
// general notices. Tenders keep their own page. Search and filtering are
// client-side (AnnouncementFeedBoard) since the list is small.
import Layout from '../../../layouts/Layout.astro';
import AnnouncementFeedBoard from '../../../components/announcements/AnnouncementFeedBoard.tsx';
import '../../../styles/section-landing.css';
import '../../../styles/listing.css';
import '../../../styles/announcements.css';
import { getAnnouncementFeed, GROUP_LABELS } from '../../../lib/content/announcement-feed';

const items = await getAnnouncementFeed();
---
<Layout title="Announcements" description="Vacancies, important notices and general announcements from Sherubtse College, newest first.">
  <header class="sl-head">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> › <a href="/news-notices">News & Notices</a> › <span class="current">Announcements</span>
      </nav>
      <p class="sl-eyebrow">News & Notices</p>
      <h1 class="sl-title">Announcements</h1>
      <span class="sl-rule" aria-hidden="true"></span>
      <p class="sl-intro">
        Vacancies, important notices and general announcements — newest first. For the full recruitment process of each
        vacancy, see <a href="/news-notices/recruitment">Recruitment</a>; older notices are in the <a href="/news-notices/archive">Archive</a>.
      </p>
    </div>
  </header>

  <div class="ls-body">
    <div class="wrap an-wrap">
      <AnnouncementFeedBoard client:load items={items} groupLabels={GROUP_LABELS} />
    </div>
  </div>
</Layout>
