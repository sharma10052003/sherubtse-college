---
import ListingTemplate from '../../../components/templates/ListingTemplate.astro';
import { getAllNews } from '../../../lib/content/news';

const news = await getAllNews();
const rows = news.map((n) => ({
  id: n.id,
  href: `/news-notices/news/${n.id}`,
  date: new Date(n.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }),
  title: n.title,
  tags: n.tags,
  meta: n.unit_name ?? undefined,
}));
---
<ListingTemplate
  title="News"
  breadcrumb={[{ label: 'Home', url: '/' }, { label: 'News & Notices', url: '/news-notices' }, { label: 'News', url: '/news-notices/news' }]}
  rows={rows}
/>
