---
// One news story, laid out edge to edge so it uses the whole screen at every
// width (styles: news-article.css, scoped under .na):
//  - a full-bleed hero — the story's photo or video when it has one,
//    otherwise a navy mountain scene — with the headline, category, date,
//    department and reading time;
//  - a three-column reading area on wide screens: a sticky rail (date,
//    reading time, share, text size, full-screen reading), the story, and a
//    sidebar (details, tags, up next, more headlines). It folds to two
//    columns on tablets and one on phones;
//  - a "More from the newsroom" band and older/newer story navigation.
// Archived stories keep their original URL, content and media — restoring
// one is just clearing the `archived` flag in the CMS, nothing here changes.
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/news-article.css';
import { getAllNews, getAllNewsIds, getNewsById } from '../../../lib/content/news';
import { renderArticle, excerpt } from '../../../lib/article-text';

export async function getStaticPaths() {
  const ids = await getAllNewsIds();
  return ids.map((id) => ({ params: { id: String(id) } }));
}

const { id } = Astro.params;
const item = await getNewsById(Number(id));
if (!item) return Astro.redirect('/news-notices/news', 404);

const allNews = await getAllNews();
const live = allNews.filter((n) => !n.archived || n.id === item.id);
const index = live.findIndex((n) => n.id === item.id);
const newer = index > 0 ? live[index - 1] : null;
const older = index >= 0 && index < live.length - 1 ? live[index + 1] : null;
const others = allNews.filter((n) => n.id !== item.id && !n.archived);
const related = [...others.filter((n) => n.category === item.category), ...others.filter((n) => n.category !== item.category)].slice(0, 4);
const article = renderArticle(item.body);
// The sidebar grows with the story (2–5 headlines) so a short article isn't
// left with a long empty column beside the sidebar, or the other way round.
const headlineCount = Math.min(5, Math.max(2, Math.round(article.words / 120)));
const headlines = others.filter((n) => !related.includes(n)).slice(0, headlineCount);
// No summary? The first paragraph becomes the lede rather than repeating it.
const lede = item.summary || article.firstParagraph;
const bodyHtml = item.summary ? article.html : article.htmlWithoutFirst;
const minutes = Math.max(1, Math.round(article.words / 200));

const date = new Date(item.date);
const formatDate = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const shortDate = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
const day = date.toLocaleDateString('en-GB', { day: '2-digit' });
const monthYear = date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
const weekday = date.toLocaleDateString('en-GB', { weekday: 'long' });

const isVideo = item.template === 'video' && !!item.video_url;
const heroImage = item.image_url;
const galleryShots = [...new Set([...(item.gallery.length > 0 ? item.gallery : item.images.slice(1))])].filter((src) => src !== heroImage || isVideo);
const cardExcerpt = (n: typeof item) => excerpt(n.summary || n.body, 130);
// Alt text and captions come from the media library; a plain description stands in when none was entered.
const shotAlt = (src: string, i: number) => item.captions[src] || `${item.title} — photo ${i + 1} of ${galleryShots.length}`;
const PHOTO_PREVIEW = 12;

const pageUrl = new URL(`/news-notices/news/${item.id}`, Astro.site ?? 'https://www.sherubtse.edu.bt').href;
const mailHref = `mailto:?subject=${encodeURIComponent(item.title)}&body=${encodeURIComponent(`${item.title}\n${pageUrl}`)}`;

const ICON = {
  share: '<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/>',
  link: '<path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/>',
  mail: '<rect x="3" y="5" width="18" height="14"/><path d="M3 6l9 7 9-7"/>',
  print: '<path d="M6 9V3h12v6"/><rect x="3" y="9" width="18" height="8"/><path d="M6 14h12v7H6z"/>',
  expand: '<path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  arrowL: '<path d="M19 12H5M11 6l-6 6 6 6"/>',
  arrowR: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  camera: '<path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>',
  play: '<path d="M8 5v14l11-7z"/>',
  pause: '<path d="M7 5h3v14H7zM14 5h3v14h-3z"/>',
  stop: '<rect x="6" y="6" width="12" height="12"/>',
  listen: '<path d="M4 10v4h3l5 4V6L7 10H4z"/><path d="M16 9a4 4 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11"/>',
  zoom: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3M11 8v6M8 11h6"/>',
  download: '<path d="M12 4v12M7 11l5 5 5-5M5 20h14"/>',
};
const svg = (path: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${path}</svg>`;
---
<Layout title={item.title} description={item.summary || excerpt(item.body, 160)}>
  <div class="na-progress" aria-hidden="true"><span data-na-progress></span></div>

  <article class="na" data-na>
    <!-- ====================== HERO ====================== -->
    <header class:list={['na-hero', { 'na-hero--media': heroImage || isVideo }]}>
      <div class="na-hero-bg" aria-hidden="true">
        {isVideo ? (
          <video
            class="na-hero-media"
            src={item.video_url!}
            poster={item.video_poster_url ?? heroImage ?? undefined}
            muted
            autoplay={item.autoplay}
            loop={item.autoplay}
            playsinline
            data-na-parallax
          ></video>
        ) : heroImage ? (
          <img class="na-hero-media" src={heroImage} alt="" data-na-parallax />
        ) : (
          <>
            <svg class="na-hero-range na-hero-range--back" viewBox="0 0 1600 320" preserveAspectRatio="xMidYMax slice" data-na-parallax="0.05">
              <path d="M0 320V190l120-50 110 30 160-120 130 80 140-60 170 110 150-90 160 100 130-60 130 70 100-30v240z" />
            </svg>
            <svg class="na-hero-range na-hero-range--front" viewBox="0 0 1600 320" preserveAspectRatio="xMidYMax slice" data-na-parallax="0.1">
              <path d="M0 320V240l150-50 130 30 170-80 150 60 120-30 200 70 150-50 170 60 140-30 120 40 100-20v100z" />
            </svg>
          </>
        )}
        <div class="na-hero-scrim"></div>
        <div class="na-kira"></div>
      </div>

      <div class="wrap na-wide na-hero-inner">
        <nav class="na-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a> › <a href="/news-notices">News &amp; Notices</a> › <a href="/news-notices/news">News</a> ›
          <span aria-current="page">{item.title}</span>
        </nav>

        <div class="na-hero-grid">
          <div class="na-hero-text">
            <p class="na-kickers">
              <a class="na-chip na-chip--gold" href={`/news-notices/news?category=${item.category}`}>{item.category_label}</a>
              {item.archived && <span class="na-chip">Archived</span>}
              {item.tags.slice(0, 2).filter((t) => t !== item.category_label).map((t) => <span class="na-chip">{t}</span>)}
            </p>
            <h1 class="na-title">{item.title}</h1>
            <p class="na-meta">
              <time datetime={item.date}>{formatDate(item.date)}</time>
              {item.unit_name && <><span aria-hidden="true">·</span><span>{item.unit_name}</span></>}
              <span aria-hidden="true">·</span>
              <span class="na-meta-read"><Fragment set:html={svg(ICON.clock)} />{minutes} min read</span>
              {galleryShots.length > 0 && (
                <>
                  <span aria-hidden="true">·</span>
                  <a class="na-meta-read na-meta-photos" href="#photos"><Fragment set:html={svg(ICON.camera)} />{galleryShots.length} {galleryShots.length === 1 ? 'photo' : 'photos'}</a>
                </>
              )}
            </p>
          </div>

          <div class="na-datecard" aria-hidden="true">
            <span class="na-datecard-day">{day}</span>
            <span class="na-datecard-month">{monthYear}</span>
            <span class="na-datecard-week">{weekday}</span>
          </div>
        </div>
      </div>
    </header>

    {item.archived && (
      <div class="wrap na-wide">
        <p class="na-archived">This is an archived story from the newsroom's records.</p>
      </div>
    )}

    <!-- ====================== READING AREA ====================== -->
    <div class="wrap na-wide na-layout">
      <aside class="na-rail" aria-label="Reading tools">
        <div class="na-rail-inner">
          <div class="na-rail-block na-rail-block--info na-rail-date">
            <span class="na-rail-label">Published</span>
            <time datetime={item.date}>{shortDate(item.date)}</time>
          </div>
          <div class="na-rail-block na-rail-block--info">
            <span class="na-rail-label">Reading time</span>
            <span>{minutes} min · {article.words} words</span>
          </div>
          <div class="na-rail-block">
            <span class="na-rail-label">Share</span>
            <div class="na-tools">
              <button type="button" class="na-tool" data-na-share hidden aria-label="Share this story">
                <Fragment set:html={svg(ICON.share)} /><span>Share</span>
              </button>
              <button type="button" class="na-tool" data-na-copy data-url={pageUrl} aria-label="Copy link to this story">
                <Fragment set:html={svg(ICON.link)} /><span data-na-copy-label>Copy link</span>
              </button>
              <a class="na-tool" href={mailHref} aria-label="Email this story">
                <Fragment set:html={svg(ICON.mail)} /><span>Email</span>
              </a>
              <button type="button" class="na-tool" data-na-print aria-label="Print this story">
                <Fragment set:html={svg(ICON.print)} /><span>Print</span>
              </button>
            </div>
          </div>
          <div class="na-rail-block">
            <span class="na-rail-label" id="na-size-label">Text size</span>
            <div class="na-size" role="group" aria-labelledby="na-size-label">
              <button type="button" class="na-size-btn" data-na-size="-1" aria-label="Smaller text">A−</button>
              <button type="button" class="na-size-btn" data-na-size="0" aria-label="Reset text size">A</button>
              <button type="button" class="na-size-btn" data-na-size="1" aria-label="Larger text">A+</button>
            </div>
          </div>
          <div class="na-rail-block">
            <span class="na-rail-label" id="na-theme-label">Page colour</span>
            <div class="na-seg" role="group" aria-labelledby="na-theme-label">
              <button type="button" data-na-theme="light" aria-pressed="true">Light</button>
              <button type="button" data-na-theme="sepia" aria-pressed="false">Sepia</button>
              <button type="button" data-na-theme="dark" aria-pressed="false">Dark</button>
            </div>
          </div>
          <div class="na-rail-block">
            <span class="na-rail-label" id="na-font-label">Typeface</span>
            <div class="na-seg" role="group" aria-labelledby="na-font-label">
              <button type="button" data-na-font="serif" aria-pressed="true">Serif</button>
              <button type="button" data-na-font="sans" aria-pressed="false">Sans</button>
              <button type="button" data-na-font="easy" aria-pressed="false" title="Wide letter spacing, designed for easier reading">Easy-read</button>
            </div>
          </div>
          <div class="na-rail-block">
            <span class="na-rail-label" id="na-lead-label">Line spacing</span>
            <div class="na-seg" role="group" aria-labelledby="na-lead-label">
              <button type="button" data-na-lead="snug" aria-pressed="false">Snug</button>
              <button type="button" data-na-lead="normal" aria-pressed="true">Normal</button>
              <button type="button" data-na-lead="roomy" aria-pressed="false">Roomy</button>
            </div>
          </div>
          <div class="na-rail-block" data-na-listen-block hidden>
            <span class="na-rail-label" id="na-listen-label">Listen to this story</span>
            <div class="na-listen" role="group" aria-labelledby="na-listen-label">
              <button type="button" class="na-listen-btn" data-na-listen aria-pressed="false" aria-label="Listen"><Fragment set:html={svg(ICON.play)} /><span data-na-listen-label>Listen</span></button>
              <button type="button" class="na-listen-stop" data-na-listen-stop hidden aria-label="Stop listening"><Fragment set:html={svg(ICON.stop)} /></button>
              <select data-na-speed aria-label="Reading speed">
                <option value="0.8">Slow</option>
                <option value="1" selected>Normal</option>
                <option value="1.25">Fast</option>
              </select>
            </div>
          </div>
          <button type="button" class="na-reset" data-na-reset>Reset reading settings</button>
          <button type="button" class="na-fullscreen" data-na-fullscreen hidden aria-pressed="false">
            <Fragment set:html={svg(ICON.expand)} />
            <span data-na-fullscreen-label>Read in full screen</span>
          </button>
        </div>
      </aside>

      <div class="na-main">
        {lede && <p class="na-lede" data-na-reveal>{lede}</p>}
        <div class="na-body" set:html={bodyHtml} />

        {galleryShots.length > 0 && (
          <section class="na-gallery" id="photos" aria-labelledby="na-gallery-h" data-na-gallery data-layout="mosaic">
            <div class="na-gallery-head">
              <h2 id="na-gallery-h" class="na-section-h">Photos <span class="na-count">{galleryShots.length}</span></h2>
              <div class="na-seg na-seg--sm" role="group" aria-label="Photo layout">
                <button type="button" data-na-layout="mosaic" aria-pressed="true">Mosaic</button>
                <button type="button" data-na-layout="grid" aria-pressed="false">Grid</button>
                <button type="button" data-na-layout="strip" aria-pressed="false">Strip</button>
              </div>
              <button type="button" class="na-tool na-slideshow" data-na-slideshow><Fragment set:html={svg(ICON.play)} /><span>Slideshow</span></button>
            </div>
            <ul class="na-photos" data-na-photos>
              {galleryShots.map((src, i) => (
                <li class:list={['na-photo', { 'is-extra': i >= PHOTO_PREVIEW }]} hidden={i >= PHOTO_PREVIEW}>
                  <button type="button" class="na-shot" data-na-lightbox={src} data-na-caption={item.captions[src] ?? ''} aria-label={`Open photo ${i + 1} of ${galleryShots.length}: ${shotAlt(src, i)}`}>
                    <img src={src} alt={shotAlt(src, i)} loading="lazy" decoding="async" />
                    {item.captions[src] && <span class="na-shot-cap">{item.captions[src]}</span>}
                  </button>
                </li>
              ))}
            </ul>
            {galleryShots.length > PHOTO_PREVIEW && (
              <p class="na-more-photos"><button type="button" class="na-tool" data-na-showall data-total={galleryShots.length}>Show all {galleryShots.length} photos</button></p>
            )}
          </section>
        )}

        <footer class="na-end">
          {item.tags.length > 0 && (
            <div class="na-tags">
              <span class="na-rail-label">Tags</span>
              {item.tags.map((t) => <span class="na-chip na-chip--line">{t}</span>)}
            </div>
          )}
          <a class="na-back" href="/news-notices/news"><Fragment set:html={svg(ICON.arrowL)} /> All news</a>
        </footer>
      </div>

      <aside class="na-side" aria-label="About this story">
        <section class="na-card" data-na-reveal>
          <h2 class="na-card-h">Story Details</h2>
          <dl class="na-facts">
            <div><dt>Category</dt><dd>{item.category_label}</dd></div>
            <div><dt>Published</dt><dd>{formatDate(item.date)}</dd></div>
            {item.unit_name && <div><dt>Department</dt><dd>{item.unit_name}</dd></div>}
            <div><dt>Reading time</dt><dd>{minutes} min</dd></div>
          </dl>
        </section>

        {older && (
          <a class="na-card na-upnext" href={`/news-notices/news/${older.id}`} data-na-reveal>
            <span class="na-card-h">Up next</span>
            {older.image_url && <img src={older.image_url} alt="" loading="lazy" />}
            <span class="na-upnext-kicker">{older.category_label} · {shortDate(older.date)}</span>
            <span class="na-upnext-title">{older.title}</span>
            <span class="na-upnext-go">Read story <Fragment set:html={svg(ICON.arrowR)} /></span>
          </a>
        )}

        {headlines.length > 0 && (
          <section class="na-card" data-na-reveal>
            <h2 class="na-card-h">More Headlines</h2>
            <ol class="na-headlines">
              {headlines.map((h) => (
                <li>
                  <a href={`/news-notices/news/${h.id}`}>
                    <span class="na-headline-date">{shortDate(h.date)}</span>
                    <span class="na-headline-title">{h.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )}
      </aside>
    </div>

    <!-- ====================== MORE FROM THE NEWSROOM ====================== -->
    {related.length > 0 && (
      <section class="na-more" aria-labelledby="na-more-h">
        <div class="wrap na-wide">
          <div class="na-more-head">
            <h2 id="na-more-h" class="na-more-title">More from the Newsroom</h2>
            <a class="na-more-all" href="/news-notices/news">All news <Fragment set:html={svg(ICON.arrowR)} /></a>
          </div>
          <ul class="na-more-grid">
            {related.map((r, i) => (
              <li data-na-reveal style={`--i:${i}`}>
                <a class="na-story" href={`/news-notices/news/${r.id}`}>
                  <span class:list={['na-story-media', { 'na-story-media--art': !r.image_url }]}>
                    {r.image_url ? <img src={r.image_url} alt="" loading="lazy" /> : <span class="na-story-mark">{r.category_label}</span>}
                  </span>
                  <span class="na-story-body">
                    <span class="na-story-kicker">{r.category_label} · {shortDate(r.date)}</span>
                    <span class="na-story-title">{r.title}</span>
                    <span class="na-story-excerpt">{cardExcerpt(r)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {(newer || older) && (
      <nav class="na-pager" aria-label="More stories">
        <div class="wrap na-wide na-pager-grid">
          {newer ? (
            <a class="na-pager-link" href={`/news-notices/news/${newer.id}`} rel="prev">
              <span class="na-pager-dir"><Fragment set:html={svg(ICON.arrowL)} /> Newer story</span>
              <span class="na-pager-title">{newer.title}</span>
            </a>
          ) : <span></span>}
          {older && (
            <a class="na-pager-link na-pager-link--next" href={`/news-notices/news/${older.id}`} rel="next">
              <span class="na-pager-dir">Older story <Fragment set:html={svg(ICON.arrowR)} /></span>
              <span class="na-pager-title">{older.title}</span>
            </a>
          )}
        </div>
      </nav>
    )}

    <div class="na-lightbox" data-na-box hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
      <div class="na-lb-bar">
        <span class="na-lb-count" data-na-lb-count aria-live="polite"></span>
        <div class="na-lb-tools">
          <button type="button" class="na-lb-btn" data-na-lb-play aria-pressed="false" aria-label="Start slideshow" title="Slideshow (Space)"><Fragment set:html={svg(ICON.play)} /></button>
          <button type="button" class="na-lb-btn" data-na-lb-zoom aria-pressed="false" aria-label="Zoom in" title="Zoom (Z)"><Fragment set:html={svg(ICON.zoom)} /></button>
          <a class="na-lb-btn" data-na-lb-dl href="#" download aria-label="Download this photo" title="Download"><Fragment set:html={svg(ICON.download)} /></a>
          <button type="button" class="na-lb-btn na-lb-btn--close" data-na-box-close aria-label="Close photo viewer" title="Close (Esc)"><Fragment set:html={svg(ICON.close)} /></button>
        </div>
      </div>
      <button type="button" class="na-lb-nav na-lb-nav--prev" data-na-lb-prev aria-label="Previous photo"><Fragment set:html={svg(ICON.arrowL)} /></button>
      <figure class="na-lb-fig" data-na-lb-fig>
        <img src="" alt="" data-na-lb-img />
        <figcaption data-na-lb-cap></figcaption>
      </figure>
      <button type="button" class="na-lb-nav na-lb-nav--next" data-na-lb-next aria-label="Next photo"><Fragment set:html={svg(ICON.arrowR)} /></button>
      <div class="na-lb-thumbs" data-na-lb-thumbs role="tablist" aria-label="All photos"></div>
    </div>

    <p class="na-sr" aria-live="polite" data-na-announce></p>
  </article>
</Layout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-na]');
    if (!root) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const announcer = root.querySelector('[data-na-announce]');
    const announce = (msg) => { if (announcer) { announcer.textContent = ''; requestAnimationFrame(() => (announcer.textContent = msg)); } };

    // ---- Reading progress + gentle hero parallax ----
    const bar = document.querySelector('[data-na-progress]');
    const main = root.querySelector('.na-main');
    const layers = reduceMotion ? [] : Array.from(root.querySelectorAll('[data-na-parallax]'));
    let ticking = false;
    const onScroll = () => {
      ticking = false;
      if (bar && main) {
        const r = main.getBoundingClientRect();
        const total = r.height - innerHeight * 0.6;
        const p = Math.min(1, Math.max(0, (innerHeight * 0.4 - r.top) / Math.max(total, 1)));
        bar.style.transform = `scaleX(${p})`;
      }
      const y = scrollY;
      layers.forEach((el) => {
        if (y > innerHeight * 1.2) return;
        el.style.transform = `translate3d(0, ${(y * Number(el.dataset.naParallax || 0.15)).toFixed(1)}px, 0)`;
      });
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    onScroll();

    // ---- Paragraph and card reveals (content only hidden once JS opts in) ----
    const reveal = Array.from(root.querySelectorAll('[data-na-reveal], .na-body > *'));
    if (!reduceMotion && 'IntersectionObserver' in window) {
      root.classList.add('na-anim');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
      reveal.forEach((el) => io.observe(el));
    }

    // ---- Text size (remembered on this device) ----
    const SIZES = [0.9, 1, 1.12, 1.25, 1.4];
    let sizeIndex = 1;
    try {
      const saved = localStorage.getItem('na-text-size');
      if (saved !== null && SIZES[Number(saved)]) sizeIndex = Number(saved);
    } catch {}
    const applySize = () => {
      root.style.setProperty('--na-scale', String(SIZES[sizeIndex]));
      root.querySelectorAll('[data-na-size]').forEach((b) => {
        const step = Number(b.dataset.naSize);
        b.disabled = (step < 0 && sizeIndex === 0) || (step > 0 && sizeIndex === SIZES.length - 1);
        if (step === 0) b.setAttribute('aria-pressed', String(sizeIndex === 1));
      });
    };
    applySize();
    root.querySelectorAll('[data-na-size]').forEach((b) => b.addEventListener('click', () => {
      const step = Number(b.dataset.naSize);
      sizeIndex = step === 0 ? 1 : Math.min(SIZES.length - 1, Math.max(0, sizeIndex + step));
      applySize();
      try { localStorage.setItem('na-text-size', String(sizeIndex)); } catch {}
      announce(`Text size ${Math.round(SIZES[sizeIndex] * 100)}%.`);
    }));

    // ---- Share / copy / print ----
    const shareBtn = root.querySelector('[data-na-share]');
    if (shareBtn && navigator.share) {
      shareBtn.hidden = false;
      shareBtn.addEventListener('click', () => navigator.share({ title: document.title, url: location.href }).catch(() => {}));
    }
    const copyBtn = root.querySelector('[data-na-copy]');
    copyBtn?.addEventListener('click', async () => {
      const label = copyBtn.querySelector('[data-na-copy-label]');
      try {
        await navigator.clipboard.writeText(location.href);
        label.textContent = 'Link copied';
        announce('Link copied to the clipboard.');
      } catch {
        label.textContent = 'Copy failed';
      }
      setTimeout(() => (label.textContent = 'Copy link'), 2200);
    });
    root.querySelector('[data-na-print]')?.addEventListener('click', () => print());

    // ---- Full-screen reading (where the browser supports it) ----
    const fsBtn = root.querySelector('[data-na-fullscreen]');
    if (fsBtn && document.fullscreenEnabled) {
      fsBtn.hidden = false;
      const label = fsBtn.querySelector('[data-na-fullscreen-label]');
      const sync = () => {
        const on = !!document.fullscreenElement;
        fsBtn.setAttribute('aria-pressed', String(on));
        label.textContent = on ? 'Exit full screen' : 'Read in full screen';
        document.documentElement.classList.toggle('na-is-fullscreen', on);
      };
      fsBtn.addEventListener('click', () => {
        if (document.fullscreenElement) document.exitFullscreen();
        else document.documentElement.requestFullscreen().catch(() => {});
      });
      document.addEventListener('fullscreenchange', sync);
    }

    // ---- Reading comfort: colour, typeface and spacing (remembered on this device) ----
    const prefs = { theme: 'light', font: 'serif', lead: 'normal', speed: '1' };
    try { Object.assign(prefs, JSON.parse(localStorage.getItem('na-prefs') || '{}')); } catch {}
    const applyPrefs = () => {
      root.dataset.naTheme = prefs.theme; root.dataset.naFont = prefs.font; root.dataset.naLead = prefs.lead;
      [['theme', 'naTheme'], ['font', 'naFont'], ['lead', 'naLead']].forEach(([k, d]) => {
        root.querySelectorAll('[data-na-' + k + ']').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset[d] === prefs[k])));
      });
      const sp = root.querySelector('[data-na-speed]'); if (sp) sp.value = prefs.speed;
    };
    const savePrefs = () => { try { localStorage.setItem('na-prefs', JSON.stringify(prefs)); } catch {} };
    applyPrefs();
    [['theme', 'naTheme'], ['font', 'naFont'], ['lead', 'naLead']].forEach(([k, d]) => {
      root.querySelectorAll('[data-na-' + k + ']').forEach((b) => b.addEventListener('click', () => { prefs[k] = b.dataset[d]; applyPrefs(); savePrefs(); announce(k + ' set to ' + b.textContent.trim() + '.'); }));
    });
    root.querySelector('[data-na-reset]')?.addEventListener('click', () => {
      Object.assign(prefs, { theme: 'light', font: 'serif', lead: 'normal', speed: '1' }); sizeIndex = 1; applySize();
      try { localStorage.removeItem('na-text-size'); } catch {}
      applyPrefs(); savePrefs(); announce('Reading settings reset.');
    });

    // ---- Listen to the story (the browser's own voice; paragraph by paragraph) ----
    const listenBlock = root.querySelector('[data-na-listen-block]');
    if (listenBlock && 'speechSynthesis' in window) {
      listenBlock.hidden = false;
      const btn = root.querySelector('[data-na-listen]'), stop = root.querySelector('[data-na-listen-stop]');
      const label = btn.querySelector('[data-na-listen-label]'), speed = root.querySelector('[data-na-speed]');
      const parts = () => [...root.querySelectorAll('.na-lede, .na-body > p, .na-body > h2, .na-body > h3, .na-body > li, .na-body > ul > li, .na-body > blockquote')].filter((p) => p.textContent.trim());
      let list = [], i = 0, state = 'idle';
      const mark = () => { root.querySelectorAll('.is-speaking').forEach((n) => n.classList.remove('is-speaking')); if (list[i]) { list[i].classList.add('is-speaking'); list[i].scrollIntoView({ block: 'center', behavior: reduceMotion ? 'auto' : 'smooth' }); } };
      const ui = () => { btn.setAttribute('aria-pressed', String(state === 'playing')); label.textContent = state === 'playing' ? 'Pause' : state === 'paused' ? 'Resume' : 'Listen'; stop.hidden = state === 'idle'; };
      const say = () => {
        if (i >= list.length) return end();
        const u = new SpeechSynthesisUtterance(list[i].textContent.trim());
        u.rate = Number(prefs.speed) || 1; u.lang = document.documentElement.lang || 'en';
        u.onend = () => { if (state === 'playing') { i++; say(); } };
        mark(); speechSynthesis.speak(u);
      };
      const end = () => { speechSynthesis.cancel(); state = 'idle'; i = 0; root.querySelectorAll('.is-speaking').forEach((n) => n.classList.remove('is-speaking')); ui(); };
      btn.addEventListener('click', () => {
        if (state === 'idle') { list = parts(); i = 0; state = 'playing'; ui(); say(); }
        else if (state === 'playing') { speechSynthesis.pause(); state = 'paused'; ui(); }
        else { speechSynthesis.resume(); state = 'playing'; ui(); }
      });
      stop.addEventListener('click', end);
      speed?.addEventListener('change', () => { prefs.speed = speed.value; savePrefs(); if (state === 'playing') { speechSynthesis.cancel(); say(); } });
      addEventListener('pagehide', () => speechSynthesis.cancel());
    }

    // ---- Photos: layout, "show all", and the viewer (every picture in the story, however many) ----
    const gallery = root.querySelector('[data-na-gallery]');
    if (gallery) {
      gallery.querySelectorAll('[data-na-layout]').forEach((b) => b.addEventListener('click', () => {
        gallery.dataset.layout = b.dataset.naLayout;
        gallery.querySelectorAll('[data-na-layout]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      }));
      const more = gallery.querySelector('[data-na-showall]');
      const reveal = () => { gallery.querySelectorAll('.is-extra').forEach((li) => (li.hidden = false)); more?.parentElement.remove(); };
      more?.addEventListener('click', reveal);
    }

    const box = root.querySelector('[data-na-box]');
    if (box) {
      const img = box.querySelector('[data-na-lb-img]'), cap = box.querySelector('[data-na-lb-cap]'), count = box.querySelector('[data-na-lb-count]');
      const fig = box.querySelector('[data-na-lb-fig]'), thumbs = box.querySelector('[data-na-lb-thumbs]');
      const playBtn = box.querySelector('[data-na-lb-play]'), zoomBtn = box.querySelector('[data-na-lb-zoom]'), dl = box.querySelector('[data-na-lb-dl]');
      // Everything clickable in the story: pictures inside the text first, then the gallery.
      const bodyImgs = [...root.querySelectorAll('.na-body img')];
      bodyImgs.forEach((im) => { im.style.cursor = 'zoom-in'; im.tabIndex = 0; im.setAttribute('role', 'button'); });
      const shots = () => [
        ...bodyImgs.map((im) => ({ src: im.currentSrc || im.src, alt: im.alt || '', cap: im.alt || '', el: im })),
        ...[...root.querySelectorAll('[data-na-lightbox]')].map((b) => ({ src: b.dataset.naLightbox, alt: b.querySelector('img')?.alt || '', cap: b.dataset.naCaption || '', el: b })),
      ];
      let set = [], at = 0, last = null, timer = null, zoomed = false;
      const buildThumbs = () => {
        thumbs.innerHTML = '';
        set.forEach((s, n) => {
          const t = document.createElement('button');
          t.type = 'button'; t.className = 'na-lb-thumb'; t.setAttribute('role', 'tab'); t.setAttribute('aria-label', 'Photo ' + (n + 1));
          t.innerHTML = '<img alt="" loading="lazy" src="' + s.src.replace(/"/g, '&quot;') + '">';
          t.addEventListener('click', () => go(n));
          thumbs.appendChild(t);
        });

      };
      const setZoom = (on) => { zoomed = on; fig.classList.toggle('is-zoomed', on); zoomBtn.setAttribute('aria-pressed', String(on)); zoomBtn.setAttribute('aria-label', on ? 'Zoom out' : 'Zoom in'); };
      const go = (n) => {
        at = (n + set.length) % set.length; const s = set[at];
        setZoom(false); fig.classList.remove('is-in'); void fig.offsetWidth;
        img.src = s.src; img.alt = s.alt || ('Photo ' + (at + 1) + ' of ' + set.length);
        cap.textContent = s.cap; cap.hidden = !s.cap;
        count.textContent = (at + 1) + ' / ' + set.length;
        dl.href = s.src;
        thumbs.querySelectorAll('.na-lb-thumb').forEach((t, k) => { t.setAttribute('aria-selected', String(k === at)); t.classList.toggle('is-on', k === at); if (k === at) t.scrollIntoView({ inline: 'center', block: 'nearest', behavior: reduceMotion ? 'auto' : 'smooth' }); });
        fig.classList.add('is-in');
        [at + 1, at - 1].forEach((k) => { const o = set[(k + set.length) % set.length]; if (o) { const p = new Image(); p.src = o.src; } });
      };
      const play = (on) => {
        clearInterval(timer); playBtn.setAttribute('aria-pressed', String(on));
        playBtn.setAttribute('aria-label', on ? 'Pause slideshow' : 'Start slideshow');
        playBtn.innerHTML = on ? "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 5h3v14H7zM14 5h3v14h-3z\"/></svg>" : "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 5v14l11-7z\"/></svg>";
        if (on) timer = setInterval(() => go(at + 1), 4000);
      };
      const onKey = (e) => {
        if (e.key === 'Escape') hide();
        else if (e.key === 'ArrowRight') go(at + 1);
        else if (e.key === 'ArrowLeft') go(at - 1);
        else if (e.key === ' ') { e.preventDefault(); play(playBtn.getAttribute('aria-pressed') !== 'true'); }
        else if (e.key.toLowerCase() === 'z') setZoom(!zoomed);
      };
      const hide = () => { play(false); box.hidden = true; document.documentElement.classList.remove('na-lb-lock'); document.removeEventListener('keydown', onKey); last?.focus?.(); };
      const show = (from, autoplay) => {
        set = shots(); if (!set.length) return;
        const idx = set.findIndex((s) => s.el === from);
        last = from; box.hidden = false; document.documentElement.classList.add('na-lb-lock');
        buildThumbs(); go(idx >= 0 ? idx : 0);
        box.querySelector('[data-na-box-close]').focus();
        document.addEventListener('keydown', onKey);
        if (autoplay) play(true);
      };
      root.addEventListener('click', (e) => {
        const b = e.target.closest('[data-na-lightbox]'); if (b) return show(b, false);
        const im = e.target.closest('.na-body img'); if (im) show(im, false);
      });
      root.addEventListener('keydown', (e) => { if ((e.key === 'Enter' || e.key === ' ') && e.target.matches?.('.na-body img')) { e.preventDefault(); show(e.target, false); } });
      root.querySelector('[data-na-slideshow]')?.addEventListener('click', () => show(root.querySelector('[data-na-lightbox]'), true));
      box.querySelector('[data-na-box-close]').addEventListener('click', hide);
      box.querySelector('[data-na-lb-prev]').addEventListener('click', () => go(at - 1));
      box.querySelector('[data-na-lb-next]').addEventListener('click', () => go(at + 1));
      playBtn.addEventListener('click', () => play(playBtn.getAttribute('aria-pressed') !== 'true'));
      zoomBtn.addEventListener('click', () => setZoom(!zoomed));
      img.addEventListener('click', () => setZoom(!zoomed));
      box.addEventListener('click', (e) => { if (e.target === box || e.target === fig) hide(); });
      let sx = 0;
      box.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
      box.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - sx; if (!zoomed && Math.abs(dx) > 50) go(at + (dx < 0 ? 1 : -1)); }, { passive: true });
    }
  })();
</script>
