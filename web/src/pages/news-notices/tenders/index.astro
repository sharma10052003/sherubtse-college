---
// Tenders aren't their own content type — they're Notice records with
// category "tender" (cms/src/api/notice's category enum), the same
// pattern as Admission Notices being a filtered view over Notice. Detail
// pages reuse the existing /news-notices/announcements/[id] route rather
// than duplicating it, since it's the same underlying record.
import ListingTemplate from '../../../components/templates/ListingTemplate.astro';
import { getAllCurrentNotices } from '../../../lib/content/notices';

const notices = await getAllCurrentNotices();
const tenders = notices.filter((n) => n.category === 'tender');
const rows = tenders.map((n) => ({
  id: n.id,
  href: `/news-notices/announcements/${n.id}`,
  date: new Date(n.publish_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }),
  title: n.title,
  meta: n.owning_unit_name ?? undefined,
}));
---
<ListingTemplate
  title="Tenders"
  breadcrumb={[{ label: 'Home', url: '/' }, { label: 'News & Notices', url: '/news-notices' }, { label: 'Tenders', url: '/news-notices/tenders' }]}
  rows={rows}
/>
