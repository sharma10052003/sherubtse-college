---
// Pagefind indexes the built site (dist/pagefind) after `astro build`;
// it has nothing to search against in dev mode until a build has run at
// least once — that's a Pagefind limitation, not a bug here.
import Layout from '../layouts/Layout.astro';
---
<Layout title="Search" description="Search the Sherubtse College website.">
  <div class="wrap narrow" style="padding-top:var(--s5);padding-bottom:var(--s7)">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> › <span class="current">Search</span></nav>
    <h1 class="h1">Search</h1>
    <div id="search" style="margin-top:var(--s5)"></div>
    <noscript><p class="small">Search requires JavaScript. Browse the site using the menu instead.</p></noscript>
  </div>
</Layout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  // The masthead search box submits here as a plain GET (?q=...) — works
  // with JavaScript disabled, matching the noscript fallback above. With
  // JS on, this reads that query back out of the URL and drives it into
  // Pagefind's own input so the visitor lands straight on their results
  // instead of an empty search box they'd have to retype into.
  window.addEventListener('DOMContentLoaded', () => {
    if (!window.PagefindUI) return;
    new window.PagefindUI({ element: '#search', showSubResults: true });

    const q = new URLSearchParams(window.location.search).get('q');
    if (!q) return;
    const input = document.querySelector('#search input[type="text"]');
    if (!input) return;
    input.value = q;
    input.dispatchEvent(new Event('input', { bubbles: true }));
  });
</script>
