---
// Site search. Results come from the site search index (/search-index.json,
// built from the same Strapi content as the pages — see lib/search-index.ts),
// searched in the browser by lib/search-client.ts. Works in `astro dev` and
// in the built site. Reads ?q= so the header search lands straight on results.
import Layout from '../layouts/Layout.astro';
import '../styles/search.css';

const SUGGESTIONS = [
  { label: 'Admissions', url: '/admissions' },
  { label: 'Programmes', url: '/academics/programmes' },
  { label: 'Academic calendar', url: '/academics/calendar' },
  { label: 'Announcements', url: '/news-notices/announcements' },
  { label: 'Downloads & forms', url: '/news-notices/downloads' },
  { label: 'Contact us', url: '/about/contact' },
];
---
<Layout title="Search" description="Search the Sherubtse College website.">
  <div class="sr">
    <header class="sr-hero">
      <div class="wrap">
        <nav class="sr-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><span aria-current="page">Search</span></nav>
        <h1 class="sr-title">Search</h1>
        <form class="sr-form" action="/search" role="search" data-sr-form>
          <label class="sr-sr" for="sr-q">Search the site</label>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M20 20l-4.8-4.8" /></svg>
          <input id="sr-q" type="search" name="q" placeholder="Search programmes, notices, people, forms…" autocomplete="off" data-sr-input />
          <button type="submit">Search</button>
        </form>
      </div>
    </header>

    <div class="wrap sr-body">
      <div class="sr-chips" role="group" aria-label="Filter results by type" data-sr-chips hidden></div>
      <p class="sr-status" role="status" aria-live="polite" data-sr-status></p>
      <ol class="sr-results" data-sr-results></ol>

      <div class="sr-suggest" data-sr-suggest>
        <p class="sr-suggest-title">Popular pages</p>
        <ul>
          {SUGGESTIONS.map((s) => <li><a href={s.url}>{s.label}</a></li>)}
        </ul>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { loadIndex, search, highlight, type SearchResult } from '../lib/search-client';

  const form = document.querySelector<HTMLFormElement>('[data-sr-form]')!;
  const input = document.querySelector<HTMLInputElement>('[data-sr-input]')!;
  const chips = document.querySelector<HTMLElement>('[data-sr-chips]')!;
  const status = document.querySelector<HTMLElement>('[data-sr-status]')!;
  const list = document.querySelector<HTMLOListElement>('[data-sr-results]')!;
  const suggest = document.querySelector<HTMLElement>('[data-sr-suggest]')!;

  const params = new URLSearchParams(location.search);
  input.value = params.get('q') ?? '';
  let kind = params.get('type') ?? '';
  const PAGE = 20;
  let shown = PAGE;

  const pathOf = (u: string) => (/^https?:/.test(u) ? new URL(u).hostname : u.split('#')[0]);

  function render(all: SearchResult[], q: string) {
    // Type chips with counts (only types that have results).
    const counts = new Map<string, number>();
    all.forEach((r) => counts.set(r.k, (counts.get(r.k) ?? 0) + 1));
    if (kind && !counts.has(kind)) kind = '';
    chips.hidden = all.length === 0;
    chips.innerHTML = [['', 'All', all.length] as const, ...[...counts.entries()].sort((a, b) => b[1] - a[1]).map(([k, n]) => [k, k, n] as const)]
      .map(([k, label, n]) => `<button type="button" data-kind="${k}" aria-pressed="${k === kind}">${label} <span>${n}</span></button>`)
      .join('');

    const results = kind ? all.filter((r) => r.k === kind) : all;
    status.textContent = q
      ? results.length
        ? `${results.length} result${results.length === 1 ? '' : 's'} for “${q}”`
        : `No results for “${q}”. Try fewer or different words, or one of the pages below.`
      : '';
    suggest.hidden = results.length > 0;

    list.innerHTML = results
      .slice(0, shown)
      .map((r) => {
        const ext = /^https?:/.test(r.u);
        return `<li class="sr-item">
          <span class="sr-kind sr-kind--${r.k.toLowerCase()}">${r.k}</span>
          <h2 class="sr-item-title"><a href="${r.u}"${ext ? ' target="_blank" rel="noopener"' : ''}>${highlight(r.t, q)}</a></h2>
          ${r.d ? `<p class="sr-item-text">${highlight(r.d, q)}</p>` : ''}
          <p class="sr-item-url">${pathOf(r.u)}${ext ? ' ↗' : ''}</p>
        </li>`;
      })
      .join('');
    if (results.length > shown) {
      list.insertAdjacentHTML('beforeend', `<li class="sr-more-wrap"><button type="button" class="sr-more" data-sr-more>Show more results (${results.length - shown} more)</button></li>`);
    }
  }

  async function run(pushUrl = false) {
    const q = input.value.trim();
    if (pushUrl) {
      const url = new URL(location.href);
      q ? url.searchParams.set('q', q) : url.searchParams.delete('q');
      kind ? url.searchParams.set('type', kind) : url.searchParams.delete('type');
      history.replaceState(null, '', url);
    }
    if (!q) {
      chips.hidden = true;
      list.innerHTML = '';
      status.textContent = '';
      suggest.hidden = false;
      return;
    }
    status.textContent = 'Searching…';
    const index = await loadIndex();
    if (!index.length) {
      status.textContent = 'Search is temporarily unavailable. Please try again shortly, or use the menu.';
      return;
    }
    if (q !== input.value.trim()) return;
    render(search(index, q), q);
  }

  let timer: ReturnType<typeof setTimeout> | undefined;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    shown = PAGE;
    timer = setTimeout(() => run(true), 180);
  });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    shown = PAGE;
    run(true);
  });
  chips.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-kind]');
    if (!b) return;
    kind = b.dataset.kind ?? '';
    shown = PAGE;
    run(true);
  });
  list.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-sr-more]')) return;
    shown += PAGE;
    run();
  });

  run();
  if (!input.value) input.focus();
</script>
