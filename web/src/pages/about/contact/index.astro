---
import Layout from '../../../layouts/Layout.astro';
import { getContactPageContent, getContactOffices } from '../../../lib/content/contact';
import type { ContactOffice } from '../../../lib/content/contact';
import { getSiteSettings } from '../../../lib/content/site-settings';
import '../../../styles/contact-hub.css';

const [content, offices, siteSettings] = await Promise.all([
  getContactPageContent(),
  getContactOffices(),
  getSiteSettings(),
]);

const address = siteSettings.address || 'Sherubtse College, Kanglung, Trashigang 42003, Bhutan';
// "Map URL" in Contact – Page overrides the directions link; otherwise it's a
// Google Maps search for the address in Global – Site Settings.
const directionsUrl = content.map_url || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;

// Admins may type a bare email address into a link field.
const toHref = (link: string) => (/^[^\s@:/]+@[^\s@]+$/.test(link) ? `mailto:${link}` : link);
const isExternal = (href: string) => /^https?:\/\//i.test(href);
const withSubject = (href: string, subject: string | null) =>
  subject && href.startsWith('mailto:') && !href.includes('?') ? `${href}?subject=${encodeURIComponent(subject)}` : href;
const ictHref = content.ict_button_link ? withSubject(toHref(content.ict_button_link), content.ict_email_subject) : null;
const showIct = Boolean(content.ict_heading || content.ict_text || ictHref);

/** Shows the number as entered; dials it in international form (+975, trunk 0 dropped). */
function telHref(phone: string) {
  const digits = phone.replace(/\D/g, '');
  if (digits.startsWith('975')) return `tel:+975${digits.slice(3).replace(/^0/, '')}`;
  if (digits.startsWith('0')) return `tel:+975${digits.slice(1)}`;
  return phone.trim().startsWith('+') ? `tel:+${digits}` : `tel:${digits}`;
}

const ICONS: Record<string, string> = {
  president: '<path d="M3 8l4.5 4L12 5l4.5 7L21 8l-2 10H5z"/><path d="M5 21h14"/><circle cx="12" cy="3.2" r=".6"/>',
  academic: '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11.2V16c0 1.4 2.7 3 6 3s6-1.6 6-3v-4.8"/><path d="M22 9v6"/>',
  student: '<circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"/><circle cx="17" cy="9" r="2.5"/><path d="M17 14.5c2.4 0 4 1.8 4 4.5"/>',
  research: '<path d="M9 3h6"/><path d="M10 3v5.5L5 18a2 2 0 0 0 1.8 3h10.4A2 2 0 0 0 19 18l-5-9.5V3"/><path d="M7.8 14h8.4"/><circle cx="11" cy="17.5" r=".7"/><circle cx="14" cy="16.5" r=".7"/>',
  admin: '<rect x="3" y="7" width="18" height="13" rx="2.5"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/><path d="M3 13h18"/><path d="M11 13v2h2v-2"/>',
  ict: '<rect x="2.5" y="4" width="19" height="12" rx="2.5"/><path d="M8 20h8M12 16v4"/><path d="M8.5 10.5a5 5 0 0 1 7 0"/><path d="M10.3 12.3a2.5 2.5 0 0 1 3.4 0"/>',
  exam: '<rect x="5" y="4" width="14" height="17" rx="2.5"/><path d="M9 4V3h6v1"/><path d="m9 12 2 2 4-4"/><path d="M9 17.5h6"/>',
  location: '<path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  phone: '<path d="M5 4h3.5l1.8 4.5-2.2 1.4a11 11 0 0 0 5 5l1.4-2.2L19 14.5V18a2 2 0 0 1-2.2 2A15 15 0 0 1 3 6.2 2 2 0 0 1 5 4z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  directions: '<path d="M3 11l18-8-8 18-2-8z"/>',
  map: '<path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z"/><path d="M9 4v14M15 6v14"/>',
  support: '<path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="2" y="14" width="5" height="6" rx="2"/><rect x="17" y="14" width="5" height="6" rx="2"/><path d="M20 20a4 4 0 0 1-4 3h-3"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  down: '<path d="M12 5v14M6 13l6 6 6-6"/>',
  send: '<path d="M21 3 10 14"/><path d="M21 3l-7 18-4-8-8-4z"/>',
  copy: '<rect x="9" y="9" width="12" height="12" rx="3"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/>',
  check: '<path d="m5 12 5 5L20 7"/>',
  external: '<path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  person: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.9 3.1-6 7-6s7 2.1 7 6"/>',
  chat: '<path d="M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9l-5 4v-4H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"/><path d="M8 10h8M8 13h5"/>',
};

function icon(name: string, className = '') {
  return `<svg class="${className}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${ICONS[name] ?? ICONS.admin}</svg>`;
}

// "How Can We Help?" topics come from Contact – Page; each names one office
// by its Group Title in Contact – Offices, so every section shares one source
// of contact details. Topics whose office doesn't exist are left out rather
// than shown as a button that does nothing.
const officeKey = (title: string) => title.trim().toLowerCase();
const officeByKey = new Map(offices.map((o) => [officeKey(o.group_title), o]));
const helpTopics = content.help_topics.filter((t) => officeByKey.has(officeKey(t.office)));

const isIct = (o: ContactOffice) => o.group_icon === 'ict';

// Search matches office name, person, designation, description, and the
// "How Can We Help?" topics that point at the office (e.g. "admissions").
const searchText = (o: ContactOffice) =>
  [
    o.group_title,
    o.full_name,
    o.role_title,
    o.group_description,
    ...helpTopics.filter((t) => officeKey(t.office) === officeKey(o.group_title)).map((t) => t.label),
  ]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();

const L = content.labels;
const fill = (template: string, vars: Record<string, string | number>) =>
  template.replace(/\{(\w+)\}/g, (m, k) => (k in vars ? String(vars[k]) : m));

---

<Layout title={content.page_title} description={content.seo_description}>
  <div class="ct">
    <!-- ====================== HERO + SEARCH ====================== -->
    <section class="ct-hero" aria-labelledby="ct-title">
      <div class="ct-hero-bg" aria-hidden="true">
        {content.hero_image_url && <img class="ct-hero-photo" src={content.hero_image_url} alt="" />}
        <span class="ct-hero-glow ct-hero-glow--a"></span>
        <span class="ct-hero-glow ct-hero-glow--b"></span>
        <span class="ct-hero-ring ct-hero-ring--a"></span>
        <span class="ct-hero-ring ct-hero-ring--b"></span>
        <span class="ct-bubble ct-bubble--1" set:html={icon('mail')} />
        <span class="ct-bubble ct-bubble--2" set:html={icon('phone')} />
        <span class="ct-bubble ct-bubble--3" set:html={icon('chat')} />
        <span class="ct-bubble ct-bubble--4" set:html={icon('location')} />
      </div>

      <div class="wrap ct-wide ct-hero-grid">
        <div class="ct-hero-main ct-rise">
          <nav class="ct-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a> › <a href="/about">About</a> › <span aria-current="page">{content.page_title}</span>
          </nav>
          <p class="ct-eyebrow ct-eyebrow--light">{content.hero_eyebrow}</p>
          <h1 id="ct-title" class="ct-hero-title">{content.hero_title}</h1>
          {content.hero_subtitle && <p class="ct-hero-intro">{content.hero_subtitle}</p>}

          <form class="ct-search" role="search" data-ct-search-form>
            <label for="ct-search" class="ct-search-label">{content.search_label}</label>
            <div class="ct-search-box">
              <Fragment set:html={icon('search', 'ct-search-icon')} />
              <input
                id="ct-search"
                type="search"
                name="q"
                autocomplete="off"
                spellcheck="false"
                placeholder={content.search_placeholder ?? ''}
                aria-controls="ct-directory-grid"
                aria-describedby="ct-search-status"
              />
              <button type="button" class="ct-search-clear" data-ct-search-clear aria-label={L.search_clear_label} hidden>
                <Fragment set:html={icon('close')} />
              </button>
            </div>
            <p class="ct-search-status" id="ct-search-status" aria-live="polite" data-ct-search-status>
              {fill(L.search_count_text, { count: offices.length })}
            </p>
          </form>
          <a href="#directory" class="ct-explore" data-ct-jump>
            <span>{content.offices_heading}</span>
            <Fragment set:html={icon('down')} />
          </a>
        </div>

        <nav class="ct-quick ct-rise ct-rise--2" aria-label={L.quick_actions_label}>
          <a href="#directory" class="ct-quick-item" data-ct-jump>
            <span class="ct-quick-icon" set:html={icon('search')} />
            <span class="ct-quick-text">
              <strong>{content.quick_find_title}</strong>
              {content.quick_find_text && <span>{content.quick_find_text}</span>}
            </span>
            <Fragment set:html={icon('arrow', 'ct-quick-arrow')} />
          </a>
          <a href="#enquiry" class="ct-quick-item" data-ct-jump>
            <span class="ct-quick-icon" set:html={icon('send')} />
            <span class="ct-quick-text">
              <strong>{content.quick_enquiry_title}</strong>
              {content.quick_enquiry_text && <span>{content.quick_enquiry_text}</span>}
            </span>
            <Fragment set:html={icon('arrow', 'ct-quick-arrow')} />
          </a>
          <a href="#location" class="ct-quick-item" data-ct-jump>
            <span class="ct-quick-icon" set:html={icon('directions')} />
            <span class="ct-quick-text">
              <strong>{content.quick_directions_title}</strong>
              {content.quick_directions_text && <span>{content.quick_directions_text}</span>}
            </span>
            <Fragment set:html={icon('arrow', 'ct-quick-arrow')} />
          </a>
        </nav>
      </div>
    </section>

    <!-- ====================== THE COLLEGE'S OWN CONTACT DETAILS ====================== -->
    <section class="ct-reach" aria-labelledby="ct-reach-h">
      <div class="wrap ct-wide">
        <header class="ct-reach-head">
          <p class="ct-eyebrow ct-eyebrow--light">{L.info_eyebrow}</p>
          <h2 id="ct-reach-h" class="ct-sr">{content.info_heading}</h2>
          {content.info_subtitle && <p class="ct-reach-sub">{content.info_subtitle}</p>}
        </header>
        <ul class="ct-reach-list">
          <li class="ct-reach-item" data-ct-reveal style="--i:0">
            <span class="ct-reach-icon" set:html={icon('mail')} />
            <div class="ct-reach-body">
              <h3>{L.email_label}</h3>
              <p class="ct-reach-value">
                {content.general_email ? <a href={`mailto:${content.general_email}`}>{content.general_email}</a> : L.not_confirmed_text}
              </p>
              {content.general_email && (
                <div class="ct-reach-actions">
                  <button type="button" class="ct-copy" data-ct-copy={content.general_email}>
                    <Fragment set:html={icon('copy')} /><span data-ct-copy-label>{L.copy_address_label.replace(/address/i, L.email_label.toLowerCase())}</span>
                  </button>
                </div>
              )}
            </div>
          </li>
          <li class="ct-reach-item" data-ct-reveal style="--i:1">
            <span class="ct-reach-icon" set:html={icon('phone')} />
            <div class="ct-reach-body">
              <h3>{L.phone_label}</h3>
              <p class="ct-reach-value">
                {content.general_phone ? <a href={telHref(content.general_phone)}>{content.general_phone}</a> : L.not_confirmed_text}
              </p>
              {content.general_phone && (
                <div class="ct-reach-actions">
                  <button type="button" class="ct-copy" data-ct-copy={content.general_phone}>
                    <Fragment set:html={icon('copy')} /><span data-ct-copy-label>{L.copy_address_label.replace(/address/i, L.phone_label.toLowerCase())}</span>
                  </button>
                </div>
              )}
            </div>
          </li>
          <li class="ct-reach-item" data-ct-reveal style="--i:2">
            <span class="ct-reach-icon" set:html={icon('clock')} />
            <div class="ct-reach-body">
              <h3>{L.hours_label}</h3>
              <p class="ct-reach-value">{content.office_hours ?? L.not_confirmed_text}</p>
            </div>
          </li>
          <li class="ct-reach-item" data-ct-reveal style="--i:3">
            <span class="ct-reach-icon" set:html={icon('location')} />
            <div class="ct-reach-body">
              <h3>{L.address_label}</h3>
              <p class="ct-reach-value" data-ct-address>{address}</p>
              <div class="ct-reach-actions">
                <button type="button" class="ct-copy" data-ct-copy={address} data-ct-copy-address>
                  <Fragment set:html={icon('copy')} /><span data-ct-copy-label>{L.copy_address_label}</span>
                </button>
                <a class="ct-copy" href={directionsUrl} target="_blank" rel="noopener">
                  <Fragment set:html={icon('directions')} />{content.directions_label}<span class="ct-sr">(opens Google Maps in a new tab)</span>
                </a>
              </div>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- ====================== OFFICE DIRECTORY ====================== -->
    <section id="directory" class="ct-directory" aria-labelledby="ct-directory-h">
      <div class="wrap ct-wide">
        <header class="ct-head" data-ct-reveal>
          <div>
            <p class="ct-eyebrow">{L.directory_eyebrow}</p>
            <h2 id="ct-directory-h" class="ct-h2" tabindex="-1">{content.offices_heading}</h2>
          </div>
          {content.offices_intro && <p class="ct-lede">{content.offices_intro}</p>}
        </header>

        <ul class="ct-grid" id="ct-directory-grid">
          {
            offices.map((o, i) => (
              <li
                class:list={['ct-office', { 'ct-office--ict': isIct(o) }]}
                data-office={o.group_title}
                data-search={searchText(o)}
                data-ct-reveal
                style={`--i:${i}`}
              >
                <div class="ct-office-top">
                  <span class="ct-office-icon" set:html={icon(o.group_icon || 'admin')} />
                </div>
                <h3 class="ct-office-name">{o.group_title}</h3>
                {o.group_description && <p class="ct-office-desc">{o.group_description}</p>}
                {(o.full_name || o.role_title) && (
                  <p class="ct-office-person">
                    <Fragment set:html={icon('person')} />
                    <span>
                      {o.full_name && <strong>{o.full_name}</strong>}
                      {o.role_title && <span>{o.role_title}</span>}
                    </span>
                  </p>
                )}
                {o.email && (
                  <a class="ct-office-email" href={`mailto:${o.email}`}>
                    {o.email}
                  </a>
                )}
                <div class="ct-office-actions">
                  {o.email && (
                    <a class="ct-btn ct-btn--navy" href={`mailto:${o.email}`} aria-label={`${content.email_button_label}: ${o.group_title}`}>
                      <Fragment set:html={icon('mail')} />
                      {content.email_button_label}
                    </a>
                  )}
                  {o.phone && (
                    <a class="ct-btn ct-btn--line" href={telHref(o.phone)} aria-label={`${content.call_button_label}: ${o.group_title}, ${o.phone}`}>
                      <Fragment set:html={icon('phone')} />
                      {content.call_button_label}
                    </a>
                  )}
                  {isIct(o) && showIct && (
                    <a class="ct-btn ct-btn--gold" href="#ict-support" data-ct-jump>
                      <Fragment set:html={icon('support')} />
                      {content.ict_card_button_label}
                    </a>
                  )}
                </div>
                <button type="button" class="ct-office-enquire" data-enquire={o.group_title}>
                  {content.spotlight_enquiry_label}
                  <Fragment set:html={icon('arrow')} />
                </button>
              </li>
            ))
          }
        </ul>

        <div class="ct-empty" data-ct-empty hidden>
          <Fragment set:html={icon('search', 'ct-empty-icon')} />
          <div>
            <p class="ct-empty-title">
              {content.search_empty_message} <span data-ct-empty-query></span>
            </p>
            <p class="ct-empty-text">{L.search_empty_hint}</p>
            <div class="ct-empty-actions">
              <button type="button" class="ct-btn ct-btn--navy" data-ct-search-reset>{L.search_reset_label}</button>
              <a href="#enquiry" class="ct-btn ct-btn--line" data-ct-jump>{content.quick_enquiry_title}</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================== ENQUIRY ====================== -->
    <section id="help" class="ct-help" aria-labelledby="ct-enquiry-h">
      <div class="wrap ct-wide ct-help-grid">
        <aside class="ct-enquiry-intro" data-ct-reveal>
          <span class="ct-enquiry-badge" set:html={icon('send')} />
          <h2 id="ct-enquiry-h" class="ct-h2 ct-h2--light" tabindex="-1">{content.enquiry_heading}</h2>
          {content.enquiry_intro && <p class="ct-enquiry-lede">{content.enquiry_intro}</p>}
          <svg class="ct-enquiry-art" viewBox="0 0 340 220" aria-hidden="true">
            <path class="ct-art-path" d="M14 196C86 180 92 92 176 108S276 70 314 30" />
            <circle class="ct-art-ring" cx="300" cy="44" r="40" />
            <g class="ct-art-plane" transform="translate(278 22) scale(1.8)">
              <circle cx="12" cy="12" r="13" />
              <path d="M21 3 10 14" transform="translate(-4 -1) scale(.75)" />
              <path d="M21 3l-7 18-4-8-8-4z" transform="translate(-4 -1) scale(.75)" />
            </g>
          </svg>
        </aside>

        <div id="enquiry" class="ct-enquiry" data-ct-reveal>

          <form class="ct-form" id="enquiryForm" novalidate aria-labelledby="ct-enquiry-h">
            <p class="ct-form-note"><span aria-hidden="true">*</span> {L.form_required_note}</p>
            <fieldset>
              <legend>{L.form_details_legend}</legend>
              <div class="ct-form-grid">
                <div class="ct-field ct-field--full">
                  <label for="enq-name">{content.form_name_label} <span class="ct-req" aria-hidden="true">*</span></label>
                  <input type="text" id="enq-name" name="full_name" required maxlength="120" autocomplete="name" />
                </div>
                <div class="ct-field">
                  <label for="enq-email">{content.form_email_label} <span class="ct-req" aria-hidden="true">*</span></label>
                  <input type="email" id="enq-email" name="email" required maxlength="160" autocomplete="email" inputmode="email" />
                </div>
                <div class="ct-field">
                  <label for="enq-phone">{content.form_phone_label} <span class="ct-optional">{L.form_optional_text}</span></label>
                  <input type="tel" id="enq-phone" name="phone" maxlength="40" autocomplete="tel" />
                </div>
              </div>
            </fieldset>
            <fieldset>
              <legend>{L.form_enquiry_legend}</legend>
              <div class="ct-form-grid">
                <div class="ct-field ct-field--full">
                  <label for="enq-department">{content.form_department_label} <span class="ct-req" aria-hidden="true">*</span></label>
                  <select id="enq-department" name="department" required>
                    <option value="">{content.form_department_placeholder}</option>
                    {offices.map((o) => <option value={o.group_title}>{o.group_title}</option>)}
                    {content.form_other_department && (
                      <option value={content.form_other_department}>{content.form_other_department}</option>
                    )}
                  </select>
                </div>
                <div class="ct-field ct-field--full">
                  <label for="enq-subject">{content.form_subject_label} <span class="ct-req" aria-hidden="true">*</span></label>
                  <input type="text" id="enq-subject" name="subject" required maxlength="200" />
                </div>
                <div class="ct-field ct-field--full">
                  <label for="enq-message">{content.form_message_label} <span class="ct-req" aria-hidden="true">*</span></label>
                  <textarea id="enq-message" name="message" required maxlength="5000" rows="5"></textarea>
                </div>
              </div>
            </fieldset>
            <div class="ct-hp" aria-hidden="true">
              <label for="enq-hp">Leave this field empty</label>
              <input type="text" id="enq-hp" name="hp_field" tabindex="-1" autocomplete="off" />
            </div>
            <div class="ct-form-foot">
              <button type="submit" class="ct-btn ct-btn--navy ct-btn--lg">
                <span class="ct-spinner" aria-hidden="true"></span>
                <Fragment set:html={icon('send')} />
                {content.form_submit_label}
              </button>
              <p class="ct-status" role="status" data-form-status></p>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- ====================== LOCATION ====================== -->
    <section id="location" class="ct-location" aria-labelledby="ct-location-h">
      <div class="wrap ct-wide ct-location-grid">
        <figure class="ct-map" data-ct-reveal>
          <svg viewBox="0 0 640 420" role="img" aria-labelledby="ct-map-title">
            <title id="ct-map-title">{`${L.map_pin_label} — ${L.map_caption}`}</title>
            <rect width="640" height="420" class="ct-map-sky" />
            <path class="ct-map-hill ct-map-hill--3" d="M0 210 90 150l80 40 110-90 90 70 70-40 110 80 90-50v460H0z" />
            <path class="ct-map-hill ct-map-hill--2" d="M0 260l120-50 90 30 120-70 110 60 90-30 110 50v230H0z" />
            <path class="ct-map-hill ct-map-hill--1" d="M0 320l140-40 120 20 130-50 120 40 130-20v150H0z" />
            <g class="ct-map-contours">
              <path d="M40 370c80-30 160-30 240-10s170 10 320-30" />
              <path d="M20 395c100-25 200-20 300-5s190 0 300-25" />
            </g>
            <path class="ct-map-road" d="M-10 400C90 360 150 380 230 330s150-40 230-60 120-50 200-40" />
            <g class="ct-map-pin" transform="translate(320 250)">
              <circle r="26" class="ct-map-pulse" />
              <path d="M0 6s-14-12-14-22a14 14 0 0 1 28 0c0 10-14 22-14 22z" />
              <circle cy="-16" r="5" class="ct-map-dot" />
            </g>
            <g class="ct-map-label" transform="translate(352 238)">
              <rect x="0" y="-18" width="150" height="34" />
              <text x="12" y="4">{L.map_pin_label}</text>
            </g>
          </svg>
          <figcaption>{L.map_caption}</figcaption>
        </figure>

        <div class="ct-location-body" data-ct-reveal>
          <p class="ct-eyebrow">{L.location_eyebrow}</p>
          <h2 id="ct-location-h" class="ct-h2" tabindex="-1">{content.map_heading}</h2>
          {content.map_intro && <p class="ct-lede">{content.map_intro}</p>}
          <div class="ct-place">
            <span class="ct-place-icon" set:html={icon('location')} />
            <div>
              <p class="ct-place-name">{content.map_place_name}</p>
              <p class="ct-place-address">{address}</p>
            </div>
          </div>
          <div class="ct-map-links">
            <a class="ct-map-link ct-map-link--primary" href={directionsUrl} target="_blank" rel="noopener">
              <span class="ct-map-link-icon" set:html={icon('directions')} />
              <span class="ct-map-link-text">
                <strong>{content.directions_label}</strong>
                <span>{L.directions_note}</span>
              </span>
              <Fragment set:html={icon('external', 'ct-map-link-ext')} />
              <span class="ct-sr">(opens Google Maps in a new tab)</span>
            </a>
            {
              content.campus_map_url && (
                <a class="ct-map-link" href={content.campus_map_url} target="_blank" rel="noopener">
                  <span class="ct-map-link-icon" set:html={icon('map')} />
                  <span class="ct-map-link-text">
                    <strong>{content.campus_map_label}</strong>
                    <span>{L.campus_map_note}</span>
                  </span>
                  <Fragment set:html={icon('external', 'ct-map-link-ext')} />
                  <span class="ct-sr">(opens in a new tab)</span>
                </a>
              )
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ====================== ICT SUPPORT ====================== -->
    {
      showIct && (
        <section id="ict-support" class="ct-ict" aria-labelledby={content.ict_heading ? 'ct-ict-h' : undefined}>
          <svg class="ct-ict-net" viewBox="0 0 600 300" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
            <g class="ct-ict-lines">
              <path d="M60 240 180 160 300 210 420 90 540 150" />
              <path d="M180 160 250 60 420 90" />
              <path d="M300 210 380 280 540 150" />
              <path d="M250 60 120 40" />
            </g>
            <g class="ct-ict-nodes">
              <circle cx="60" cy="240" r="5" />
              <circle cx="180" cy="160" r="7" />
              <circle cx="300" cy="210" r="5" />
              <circle cx="420" cy="90" r="8" />
              <circle cx="540" cy="150" r="6" />
              <circle cx="250" cy="60" r="5" />
              <circle cx="380" cy="280" r="4" />
              <circle cx="120" cy="40" r="4" />
            </g>
          </svg>
          <div class="wrap ct-wide ct-ict-inner" data-ct-reveal>
            <span class="ct-ict-icon" set:html={icon('ict')} />
            <div class="ct-ict-body">
              <p class="ct-eyebrow ct-eyebrow--light">{L.ict_eyebrow}</p>
              {content.ict_heading && (
                <h2 id="ct-ict-h" class="ct-h2 ct-h2--light" tabindex="-1">
                  {content.ict_heading}
                </h2>
              )}
              {content.ict_text && <p>{content.ict_text}</p>}
            </div>
            {ictHref && (
              <a
                class="ct-btn ct-btn--gold ct-btn--lg"
                href={ictHref}
                target={isExternal(ictHref) ? '_blank' : undefined}
                rel={isExternal(ictHref) ? 'noopener' : undefined}
              >
                <Fragment set:html={icon('mail')} />
                {content.ict_button_label}
              </a>
            )}
          </div>
        </section>
      )
    }

    <p class="ct-sr" aria-live="polite" data-ct-announce></p>
  </div>
</Layout>

<script
  is:inline
  define:vars={{
    strapiUrl: import.meta.env.PUBLIC_STRAPI_URL || 'http://localhost:1337',
    texts: {
      success: content.form_success_message,
      error: content.form_error_message,
      empty: content.search_empty_message,
    },
    labels: content.labels,
    total: offices.length,
  }}
>
  (() => {
    const root = document.querySelector('.ct');
    if (!root) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const announcer = root.querySelector('[data-ct-announce]');
    const announce = (msg) => {
      if (!announcer) return;
      announcer.textContent = '';
      requestAnimationFrame(() => (announcer.textContent = msg));
    };
    const key = (s) => (s || '').trim().toLowerCase();
    const fill = (template, vars) => template.replace(/\{(\w+)\}/g, (m, k) => (k in vars ? String(vars[k]) : m));

    // ---- Scroll reveals (content is only hidden once JS has opted in) ----
    const revealEls = Array.from(root.querySelectorAll('[data-ct-reveal]'));
    if (reduceMotion || !('IntersectionObserver' in window)) {
      revealEls.forEach((el) => el.classList.add('is-in'));
    } else {
      root.classList.add('ct-anim');
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' },
      );
      revealEls.forEach((el) => io.observe(el));
    }

    // ---- Gentle parallax on the hero's decorative layers ----
    const layers = Array.from(root.querySelectorAll('[data-parallax]'));
    if (!reduceMotion && layers.length) {
      let ticking = false;
      const update = () => {
        ticking = false;
        layers.forEach((el) => {
          const rect = el.closest('section').getBoundingClientRect();
          if (rect.bottom < 0) return;
          el.style.transform = `translate3d(0, ${(Math.max(0, -rect.top) * Number(el.dataset.parallax)).toFixed(1)}px, 0)`;
        });
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    }

    // ---- In-page jumps: smooth scroll, then focus the target heading ----
    function jumpTo(id, focusEl) {
      const target = document.getElementById(id);
      if (!target) return;
      target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      const el = focusEl || target.querySelector('h2[tabindex="-1"]') || target;
      if (!el.hasAttribute('tabindex') && !/^(INPUT|SELECT|TEXTAREA|BUTTON|A)$/.test(el.tagName)) el.setAttribute('tabindex', '-1');
      setTimeout(() => el.focus({ preventScroll: true }), reduceMotion ? 0 : 450);
      history.replaceState(null, '', `#${id}`);
    }
    root.addEventListener('click', (e) => {
      const link = e.target.closest('a[data-ct-jump]');
      if (!link) return;
      e.preventDefault();
      jumpTo(link.getAttribute('href').slice(1));
    });

    // ---- Live directory search ----
    const search = document.getElementById('ct-search');
    const clearBtn = root.querySelector('[data-ct-search-clear]');
    const statusEl = root.querySelector('[data-ct-search-status]');
    const cards = Array.from(root.querySelectorAll('.ct-office'));
    const empty = root.querySelector('[data-ct-empty]');
    const emptyQuery = root.querySelector('[data-ct-empty-query]');
    // Accents and punctuation are ignored, so "wifi" finds "Wi-Fi".
    const fold = (s) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^\p{L}\p{N}\s]/gu, '');
    let searchTimer;
    function applySearch() {
      const q = fold(search.value.trim());
      const words = q.split(/\s+/).filter(Boolean);
      let shown = 0;
      cards.forEach((card) => {
        const hay = fold(card.dataset.search);
        const match = words.every((w) => hay.includes(w));
        card.hidden = !match;
        if (match) { shown++; card.classList.add('is-in'); }
      });
      clearBtn.hidden = !q;
      empty.hidden = shown > 0;
      if (emptyQuery) emptyQuery.textContent = q ? `(“${search.value.trim()}”)` : '';
      const msg = !q
        ? fill(labels.search_count_text, { count: total })
        : shown
          ? fill(labels.search_match_text, { shown, count: total, query: search.value.trim() })
          : `${texts.empty} (“${search.value.trim()}”)`;
      statusEl.textContent = msg;
    }
    function resetSearch(focus) {
      search.value = '';
      applySearch();
      if (focus) search.focus();
    }
    if (search) {
      search.addEventListener('input', () => { clearTimeout(searchTimer); searchTimer = setTimeout(applySearch, 120); });
      search.addEventListener('keydown', (e) => { if (e.key === 'Escape' && search.value) { e.preventDefault(); resetSearch(true); } });
      root.querySelector('[data-ct-search-form]').addEventListener('submit', (e) => {
        e.preventDefault();
        applySearch();
        jumpTo('directory', document.getElementById('ct-directory-h'));
      });
      clearBtn.addEventListener('click', () => resetSearch(true));
      root.querySelector('[data-ct-search-reset]')?.addEventListener('click', () => resetSearch(true));
    }

    // ---- Enquiry form: "Start an enquiry" on an office card sets the department ----
    const form = document.getElementById('enquiryForm');
    const deptSelect = form?.querySelector('#enq-department');
    function selectOffice(title) {
      if (!deptSelect) return false;
      const opt = Array.from(deptSelect.options).find((o) => key(o.value) === key(title));
      if (!opt) return false;
      if (deptSelect.value !== opt.value) { deptSelect.value = opt.value; clearError(deptSelect); }
      return true;
    }
    root.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-enquire]');
      if (!btn || !form) return;
      selectOffice(btn.dataset.enquire);
      const firstEmpty = Array.from(form.querySelectorAll('input[required], textarea[required]')).find((el) => !el.value.trim());
      jumpTo('enquiry', firstEmpty || form.querySelector('#enq-subject'));
      announce('Enquiry form: department set to ' + btn.dataset.enquire + '.');
    });

    // ---- Copy buttons (email, phone, address) ----
    root.querySelectorAll('[data-ct-copy]').forEach((btn) => {
      const label = btn.querySelector('[data-ct-copy-label]');
      const original = label ? label.textContent : '';
      btn.addEventListener('click', async () => {
        const text = btn.dataset.ctCopy;
        try {
          await navigator.clipboard.writeText(text);
          if (label) label.textContent = btn.hasAttribute('data-ct-copy-address') ? labels.copied_label : 'Copied';
          btn.classList.add('is-done');
          announce('Copied: ' + text);
        } catch {
          if (label) label.textContent = 'Press Ctrl+C to copy';
        }
        setTimeout(() => { if (label) label.textContent = original; btn.classList.remove('is-done'); }, 2600);
      });
    });

    // ---- Enquiry form: inline validation + honest submission states ----
    const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
    // The label's own text, without the "*" / "(optional)" marker spans.
    const fieldLabel = (input) => (input.labels?.[0]?.firstChild?.textContent || input.name).trim();

    function clearError(input) { setError(input, ''); }
    function setError(input, message) {
      const field = input.closest('.ct-field');
      let err = field?.querySelector('.ct-error');
      if (message) {
        if (!err && field) {
          err = document.createElement('p');
          err.className = 'ct-error';
          err.id = `${input.id}-error`;
          field.appendChild(err);
        }
        if (err) err.textContent = message;
        input.setAttribute('aria-invalid', 'true');
        if (err) input.setAttribute('aria-describedby', err.id);
      } else {
        input.removeAttribute('aria-invalid');
        input.removeAttribute('aria-describedby');
        err?.remove();
      }
    }
    function check(input) {
      if (input.name === 'hp_field') return true;
      const value = input.value.trim();
      let message = '';
      if (input.required && !value) {
        message = input.tagName === 'SELECT' ? labels.validation_department : fill(labels.validation_required, { field: fieldLabel(input).toLowerCase() });
      } else if (input.type === 'email' && value && !EMAIL.test(value)) {
        message = labels.validation_email;
      }
      setError(input, message);
      return !message;
    }
    function setStatus(kind, message) {
      const el = form.querySelector('[data-form-status]');
      el.className = `ct-status is-${kind}`;
      el.textContent = message;
    }

    if (form) {
      form.querySelectorAll('input, textarea, select').forEach((el) => {
        el.addEventListener('blur', () => { if (el.getAttribute('aria-invalid') === 'true' || el.value) check(el); });
        el.addEventListener('input', () => { if (el.getAttribute('aria-invalid') === 'true') check(el); });
        el.addEventListener('change', () => { if (el.getAttribute('aria-invalid') === 'true') check(el); });
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (form.dataset.busy === 'true') return;
        const invalid = Array.from(form.querySelectorAll('input, textarea, select')).filter((el) => !check(el));
        if (invalid.length) {
          invalid[0].focus();
          setStatus('error', labels.form_fix_message);
          return;
        }
        const button = form.querySelector('button[type="submit"]');
        const fd = new FormData(form);
        const val = (k) => { const v = (fd.get(k) || '').toString().trim(); return v || null; };
        form.dataset.busy = 'true';
        form.setAttribute('aria-busy', 'true');
        button.disabled = true;
        button.classList.add('is-loading');
        setStatus('loading', labels.form_sending_message);
        try {
          const res = await fetch(`${strapiUrl}/api/contact-enquiries`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              data: {
                full_name: val('full_name'), email: val('email'), phone: val('phone'),
                department: val('department'), subject: val('subject'), message: val('message'),
                hp_field: fd.get('hp_field') || '',
              },
            }),
          });
          const body = await res.json().catch(() => null);
          if (!res.ok) {
            const err = new Error(body?.error?.message || `Request failed (${res.status})`);
            err.status = res.status;
            throw err;
          }
          setStatus('success', texts.success);
          form.reset();
        } catch (err) {
          // Typed details stay in the form so the visitor can simply retry.
          setStatus('error', err.status === 429 ? labels.rate_limit_message : `${texts.error} (${err.message})`);
        } finally {
          form.dataset.busy = 'false';
          form.removeAttribute('aria-busy');
          button.disabled = false;
          button.classList.remove('is-loading');
        }
      });
    }
  })();
</script>
