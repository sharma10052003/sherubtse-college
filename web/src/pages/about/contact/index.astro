---
import Layout from '../../../layouts/Layout.astro';
import { getContactPageContent, getContactOffices } from '../../../lib/content/contact';
import { getSiteSettings } from '../../../lib/content/site-settings';
import '../../../styles/contact.css';

const [content, offices, siteSettings] = await Promise.all([
  getContactPageContent(),
  getContactOffices(),
  getSiteSettings(),
]);

const address = siteSettings.address || 'Sherubtse College, Kanglung, Trashigang, Bhutan';
const directionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;

// Real, already-in-use icon strokes (Footer.astro's pin/envelope/phone), plus
// one simple glyph per office group — every icon shares the same stroke
// treatment (fill:none, stroke-width 2) so a new one is a drop-in.
const ICONS: Record<string, string> = {
  president: '<path d="M4 15 2 7l5.5 3.5L12 4l4.5 6.5L22 7l-2 8z"/><path d="M4 15h16v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"/>',
  academic: '<path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="M6 10v6c0 1.5 3 3 6 3s6-1.5 6-3v-6"/><path d="M22 7v7"/>',
  student: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>',
  research: '<path d="M9 3h6"/><path d="M10 3v6l-5.5 9.5A1.7 1.7 0 0 0 6 21h12a1.7 1.7 0 0 0 1.5-2.5L14 9V3"/><path d="M7.5 15h9"/>',
  admin: '<rect x="3" y="7" width="18" height="13" rx="0"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 12h18"/>',
  ict: '<rect x="3" y="4" width="18" height="12" rx="0"/><path d="M8 20h8M12 16v4"/><path d="M7 9a5 5 0 0 1 10 0"/>',
  exam: '<rect x="5" y="3" width="14" height="18" rx="0"/><path d="M9 3v3h6V3"/><path d="m9 12 2 2 4-4"/>',
  location: '<path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="0"/><path d="M3 6l9 7 9-7"/>',
  phone: '<path d="M4 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L14 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 2 6a2 2 0 0 1 2-2z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  directions: '<path d="M3 11l18-8-8 18-2-8-8-2z"/>',
  support: '<rect x="4" y="4" width="16" height="12" rx="0"/><path d="M9 20h6M12 16v4"/><path d="m8 8 2 2M16 8l-2 2"/>',
};

function icon(name: string, className = '') {
  return `<svg class="${className}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name] ?? ''}</svg>`;
}

// "How Can We Help?" categories, each mapped to one of the same 7 office
// records above — one real data source for both the card grid and the
// selector, instead of a second hardcoded list that could drift from it.
const HELP_CATEGORIES = [
  { emoji: '🎓', label: 'Admissions & Programmes', office: 'Academic Affairs' },
  { emoji: '👥', label: 'Student Services', office: 'Student Affairs' },
  { emoji: '📝', label: 'Examination & Records', office: 'Examination & Records' },
  { emoji: '🔬', label: 'Research & Collaboration', office: 'Research & Industrial Linkages' },
  { emoji: '🗂️', label: 'Administration', office: 'Administration' },
  { emoji: '💻', label: 'ICT & Digital Services', office: 'ICT & Digital Services' },
  { emoji: '🏛️', label: 'General Institutional Matters', office: 'Office of the President' },
];

const officesForClient = offices.map((o) => ({
  group_title: o.group_title,
  group_description: o.group_description,
  full_name: o.full_name,
  role_title: o.role_title,
  email: o.email,
  phone: o.phone,
}));
---

<Layout
  title="Contact Us"
  description="Connect with Sherubtse College, Royal University of Bhutan. Find contact information for academic, student, administrative, research, examination, and ICT services."
>
  <section class="contact-hero">
    <div class="wrap contact-hero-content">
      <nav class="breadcrumb breadcrumb-on-dark" aria-label="Breadcrumb">
        <a href="/">Home</a> › <a href="/about">About</a> › <span class="current">Contact Us</span>
      </nav>
      <p class="eyebrow">{content.hero_eyebrow}</p>
      <h1 class="h-display">{content.hero_title}</h1>
      <p class="contact-hero-sub">{content.hero_subtitle}</p>
    </div>
  </section>

  <!-- Find the Right Office -->
  <section class="band" aria-labelledby="find-office-heading">
    <div class="wrap">
      <div class="contact-section-head">
        <h2 class="h2" id="find-office-heading">Find the Right Office</h2>
        <p class="lede">Every office at a glance — who to contact, what they handle, and how to reach them directly.</p>
      </div>
      <div class="contact-grid">
        {
          offices.map((office) => (
            <article class="contact-card reveal">
              <div class="contact-card-icon" set:html={icon(office.group_icon || 'admin')} />
              <h3 class="h3">{office.group_title}</h3>
              {office.group_description && <p class="contact-card-desc">{office.group_description}</p>}
              {(office.full_name || office.role_title) && (
                <p class="contact-card-person">
                  {office.full_name && <span class="name">{office.full_name}</span>}
                  {office.role_title && <span class="role">{office.role_title}</span>}
                </p>
              )}
              <div class="contact-card-actions">
                {office.email && (
                  <a class="btn btn-primary" href={`mailto:${office.email}`}>
                    Email Us
                  </a>
                )}
                {office.phone && (
                  <a class="btn btn-secondary" href={`tel:${office.phone.replace(/[^+\d]/g, '')}`}>
                    Call Office
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How Can We Help? -->
  <section class="band band-alt" aria-labelledby="help-heading">
    <div class="wrap">
      <div class="contact-section-head">
        <h2 class="h2" id="help-heading">How Can We Help?</h2>
        <p class="lede">Tell us what you need, and we'll point you to the right office.</p>
      </div>
      <div class="help-selector" role="group" aria-label="Choose what you need help with" id="helpSelector">
        {
          HELP_CATEGORIES.map((c, i) => (
            <button type="button" class="help-chip" data-office={c.office} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class="help-chip-emoji" aria-hidden="true">
                {c.emoji}
              </span>
              {c.label}
            </button>
          ))
        }
      </div>
      <div class="help-result" id="helpResult" aria-live="polite"></div>
    </div>
  </section>

  <!-- Have a Question? -->
  <section class="band" aria-labelledby="enquiry-heading">
    <div class="wrap">
      <div class="contact-section-head">
        <h2 class="h2" id="enquiry-heading">Have a Question?</h2>
        <p class="lede">Send us a general enquiry and the right office will get back to you.</p>
      </div>
      <form class="contact-form" id="enquiryForm" novalidate>
        <div class="form-grid cols-2">
          <div class="form-field">
            <label for="enq-name">Full Name *</label>
            <input type="text" id="enq-name" name="full_name" required autocomplete="name" />
          </div>
          <div class="form-field">
            <label for="enq-email">Email Address *</label>
            <input type="email" id="enq-email" name="email" required autocomplete="email" />
          </div>
          <div class="form-field">
            <label for="enq-phone">Phone Number</label>
            <input type="tel" id="enq-phone" name="phone" autocomplete="tel" />
          </div>
          <div class="form-field">
            <label for="enq-department">Select Department *</label>
            <select id="enq-department" name="department" required>
              <option value="">Choose a department…</option>
              {offices.map((o) => <option value={o.group_title}>{o.group_title}</option>)}
              <option value="Other / Not Sure">Other / Not Sure</option>
            </select>
          </div>
          <div class="form-field span-2">
            <label for="enq-subject">Subject *</label>
            <input type="text" id="enq-subject" name="subject" required />
          </div>
          <div class="form-field span-2">
            <label for="enq-message">Message *</label>
            <textarea id="enq-message" name="message" required></textarea>
          </div>
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top:var(--s5)">
          Submit Enquiry
        </button>
        <p class="form-status" id="enquiryFormStatus" role="status"></p>
      </form>
    </div>
  </section>

  <!-- Contact Information Highlight -->
  <section class="band band-navy" aria-labelledby="info-heading">
    <div class="wrap">
      <h2 class="h2" id="info-heading">Sherubtse College</h2>
      <p class="lede" style="margin-bottom:var(--s6)">Royal University of Bhutan &middot; Kanglung, Trashigang, Bhutan</p>
      <div class="contact-info-grid">
        <div class="contact-info-item">
          <Fragment set:html={icon('location')} />
          <div>
            <h3>Address</h3>
            <p>{address}</p>
          </div>
        </div>
        <div class="contact-info-item">
          <Fragment set:html={icon('mail')} />
          <div>
            <h3>Email</h3>
            <p>{content.general_email ?? 'To be confirmed'}</p>
          </div>
        </div>
        <div class="contact-info-item">
          <Fragment set:html={icon('phone')} />
          <div>
            <h3>Phone</h3>
            <p>{content.general_phone ?? 'To be confirmed'}</p>
          </div>
        </div>
        <div class="contact-info-item">
          <Fragment set:html={icon('clock')} />
          <div>
            <h3>Office Hours</h3>
            <p>{content.office_hours ?? 'To be confirmed'}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Map -->
  <section class="band" aria-labelledby="map-heading">
    <div class="wrap">
      <div class="contact-section-head">
        <h2 class="h2" id="map-heading">Find Us at Sherubtse</h2>
        <p class="lede">Kanglung, Trashigang — the eastern hills of Bhutan.</p>
      </div>
      <div class="map-panel reveal">
        <div class="map-pin" set:html={icon('location')} />
        <p class="h3" style="margin:0">Sherubtse College</p>
        <p class="small" style="margin:0">{address}</p>
        <div class="map-panel-actions">
          <a class="btn btn-primary" href={directionsUrl} target="_blank" rel="noopener">
            <Fragment set:html={icon('directions')} /> Get Directions
          </a>
          <a class="btn btn-secondary" href="https://finalmap.sherubtse.edu.bt/" target="_blank" rel="noopener">
            View Campus Map
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ICT Support highlight -->
  <section class="band band-alt" aria-labelledby="ict-heading">
    <div class="wrap">
      <div class="ict-support reveal">
        <div class="ict-support-icon" set:html={icon('support')} />
        <div class="ict-support-body">
          <h2 class="h3" id="ict-heading">Need Technical Assistance?</h2>
          <p>Wi-Fi, college systems, student/staff accounts, the website, network access, or other ICT services.</p>
        </div>
        <a class="btn btn-primary" href="mailto:ict.sherubtse@rub.edu.bt">ICT Support</a>
      </div>
    </div>
  </section>
</Layout>

<script
  is:inline
  define:vars={{
    strapiUrl: import.meta.env.PUBLIC_STRAPI_URL || 'http://localhost:1337',
    offices: officesForClient,
  }}
>
  // ---- "How Can We Help?" category selector ----
  const selector = document.getElementById('helpSelector');
  const result = document.getElementById('helpResult');
  if (selector && result) {
    const chips = Array.from(selector.querySelectorAll('.help-chip'));

    function render(officeTitle) {
      const office = offices.find((o) => o.group_title === officeTitle);
      if (!office) {
        result.innerHTML = '';
        return;
      }
      const contactBits = [];
      if (office.full_name || office.role_title) {
        contactBits.push(`<span>${[office.full_name, office.role_title].filter(Boolean).join(' — ')}</span>`);
      }
      if (office.email) contactBits.push(`<a href="mailto:${office.email}">${office.email}</a>`);
      if (office.phone) contactBits.push(`<a href="tel:${office.phone.replace(/[^+\d]/g, '')}">${office.phone}</a>`);
      result.innerHTML = `
        <p class="help-result-office">${office.group_title}</p>
        ${office.group_description ? `<p class="help-result-desc">${office.group_description}</p>` : ''}
        <div class="help-result-contact">${contactBits.join('')}</div>
      `;
    }

    function select(chip) {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      result.classList.add('is-switching');
      window.setTimeout(() => {
        render(chip.dataset.office);
        result.classList.remove('is-switching');
      }, 120);
    }

    selector.addEventListener('click', (e) => {
      const chip = e.target.closest('.help-chip');
      if (chip) select(chip);
    });

    render(chips[0]?.dataset.office);
  }

  // ---- Enquiry form: posts to Strapi's narrow public create-only
  // endpoint (Public role has create on contact-enquiries only — no
  // find/update/delete — see cms/src/index.ts), same pattern as the
  // Alumni page's story/registration/newsletter forms. ----
  function setStatus(el, kind, message) {
    el.className = `form-status is-visible ${kind}`;
    el.textContent = message;
  }

  const enquiryForm = document.getElementById('enquiryForm');
  enquiryForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = document.getElementById('enquiryFormStatus');
    if (!enquiryForm.checkValidity()) {
      enquiryForm.reportValidity();
      return;
    }
    const fd = new FormData(enquiryForm);
    setStatus(status, 'loading', 'Sending your enquiry…');
    try {
      const res = await fetch(`${strapiUrl}/api/contact-enquiries`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          data: {
            full_name: fd.get('full_name'),
            email: fd.get('email'),
            phone: fd.get('phone') || null,
            subject: fd.get('subject'),
            department: fd.get('department') || null,
            message: fd.get('message'),
          },
        }),
      });
      if (!res.ok) {
        const body = await res.json().catch(() => null);
        throw new Error(body?.error?.message || `Request failed (${res.status})`);
      }
      setStatus(status, 'success', "Thank you — your enquiry has been sent. The right office will be in touch soon.");
      enquiryForm.reset();
    } catch (err) {
      setStatus(status, 'error', `Something went wrong: ${err.message}. Please try again or email ${offices[0]?.email || 'the College'}.`);
    }
  });
</script>
