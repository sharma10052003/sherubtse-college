---
// About the College — leadership. Everything is edited in Strapi:
//  - About – The College: eyebrow, heading, intro, contact note, SEO text and
//    the small wording (Labels);
//  - About – Leadership: the people (name, role, photo, optional short bio,
//    order, group) — add or remove people there and the page follows;
//  - About – Overview: the “continue exploring” links (its boxes).
// Design: the President stands in an arch-shaped portrait (like a Bhutanese
// window) inside slowly turning gold rings; below, an org-chart style team
// row where gold lines branch down to each Dean. Rounded and moving by the
// project owner's request. Styles: about-college.css (.lg).
import Layout from '../../layouts/Layout.astro';
import '../../styles/about-college.css';
import { getAboutPage, getLeaders, type Leader } from '../../lib/content/leadership';
import { getLandingPage } from '../../lib/content/landing';

const settle = <T,>(p: Promise<T>, fallback: T) => p.catch(() => fallback);
const [page, leaders, overview] = await Promise.all([
  getAboutPage(),
  settle(getLeaders(), [] as Leader[]),
  settle(getLandingPage('about-overview'), null),
]);

// Wording from About – The College → Labels (defaults match the Strapi seed).
const DEFAULTS: Record<string, string> = {
  president_heading: 'President',
  deans_heading: 'Deans',
  directors_heading: 'Directors and heads',
  team_heading: 'The leadership team',
  team_intro: 'The President and the Deans guide the College’s academic programmes, student life, research and partnerships.',
  contact_label: 'Contact office',
  meet_label: 'Meet the team',
  more_heading: 'Continue exploring',
  initials_label: 'Portrait of {name}',
};
const t = (k: string) => (typeof page.labels[k] === 'string' && page.labels[k].trim() ? page.labels[k].trim() : DEFAULTS[k] ?? '');

const CONTACT = '/about/contact';
const president = leaders.find((l) => l.category === 'president') ?? null;
const deans = leaders.filter((l) => l.category === 'dean');
const directors = leaders.filter((l) => l.category === 'director');
const teamCount = deans.length + directors.length;
// Desktop: the gold lines branch from the trunk to the first row of Deans.
const cols = Math.max(1, Math.min(deans.length, 4));

const more = (overview?.cards ?? []).filter((c) => c.label && c.url && !c.url.includes('about-the-college')).slice(0, 8);
const arrow = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const down = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>';
const initialsLabel = (l: Leader) => t('initials_label').replace('{name}', l.name);
---
<Layout title="About the College" description={page.seo_description ?? page.intro}>
  <div class="lg" data-lg>
    <!-- ============ HERO: the President ============ -->
    <header class:list={['lg-hero', { 'lg-hero--solo': !president }]}>
      <span class="lg-glow" aria-hidden="true"></span>
      <div class="wrap lg-hero-grid">
        <div class="lg-hero-text">
          <nav class="lg-breadcrumb lg-rise" style="--d:0" aria-label="Breadcrumb">
            <a href="/">Home</a><span aria-hidden="true">›</span><a href="/about">About</a><span aria-hidden="true">›</span><span aria-current="page">About the College</span>
          </nav>
          {page.eyebrow && <p class="lg-eyebrow lg-rise" style="--d:1">{page.eyebrow}</p>}
          <h1 class="lg-title lg-rise" style="--d:2">{page.heading}</h1>
          {page.intro && <p class="lg-intro lg-rise" style="--d:3">{page.intro}</p>}

          {president && (
            <div class="lg-pres lg-rise" style="--d:4">
              <p class="lg-pres-label"><span aria-hidden="true"></span>{t('president_heading')}</p>
              <h2 class="lg-pres-name">{president.name}</h2>
              <p class="lg-pres-role">{president.role_title}</p>
              {president.bio && <p class="lg-pres-bio">{president.bio}</p>}
              <div class="lg-actions">
                <a class="lg-btn lg-btn--gold" href={president.office_url ?? CONTACT}>{t('contact_label')} <Fragment set:html={arrow} /></a>
                {teamCount > 0 && <a class="lg-btn lg-btn--line" href="#team">{t('meet_label')} <Fragment set:html={down} /></a>}
              </div>
            </div>
          )}
        </div>

        {president && (
          <div class="lg-stage lg-rise" style="--d:3" data-lg-stage>
            <span class="lg-ring lg-ring--a" aria-hidden="true"></span>
            <span class="lg-ring lg-ring--b" aria-hidden="true"></span>
            <span class="lg-dot lg-dot--1" aria-hidden="true"></span>
            <span class="lg-dot lg-dot--2" aria-hidden="true"></span>
            <figure class="lg-arch">
              {president.photo_url ? (
                <img src={president.photo_url} alt={president.alt} width={president.photo_width ?? 840} height={president.photo_height ?? 1080} loading="eager" decoding="async" />
              ) : (
                <span class="lg-initials" role="img" aria-label={initialsLabel(president)}>{president.initials}</span>
              )}
            </figure>
            <p class="lg-tag">{president.role_title}</p>
          </div>
        )}
      </div>
    </header>

    <!-- ============ TEAM ============ -->
    {leaders.length === 0 ? (
      <section class="lg-band">
        <div class="wrap">
          <p class="lg-fallback">
            Our leadership profiles are temporarily unavailable. Please check back shortly, or visit the
            <a href={CONTACT}>Contact page</a>.
          </p>
        </div>
      </section>
    ) : teamCount > 0 && (
      <section class="lg-band" id="team" aria-labelledby="lg-team-h">
        <div class="wrap">
          <header class="lg-head" data-lg-reveal>
            <h2 class="lg-h2" id="lg-team-h">{t('team_heading')}</h2>
            {t('team_intro') && <p class="lg-lede">{t('team_intro')}</p>}
          </header>

          {deans.length > 0 && (
            <div class="lg-tree" style={`--cols:${cols}`} data-lg-tree>
              <span class="lg-trunk" aria-hidden="true"></span>
              {deans.length > 1 && <span class="lg-bus" aria-hidden="true"></span>}
              <p class="lg-group"><span>{t('deans_heading')}</span></p>
              <ul class="lg-grid">
                {deans.map((d, i) => (
                  <li class:list={['lg-item', { 'lg-item--stub': i < cols }]} data-lg-reveal style={`--i:${i}`}>
                    <article class="lg-card">
                      <span class="lg-card-fill" aria-hidden="true"></span>
                      <div class="lg-photo">
                        {d.photo_url ? (
                          <img src={d.photo_url} alt={d.alt} width={d.photo_width ?? 440} height={d.photo_height ?? 566} loading="lazy" decoding="async" />
                        ) : (
                          <span class="lg-initials" role="img" aria-label={initialsLabel(d)}>{d.initials}</span>
                        )}
                      </div>
                      <div class="lg-card-body">
                        <p class="lg-role">{d.role_title}</p>
                        <h3 class="lg-name">{d.name}</h3>
                        {d.bio && <p class="lg-bio">{d.bio}</p>}
                        <a class="lg-link" href={d.office_url ?? CONTACT}>{t('contact_label')} <Fragment set:html={arrow} /></a>
                      </div>
                    </article>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {directors.length > 0 && (
            <div class="lg-more-people">
              <p class="lg-group lg-group--plain"><span>{t('directors_heading')}</span></p>
              <ul class="lg-grid lg-grid--auto">
                {directors.map((d, i) => (
                  <li class="lg-item" data-lg-reveal style={`--i:${i}`}>
                    <article class="lg-card">
                      <span class="lg-card-fill" aria-hidden="true"></span>
                      <div class="lg-photo">
                        {d.photo_url ? (
                          <img src={d.photo_url} alt={d.alt} width={d.photo_width ?? 440} height={d.photo_height ?? 566} loading="lazy" decoding="async" />
                        ) : (
                          <span class="lg-initials" role="img" aria-label={initialsLabel(d)}>{d.initials}</span>
                        )}
                      </div>
                      <div class="lg-card-body">
                        <p class="lg-role">{d.role_title}</p>
                        <h3 class="lg-name">{d.name}</h3>
                        {d.bio && <p class="lg-bio">{d.bio}</p>}
                        <a class="lg-link" href={d.office_url ?? CONTACT}>{t('contact_label')} <Fragment set:html={arrow} /></a>
                      </div>
                    </article>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- ============ CONTACT NOTE + CONTINUE EXPLORING ============ -->
    <section class="lg-end" aria-label={t('more_heading')}>
      <div class="wrap">
        {page.contact_note && (
          <aside class="lg-note" data-lg-reveal>
            <p>{page.contact_note}</p>
            <a class="lg-btn lg-btn--gold" href={CONTACT}>Go to the Contact page <Fragment set:html={arrow} /></a>
          </aside>
        )}
        {more.length > 0 && (
          <div class="lg-more" data-lg-reveal>
            <h2 class="lg-more-title">{t('more_heading')}</h2>
            <ul>
              {more.map((c) => <li><a href={c.url} title={c.description || undefined}>{c.label}</a></li>)}
            </ul>
          </div>
        )}
      </div>
    </section>
  </div>
</Layout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-lg]');
    if (!root) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    // The President's portrait drifts a little with the pointer.
    const stage = root.querySelector('[data-lg-stage]');
    const hero = root.querySelector('.lg-hero');
    if (stage && hero && !reduce && fine) {
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        stage.style.setProperty('--px', ((e.clientX - r.left) / r.width - 0.5).toFixed(3));
        stage.style.setProperty('--py', ((e.clientY - r.top) / r.height - 0.5).toFixed(3));
      });
    }

    // The gold lines draw themselves and the cards rise in, once, when seen.
    if (reduce || !('IntersectionObserver' in window)) return;
    root.classList.add('lg-anim');
    const io = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (!en.isIntersecting) return;
      en.target.classList.add('is-in');
      io.unobserve(en.target);
    }), { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
    root.querySelectorAll('[data-lg-reveal], [data-lg-tree]').forEach((el) => io.observe(el));
  })();
</script>
