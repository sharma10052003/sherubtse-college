---
// Campus Facilities — a photo-first "campus explorer": a full-bleed hero whose
// photographs cross-fade, a tile for each type of facility, then a rail of tall
// photo panels (the active one opens up, the others fold to a tab) with a
// sticky filter, a masonry photo gallery with a viewer, and link cards.
// Everything comes from About → Campus Facilities in Strapi
// (lib/content/facilities.ts): page settings, the Library and Laboratories
// blocks, facilities, categories, gallery and links; section order and
// visibility are Page Settings → Sections. A facility with no photograph is
// shown as an icon panel until one is added. Styles: facilities-landing.css (.fl);
// the detail text reuses facilities.css (.cf-detail).
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/facilities.css';
import '../../../styles/facilities-landing.css';
import ShowcaseDetail from '../../../components/facilities/ShowcaseDetail.astro';
import { getFacilitiesData } from '../../../lib/content/facilities';
import type { Section } from '../../../lib/content/facilities';
import { buildShowcase } from '../../../lib/content/facilities-showcase';
import { icon } from '../../../lib/facility-icons';

const { ok, page, categories, allCategories, facilities, gallery, quickLinks } = await getFacilitiesData();
const sectionId = (s: Section) => s.anchor ?? s.key;
const linkAttrs = (url: string) => (/^https?:\/\//i.test(url) ? { target: '_blank', rel: 'noopener' } : {});

const hasContent = (s: Section) => {
  switch (s.kind) {
    case 'library': return !!page.library?.intro_html;
    case 'laboratories': return !!page.laboratories?.intro_html;
    case 'gallery': return gallery.length > 0 || !!page.messages.no_gallery;
    case 'links': return quickLinks.length > 0;
    case 'rich-text': case 'image-text': return !!s.body_html;
    default: return true;
  }
};
const sections = page.sections.filter(hasContent);
const { items, tiles, slides } = buildShowcase({ page, categories: allCategories, facilities, gallery, sections });

// The rail takes the place of the first of the Library / Laboratories / Directory sections.
const railIndex = sections.findIndex((s) => ['library', 'laboratories', 'directory'].includes(s.kind));
const directory = sections.find((s) => s.kind === 'directory');
const expandLabel = directory?.expand_label || 'Explore facility details';
const railHeading = directory?.heading ?? null;
const railIntro = directory?.intro ?? null;
const railAnchor = directory ? sectionId(directory) : railIndex >= 0 ? sectionId(sections[railIndex]) : 'facilities';
const galleryCategories = categories.filter((c) => gallery.some((g) => g.category?.slug === c.slug));
const quickNav = page.quick_nav;
const catNames = (cats: { name: string }[]) => cats.map((c) => c.name).join(' · ');
---
<Layout title={page.seo_title || page.title} description={page.seo_description || page.intro || undefined}>
  <div class="cf fl" data-fl>
    <!-- ============================ HERO ============================ -->
    <header class="fl-hero" data-fl-hero>
      <div class="fl-hero-media" aria-hidden="true">
        {slides.map((s, i) => (
          <img class:list={['fl-slide', { 'is-active': i === 0 }]} src={s.url} alt="" data-fl-slide data-caption={s.caption ?? ''} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        ))}
        <span class="fl-hero-shade"></span>
      </div>

      <div class="wrap fl-wide fl-hero-inner">
        <nav class="fl-breadcrumb fl-rise" style="--d:0" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">›</span><a href="/about">About</a><span aria-hidden="true">›</span><span aria-current="page">{page.title}</span>
        </nav>
        <p class="fl-eyebrow fl-rise" style="--d:1">{page.eyebrow || 'Life on Campus'}</p>
        <h1 class="fl-title fl-rise" style="--d:2">{page.title}</h1>
        {page.intro && <p class="fl-intro fl-rise" style="--d:3">{page.intro}</p>}
        {quickNav.length > 0 && (
          <nav class="fl-jumps fl-rise" style="--d:4" aria-label="Jump to">
            {quickNav.map((n) => <a href={n.target} data-fl-jump>{n.label}</a>)}
          </nav>
        )}
      </div>

      {slides.length > 0 && (
        <div class="wrap fl-wide fl-hero-foot">
          <p class="fl-hero-cap" data-fl-cap>{slides[0].caption}</p>
          {slides.length > 1 && (
            <div class="fl-dots" role="group" aria-label="Photographs">
              {slides.map((_, i) => <button type="button" class:list={['fl-dot', { 'is-active': i === 0 }]} data-fl-dot={i} aria-label={`Photograph ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'}></button>)}
            </div>
          )}
        </div>
      )}
    </header>

    {!ok && <div class="wrap fl-wide"><p class="fl-note">{page.messages.no_facilities}</p></div>}

    <!-- ============================ SECTIONS ============================ -->
    {sections.map((s, si) => {
      const id = sectionId(s);
      const head = (s.heading || s.intro) && !['cta', 'library', 'laboratories', 'directory'].includes(s.kind);
      if (['library', 'laboratories', 'directory'].includes(s.kind) && si !== railIndex) return null;
      return (
        <section id={s.kind === 'directory' || si === railIndex ? railAnchor : id} class:list={['fl-section', `fl-section--${s.kind}`, `fl-bg-${s.background}`]} aria-labelledby={s.heading ? `${id}-h` : undefined}>
          <div class="wrap fl-wide">
            {head && (
              <header class="fl-head" data-fl-reveal>
                {s.heading && <h2 class="fl-h2" id={`${id}-h`}>{s.heading}</h2>}
                {s.intro && <p class="fl-lede">{s.intro}</p>}
              </header>
            )}

            {/* ---------- Categories ---------- */}
            {s.kind === 'index' && tiles.length > 0 && (
              <ul class="fl-tiles" style={`--n:${Math.min(tiles.length, 5)}`} role="list">
                {tiles.map((t, i) => (
                  <li class="fl-tile-item" data-fl-reveal style={`--d:${i * 80}ms`}>
                    <a class:list={['fl-tile', { 'fl-tile--photo': !!t.image }]} href={`?category=${t.category.slug}#${railAnchor}`} data-fl-cat={t.category.slug}>
                      {t.image && <img src={t.image.url} alt="" loading="lazy" decoding="async" />}
                      <span class="fl-tile-shade" aria-hidden="true"></span>
                      <span class="fl-tile-icon" set:html={icon(t.category.icon)} />
                      <span class="fl-tile-body">
                        <strong>{t.category.name}</strong>
                        <span>{t.count} {t.count === 1 ? 'facility' : 'facilities'}</span>
                      </span>
                      <span class="fl-tile-go" aria-hidden="true" set:html={icon('arrow')} />
                    </a>
                  </li>
                ))}
              </ul>
            )}

            {/* ---------- Facility rail ---------- */}
            {si === railIndex && (
              <div class="fl-explorer" data-fl-explorer>
                {(railHeading || railIntro) && (
                  <header class="fl-head" data-fl-reveal>
                    {railHeading && <h2 class="fl-h2" id={`${id}-h`}>{railHeading}</h2>}
                    {railIntro && <p class="fl-lede">{railIntro}</p>}
                  </header>
                )}
                {items.length > 0 ? (
                  <>
                    <div class="fl-bar" data-fl-bar>
                      <div class="fl-chips" role="group" aria-label="Filter by type">
                        <button type="button" class="fl-chip is-on" data-fl-filter="" aria-pressed="true">All<span>{items.length}</span></button>
                        {tiles.map((t) => (
                          <button type="button" class="fl-chip" data-fl-filter={t.category.slug} aria-pressed="false">
                            <span class="fl-chip-icon" set:html={icon(t.category.icon)} />{t.category.name}<span>{t.count}</span>
                          </button>
                        ))}
                      </div>
                      <p class="fl-count" role="status" aria-live="polite" data-fl-count>{items.length} {items.length === 1 ? 'facility' : 'facilities'}</p>
                    </div>

                    <div class="fl-rail" data-fl-rail>
                      {items.map((it, i) => (
                        <article
                          id={`fl-${it.key}`}
                          class:list={['fl-panel', { 'is-active': i === 0, 'fl-panel--plain': !it.image }]}
                          data-fl-panel
                          data-key={it.key}
                          data-cats={it.categories.map((c) => c.slug).join(' ')}
                          aria-labelledby={`fl-${it.key}-h`}
                        >
                          {it.image ? (
                            <img class="fl-panel-img" src={it.image.url} alt={it.image.alt} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
                          ) : (
                            <div class="fl-panel-art" aria-hidden="true">
                              <span class="fl-panel-ring"></span>
                              <span class="fl-panel-art-icon" set:html={icon(it.icon)} />
                            </div>
                          )}
                          <span class="fl-panel-shade" aria-hidden="true"></span>
                          <button type="button" class="fl-panel-tab" data-fl-select aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`fl-${it.key}-info`}>
                            <span class="fl-panel-tab-icon" set:html={icon(it.icon)} />
                            <span class="fl-panel-tab-name">{it.name}</span>
                          </button>
                          <div class="fl-panel-info" id={`fl-${it.key}-info`}>
                            {it.categories.length > 0 && <p class="fl-kicker">{catNames(it.categories)}</p>}
                            <h3 class="fl-panel-title" id={`fl-${it.key}-h`}>{it.name}</h3>
                            {it.summary && <p class="fl-panel-text">{it.summary}</p>}
                            {it.location && <p class="fl-panel-meta"><Fragment set:html={icon('pin')} />{it.location}</p>}
                            {(it.hasDetails || it.href) && (
                              <div class="fl-actions">
                                {it.hasDetails && <button type="button" class="fl-btn fl-btn--gold" data-fl-open={it.key}>{expandLabel}<Fragment set:html={icon('arrow')} /></button>}
                                {it.href && <a class="fl-btn fl-btn--line" href={it.href}>Visit page<Fragment set:html={icon('arrow')} /></a>}
                              </div>
                            )}
                          </div>
                        </article>
                      ))}
                    </div>
                    <p class="fl-note" data-fl-none hidden>{page.messages.no_filter_results}</p>
                  </>
                ) : (
                  <p class="fl-note">{page.messages.no_facilities}</p>
                )}
              </div>
            )}

            {/* ---------- Gallery ---------- */}
            {s.kind === 'gallery' && (
              gallery.length > 0 ? (
                <div class="fl-gallery" data-fl-gallery>
                  {s.show_filters && galleryCategories.length > 1 && (
                    <div class="fl-chips fl-chips--wrap" role="group" aria-label="Filter photographs">
                      <button type="button" class="fl-chip is-on" data-fl-gfilter="" aria-pressed="true">All</button>
                      {galleryCategories.map((c) => <button type="button" class="fl-chip" data-fl-gfilter={c.slug} aria-pressed="false">{c.name}</button>)}
                    </div>
                  )}
                  <ul class="fl-masonry" data-fl-group>
                    {gallery.slice(0, s.limit).map((g, i) => (
                      <li class="fl-shot-item" data-cats={g.category?.slug ?? ''} data-fl-reveal style={`--d:${(i % 3) * 90}ms`}>
                        <button type="button" class="fl-shot" data-cf-lightbox={g.image.url} data-cf-caption={g.caption ?? g.image.alt}>
                          <img src={g.image.url} alt={g.image.alt} loading="lazy" decoding="async" width={g.image.width ?? undefined} height={g.image.height ?? undefined} />
                          {g.caption && <span class="fl-shot-cap">{g.caption}</span>}
                          <span class="cf-sr">View larger</span>
                        </button>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : (
                <p class="fl-note">{page.messages.no_gallery}</p>
              )
            )}

            {/* ---------- Links ---------- */}
            {s.kind === 'links' && (
              <ul class="fl-links" style={`--want:${s.columns === 'three' ? 3 : 4}`} role="list">
                {quickLinks.map((l, i) => (
                  <li class="fl-link-item" data-fl-reveal style={`--d:${(i % 4) * 70}ms`}>
                    <a class="fl-link" href={l.url} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>
                      <span class="fl-link-fill" aria-hidden="true"></span>
                      <span class="fl-link-icon" set:html={icon(l.icon)} />
                      <span class="fl-link-text"><strong>{l.label}</strong>{l.description && <span>{l.description}</span>}</span>
                      <span class="fl-link-go" aria-hidden="true" set:html={icon(l.external ? 'external' : 'arrow')} />
                      {l.external && <span class="cf-sr">(opens in a new tab)</span>}
                    </a>
                  </li>
                ))}
              </ul>
            )}

            {/* ---------- Custom text / picture ---------- */}
            {(s.kind === 'rich-text' || s.kind === 'image-text') && (
              <div class:list={['fl-split', { 'fl-split--left': s.layout === 'image_left', 'fl-split--text': !s.image }]} data-fl-reveal>
                <div class="cf-prose" set:html={s.body_html} />
                {s.image && <img src={s.image.url} alt={s.image.alt} loading="lazy" />}
              </div>
            )}

            {s.kind === 'cta' && (
              <div class="fl-cta" data-fl-reveal>
                <div>
                  {s.heading && <h2 class="fl-h2 fl-h2--light" id={`${id}-h`}>{s.heading}</h2>}
                  {s.intro && <p class="fl-lede fl-lede--light">{s.intro}</p>}
                </div>
                {s.button && <a class="fl-btn fl-btn--gold" href={s.button.url} {...linkAttrs(s.button.url)}>{s.button.label}<Fragment set:html={icon('arrow')} /></a>}
              </div>
            )}
          </div>
        </section>
      );
    })}

    <!-- ============================ DETAILS DIALOG ============================ -->
    {items.filter((i) => i.hasDetails).map((it) => (
      <template id={`fl-t-${it.key}`}>
        <ShowcaseDetail item={it} />
      </template>
    ))}
    <div class="fl-dialog" data-fl-dialog hidden role="dialog" aria-modal="true" aria-labelledby="fl-dialog-title">
      <div class="fl-dialog-card">
        <button type="button" class="fl-dialog-close" data-fl-dialog-close aria-label="Close details"><Fragment set:html={icon('close')} /></button>
        <div class="fl-dialog-head" data-fl-dialog-head>
          <img alt="" data-fl-dialog-img hidden />
          <div class="fl-dialog-titles">
            <p class="fl-kicker" data-fl-dialog-kicker></p>
            <h2 id="fl-dialog-title" data-fl-dialog-title tabindex="-1"></h2>
          </div>
        </div>
        <div class="fl-dialog-body" data-fl-dialog-body></div>
      </div>
    </div>

    <!-- ============================ PHOTO VIEWER ============================ -->
    <div class="cf-lightbox fl-lightbox" data-cf-box hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
      <button type="button" class="cf-lightbox-btn cf-lightbox-close" data-cf-box-close aria-label="Close photo"><Fragment set:html={icon('close')} /></button>
      <button type="button" class="cf-lightbox-btn cf-lightbox-prev" data-cf-box-prev aria-label="Previous photo"><Fragment set:html={icon('back')} /></button>
      <figure><img alt="" /><figcaption></figcaption></figure>
      <button type="button" class="cf-lightbox-btn cf-lightbox-next" data-cf-box-next aria-label="Next photo"><Fragment set:html={icon('chevron')} /></button>
    </div>
  </div>
</Layout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-fl]');
    if (!root) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    root.classList.add('is-ready');

    // The filter bar sticks just under the site header.
    const masthead = document.querySelector('.masthead');
    const setTop = () => root.style.setProperty('--fl-top', `${masthead ? masthead.getBoundingClientRect().height : 0}px`);
    setTop();
    addEventListener('resize', setTop, { passive: true });

    // ---- Reveals ----
    if (!reduce && 'IntersectionObserver' in window) {
      root.classList.add('fl-anim');
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
      root.querySelectorAll('[data-fl-reveal]').forEach((el) => io.observe(el));
    }

    // ---- Hero photographs cross-fade, with the caption and dots in step ----
    const slides = Array.from(root.querySelectorAll('[data-fl-slide]'));
    const dots = Array.from(root.querySelectorAll('[data-fl-dot]'));
    const cap = root.querySelector('[data-fl-cap]');
    let slide = 0, slideTimer = null;
    const showSlide = (n) => {
      slide = (n + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle('is-active', i === slide));
      dots.forEach((d, i) => { d.classList.toggle('is-active', i === slide); d.setAttribute('aria-pressed', String(i === slide)); });
      if (cap) cap.textContent = slides[slide].dataset.caption || '';
    };
    const startSlides = () => { if (slides.length > 1 && !reduce) { clearInterval(slideTimer); slideTimer = setInterval(() => showSlide(slide + 1), 7000); } };
    dots.forEach((d) => d.addEventListener('click', () => { showSlide(Number(d.dataset.flDot)); startSlides(); }));
    startSlides();

    // ---- Facility rail: one panel open, the rest folded; filter; autoplay ----
    const rail = root.querySelector('[data-fl-rail]');
    const panels = rail ? Array.from(rail.querySelectorAll('[data-fl-panel]')) : [];
    const count = root.querySelector('[data-fl-count]');
    const none = root.querySelector('[data-fl-none]');
    let filter = '';
    let userTouched = false;
    const visible = () => panels.filter((p) => !p.hidden);
    const activate = (panel, fromUser) => {
      if (!panel) return;
      if (fromUser) userTouched = true;
      panels.forEach((p) => {
        const on = p === panel;
        p.classList.toggle('is-active', on);
        p.querySelector('[data-fl-select]')?.setAttribute('aria-expanded', String(on));
        const info = p.querySelector('.fl-panel-info');
        if (info) { if (on) info.removeAttribute('inert'); else info.setAttribute('inert', ''); }
      });
    };
    panels.forEach((p) => {
      const info = p.querySelector('.fl-panel-info');
      if (info && !p.classList.contains('is-active')) info.setAttribute('inert', '');
      p.querySelector('[data-fl-select]')?.addEventListener('click', () => activate(p, true));
      if (canHover) {
        let t = null;
        p.addEventListener('pointerenter', () => { t = setTimeout(() => activate(p, true), 110); });
        p.addEventListener('pointerleave', () => clearTimeout(t));
      }
    });
    const applyFilter = (slug, scroll) => {
      filter = slug || '';
      let n = 0;
      panels.forEach((p) => {
        const match = !filter || (p.dataset.cats || '').split(' ').includes(filter);
        p.hidden = !match;
        if (match) n++;
      });
      root.querySelectorAll('[data-fl-filter]').forEach((c) => { const on = (c.dataset.flFilter || '') === filter; c.classList.toggle('is-on', on); c.setAttribute('aria-pressed', String(on)); });
      if (count) count.textContent = `${n} ${n === 1 ? 'facility' : 'facilities'}`;
      if (none) none.hidden = n > 0;
      const first = visible()[0];
      if (first && !visible().includes(rail.querySelector('.is-active'))) activate(first, false);
      if (scroll) root.querySelector('[data-fl-explorer]')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    };
    root.querySelectorAll('[data-fl-filter]').forEach((c) => c.addEventListener('click', () => applyFilter(c.dataset.flFilter, false)));
    root.querySelectorAll('[data-fl-cat]').forEach((a) => a.addEventListener('click', (e) => {
      e.preventDefault();
      applyFilter(a.dataset.flCat, true);
      history.replaceState(null, '', `?category=${a.dataset.flCat}#${root.querySelector('[data-fl-explorer]')?.closest('section')?.id || ''}`);
    }));
    const startAuto = () => {
      if (reduce || !rail || panels.length < 2) return;
      setInterval(() => {
        if (userTouched || document.hidden || rail.matches(':hover, :focus-within')) return;
        const vis = visible();
        if (vis.length < 2) return;
        const r = rail.getBoundingClientRect();
        if (r.bottom < 0 || r.top > innerHeight) return;
        activate(vis[(vis.indexOf(rail.querySelector('.is-active')) + 1) % vis.length], false);
      }, 5200);
    };
    startAuto();

    // ---- Links to a facility or a type: #library, #laboratories, ?category=… ----
    const explorer = root.querySelector('[data-fl-explorer]');
    const goToPanel = (key) => {
      const p = panels.find((x) => x.dataset.key === key);
      if (!p) return false;
      if (p.hidden) applyFilter('', false);
      activate(p, true);
      (explorer || p).scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      return true;
    };
    root.querySelectorAll('[data-fl-jump]').forEach((a) => a.addEventListener('click', (e) => {
      const href = a.getAttribute('href') || '';
      const [path, hash] = href.split('#');
      const cat = new URLSearchParams((path || '').split('?')[1] || '').get('category');
      if (cat) { e.preventDefault(); applyFilter(cat, true); return; }
      if (hash && goToPanel(hash)) e.preventDefault();
    }));
    const fromAddress = () => {
      const cat = new URLSearchParams(location.search).get('category');
      if (cat && root.querySelector(`[data-fl-filter="${CSS.escape(cat)}"]`)) applyFilter(cat, false);
      const hash = decodeURIComponent(location.hash.slice(1));
      if (hash && panels.some((p) => p.dataset.key === hash)) setTimeout(() => goToPanel(hash), 60);
    };
    fromAddress();

    // ---- Details dialog ----
    const dlg = root.querySelector('[data-fl-dialog]');
    const dBody = dlg.querySelector('[data-fl-dialog-body]');
    const dTitle = dlg.querySelector('[data-fl-dialog-title]');
    const dKick = dlg.querySelector('[data-fl-dialog-kicker]');
    const dImg = dlg.querySelector('[data-fl-dialog-img]');
    let dOpener = null;
    const dKey = (e) => { if (e.key === 'Escape' && box.hidden) closeDialog(); };
    const openDialog = (key, opener) => {
      const panel = panels.find((p) => p.dataset.key === key);
      const tpl = document.getElementById(`fl-t-${key}`);
      if (!panel || !tpl) return;
      dOpener = opener;
      dTitle.textContent = panel.querySelector('.fl-panel-title')?.textContent || '';
      dKick.textContent = panel.querySelector('.fl-kicker')?.textContent || '';
      const img = panel.querySelector('.fl-panel-img');
      dImg.hidden = !img;
      if (img) { dImg.src = img.currentSrc || img.src; dImg.alt = img.alt || ''; }
      dBody.replaceChildren(tpl.content.cloneNode(true));
      dlg.hidden = false;
      document.documentElement.classList.add('fl-lock');
      dlg.querySelector('[data-fl-dialog-close]').focus();
      document.addEventListener('keydown', dKey);
    };
    const closeDialog = () => {
      dlg.hidden = true;
      document.documentElement.classList.remove('fl-lock');
      document.removeEventListener('keydown', dKey);
      dOpener?.focus();
    };
    root.querySelectorAll('[data-fl-open]').forEach((b) => b.addEventListener('click', () => openDialog(b.dataset.flOpen, b)));
    dlg.querySelector('[data-fl-dialog-close]').addEventListener('click', closeDialog);
    dlg.addEventListener('click', (e) => { if (e.target === dlg) closeDialog(); });

    // ---- Gallery filter ----
    const gal = root.querySelector('[data-fl-gallery]');
    gal?.querySelectorAll('[data-fl-gfilter]').forEach((b) => b.addEventListener('click', () => {
      const c = b.dataset.flGfilter;
      gal.querySelectorAll('[data-fl-gfilter]').forEach((x) => { x.classList.toggle('is-on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
      gal.querySelectorAll('.fl-shot-item').forEach((li) => { li.hidden = !!c && li.dataset.cats !== c; });
    }));

    // ---- Photo viewer with previous / next ----
    const box = root.querySelector('[data-cf-box]');
    const bImg = box.querySelector('img');
    const bCap = box.querySelector('figcaption');
    let group = [], index = 0, opener = null;
    const show = () => { const s = group[index]; bImg.src = s.dataset.cfLightbox; bImg.alt = s.dataset.cfCaption || ''; bCap.textContent = s.dataset.cfCaption || ''; };
    const step = (d) => { index = (index + d + group.length) % group.length; show(); };
    const bKey = (e) => { if (e.key === 'Escape') closeBox(); if (e.key === 'ArrowRight') step(1); if (e.key === 'ArrowLeft') step(-1); };
    const closeBox = () => { box.hidden = true; document.removeEventListener('keydown', bKey); opener?.focus(); };
    root.addEventListener('click', (e) => {
      const shot = e.target.closest('[data-cf-lightbox]');
      if (!shot) return;
      const scope = shot.closest('[data-fl-group], .cf-detail-photos') || shot.parentElement;
      group = Array.from(scope.querySelectorAll('[data-cf-lightbox]')).filter((s) => !s.closest('[hidden]'));
      index = Math.max(0, group.indexOf(shot));
      opener = shot;
      show();
      box.hidden = false;
      box.querySelector('[data-cf-box-close]').focus();
      document.addEventListener('keydown', bKey);
      const single = group.length < 2;
      box.querySelector('[data-cf-box-prev]').hidden = single;
      box.querySelector('[data-cf-box-next]').hidden = single;
    });
    box.querySelector('[data-cf-box-close]').addEventListener('click', closeBox);
    box.querySelector('[data-cf-box-prev]').addEventListener('click', () => step(-1));
    box.querySelector('[data-cf-box-next]').addEventListener('click', () => step(1));
    box.addEventListener('click', (e) => { if (e.target === box) closeBox(); });
  })();
</script>
