                      </div>
                      {e.image_url && <img class="al-event-img" src={e.image_url} alt="" loading="lazy" />}
                      <div class="al-event-body">
                        {tab.id === 'upcoming' && i === 0 && <p class="al-tag al-tag--gold">Next up</p>}
                        <h3 class="al-event-title">{e.title}</h3>
                        <p class="al-event-meta">
                          <span set:html={icon('calendar', 16)} />{formatDate(e.starts_at)}{tab.id === 'upcoming' && `, ${formatTime(e.starts_at)}`}
