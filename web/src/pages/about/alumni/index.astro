---
// Alumni — the Sherubtse alumni community page. Every word comes from
// "Alumni – Page" in Strapi; stories, events, chapters, achievements and
// gallery come from their own collections and only appear when there is
// real, published content. The three forms (story submission,
// registration, newsletter) post to Strapi's create-only public endpoints,
// which are guarded server-side (cms/src/policies/public-form-guard.ts):
// stories always land as unpublished drafts for the Alumni Office to review.
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/alumni-page.css';
import {
  getAlumniSetting,
  getAlumniCopy,
  getDistinguishedAlumni,
  getAlumniStories,
  getAlumniCount,
  getAlumniEvents,
  getAlumniChapters,
  getAlumniChapterCount,
  getAlumniAchievements,
  getAlumniGallery,
  ALUMNI_CATEGORY_LABELS,
  ACHIEVEMENT_CATEGORY_LABELS,
  GALLERY_CATEGORY_LABELS,
} from '../../../lib/content/alumni';

const [copy, settings, distinguished, stories, alumniCount, events, chapters, chapterCount, achievements, gallery] =
  await Promise.all([
    getAlumniCopy(),
    getAlumniSetting(),
    getDistinguishedAlumni(),
    getAlumniStories(60),
    getAlumniCount(),
    getAlumniEvents(),
    getAlumniChapters(),
    getAlumniChapterCount(),
    getAlumniAchievements(),
    getAlumniGallery(),
  ]);

const upcomingEvents = events.filter((e) => !e.is_past);
const pastEvents = events.filter((e) => e.is_past).reverse();
const L = copy.labels;

// Real figures only — no "+" padding, no invented totals.
const totalAlumni = settings.total_alumni_override ?? alumniCount;
const storyCount = stories.length + distinguished.length;
const stats = [
  { key: 'alumni', label: L.total_alumni, value: totalAlumni, icon: 'people' },
  settings.years_of_legacy ? { key: 'years', label: L.years, value: settings.years_of_legacy, icon: 'cap' } : null,
  settings.countries_represented ? { key: 'countries', label: L.countries, value: settings.countries_represented, icon: 'globe' } : null,
  { key: 'stories', label: L.stories, value: storyCount, icon: 'book' },
].filter((s): s is { key: string; label: string; value: number; icon: string } => !!s);

const featuredStory = stories[0] ?? null;
const moreStories = stories.slice(1);
const storyCategories = Array.from(new Set(stories.map((s) => s.category).filter((c): c is string => !!c)));
const INITIAL_STORIES = 6;

const INTERESTS = ['Mentorship', 'Guest Lectures', 'Career Support', 'Internship Opportunities', 'Alumni Events', 'Volunteering', 'Supporting Students'];
const COUNTRIES = [
  'Bhutan', 'India', 'Nepal', 'Bangladesh', 'Sri Lanka', 'Maldives', 'Thailand', 'Singapore', 'Malaysia', 'Japan',
  'South Korea', 'China', 'Australia', 'New Zealand', 'United States', 'Canada', 'United Kingdom', 'Ireland',
  'Germany', 'Netherlands', 'Switzerland', 'Austria', 'Denmark', 'Norway', 'Sweden', 'Finland', 'France', 'Belgium',
  'Italy', 'Spain', 'United Arab Emirates', 'Qatar', 'Kuwait', 'Saudi Arabia', 'Oman', 'Philippines', 'Indonesia', 'Vietnam',
];
const INDUSTRIES = [
  'Civil Service', 'Education', 'Health', 'Banking & Finance', 'Information Technology', 'Agriculture & Livestock',
  'Tourism & Hospitality', 'Energy & Hydropower', 'Research & Academia', 'Media & Communications', 'NGO / Civil Society',
  'Private Business', 'Armed Forces & Police', 'Law & Justice', 'Engineering & Construction', 'Other',
];

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}
function formatTime(iso: string) {
  return new Date(iso).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
}
function initials(name: string) {
  return name
    .replace(/^Dasho\s+|^Dr\.?\s+/gi, '')
    .split(' ')
    .filter(Boolean)
    .map((w) => w[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
}
const pad = (n: number) => String(n).padStart(2, '0');

const ICONS: Record<string, string> = {
  cap: '<path d="M12 3 2 8l10 5 10-5-10-5z" /><path d="M6 10.5v5.5c0 1.5 3 3 6 3s6-1.5 6-3v-5.5" />',
  people: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />',
  shield: '<path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z" /><path d="M9 12l2 2 4-4" />',
  compass: '<circle cx="12" cy="12" r="10" /><path d="M16.24 7.76l-2.12 6.36-6.36 2.12 2.12-6.36 6.36-2.12z" />',
  book: '<path d="M3 5.5c2.7-1 5.7-1 9 1 3.3-2 6.3-2 9-1V19c-2.7-1-5.7-1-9 1-3.3-2-6.3-2-9-1V5.5z" /><path d="M12 6.5V20" />',
  star: '<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z" />',
  heart: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z" />',
  globe: '<circle cx="12" cy="12" r="10" /><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20" />',
  calendar: '<rect x="3" y="5" width="18" height="16" /><path d="M8 3v4M16 3v4M3 10h18" />',
  pin: '<path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" />',
  pen: '<path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />',
  mail: '<rect x="2" y="4" width="20" height="16" /><path d="m2 7 10 6 10-6" />',
  phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.8.7a2 2 0 0 1 1.7 2z" />',
  person: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" />',
  trophy: '<path d="M8 4h8v6a4 4 0 0 1-8 0z" /><path d="M8 5H4v2a4 4 0 0 0 4 4M16 5h4v2a4 4 0 0 1-4 4" /><path d="M12 14v4M8 21h8" />',
};
const CONTACT_ICON: Record<string, string> = { phone: 'phone', email: 'mail', person: 'person', address: 'pin' };
const icon = (name: string, size = 24) =>
  `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name] ?? ICONS.star}</svg>`;

const galleryCategories = Array.from(new Set(gallery.map((g) => g.category)));
const heroIsVideo = !!settings.hero_background_url && /\.(mp4|webm|mov)$/i.test(settings.hero_background_url);
---

<Layout title="Alumni" description={copy.seo_description ?? undefined}>
  <div class="al">
    <!-- ====================== 1. HERO ====================== -->
    <section class="al-hero" aria-labelledby="al-hero-title">
      <div class="al-hero-bg" aria-hidden="true">
        {settings.hero_background_url && (heroIsVideo ? (
          <video class="al-hero-media" src={settings.hero_background_url} autoplay muted loop playsinline data-parallax="0.15"></video>
        ) : (
          <img class="al-hero-media" src={settings.hero_background_url} alt="" data-parallax="0.15" />
        ))}
        <svg class="al-hero-rings" viewBox="0 0 600 600">
          <circle pathLength="1" cx="300" cy="300" r="290" />
          <circle pathLength="1" cx="300" cy="300" r="220" />
          <circle pathLength="1" cx="300" cy="300" r="150" />
          <circle pathLength="1" cx="300" cy="300" r="80" />
          <path pathLength="1" d="M300 10v580M10 300h580" />
        </svg>
        <svg class="al-hero-range" data-parallax="0.12" viewBox="0 0 1600 300" preserveAspectRatio="xMidYMax slice">
          <path d="M0 300V200l150-60 120 40 170-110 150 90 120-40 200 120 150-80 170 90 140-50 130 60v140z" />
        </svg>
      </div>

      <div class="wrap al-wide al-hero-inner">
        <nav class="al-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/about">About</a> › <span aria-current="page">Alumni</span></nav>
        {copy.hero.eyebrow && <p class="al-eyebrow al-hero-eyebrow">{copy.hero.eyebrow}</p>}
        <h1 id="al-hero-title" class="al-hero-title">{copy.hero.heading}</h1>
        {copy.hero.intro && <p class="al-hero-intro">{copy.hero.intro}</p>}
        {copy.hero.tagline && (
          <blockquote class="al-hero-quote">
            <span aria-hidden="true">&#8220;</span>{copy.hero.tagline.replace(/^[“"]|[”"]$/g, '')}<span aria-hidden="true">&#8221;</span>
          </blockquote>
        )}
        <div class="al-actions">
          {copy.hero.button_label && <a href="#register" class="al-btn al-btn--gold" data-al-jump>{copy.hero.button_label}</a>}
          {copy.hero.secondary_button_label && <a href="#stories" class="al-btn al-btn--ghost" data-al-jump>{copy.hero.secondary_button_label}</a>}
        </div>
      </div>
    </section>

    <!-- ====================== 2. STATISTICS ====================== -->
    {settings.show_statistics && (
      <section class="al-stats-wrap" aria-label="Our growing community">
        <div class="wrap al-wide">
          <dl class="al-stats" data-al-reveal>
            {stats.map((s) => (
              <div class="al-stat">
                <span class="al-stat-icon" set:html={icon(s.icon, 22)} />
                <dt class="al-stat-label">{s.label}</dt>
                <dd class="al-stat-value" data-count={s.value}>{s.value.toLocaleString('en-GB')}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    <!-- ====================== 3. ABOUT ====================== -->
    <section id="about" class="al-section al-about" aria-labelledby="al-about-h">
      <div class="wrap al-wide al-about-grid">
        <div class="al-about-visual" data-al-reveal aria-hidden="true">
          <svg viewBox="0 0 400 400" class="al-community">
            <g class="al-community-lines">
              <path pathLength="1" d="M200 60L330 140L330 280L200 340L70 280L70 140Z" />
              <path pathLength="1" d="M200 60L200 340M70 140L330 280M330 140L70 280" />
            </g>
            <circle class="al-node al-node--hub" cx="200" cy="200" r="34" />
            {[[200, 60], [330, 140], [330, 280], [200, 340], [70, 280], [70, 140]].map(([x, y], i) => (
              <g class="al-node-group" style={`--d:${300 + i * 120}ms`}>
                <circle class="al-node" cx={x} cy={y} r="22" />
                <circle class="al-node-head" cx={x} cy={y - 6} r="6" />
                <path class="al-node-body" d={`M${x - 10} ${y + 12}a10 10 0 0 1 20 0`} />
              </g>
            ))}
            <text x="200" y="207" class="al-community-label">S</text>
          </svg>
        </div>
        <div class="al-about-copy" data-al-reveal style="--d:120ms">
          {copy.about.eyebrow && <p class="al-eyebrow">{copy.about.eyebrow}</p>}
          <h2 id="al-about-h" class="al-h2" tabindex="-1">{copy.about.heading}</h2>
          {copy.about.intro && <p class="al-lede">{copy.about.intro}</p>}
          {copy.about.paragraphs.map((p) => <p class="al-body">{p}</p>)}
          {copy.about.tagline && <p class="al-highlight">{copy.about.tagline}</p>}
          {copy.about.button_label && <a href="#register" class="al-btn al-btn--navy" data-al-jump>{copy.about.button_label}</a>}
        </div>
      </div>
    </section>

    <!-- ====================== 4. WHY ALUMNI MATTERS ====================== -->
    {copy.matters_cards.length > 0 && (
      <section id="why" class="al-section al-why" aria-labelledby="al-why-h">
        <div class="wrap al-wide">
          <div class="al-head" data-al-reveal>
            {copy.matters.eyebrow && <p class="al-eyebrow">{copy.matters.eyebrow}</p>}
            <h2 id="al-why-h" class="al-h2">{copy.matters.heading}</h2>
          </div>
          <div class="al-journey-wrap" data-al-reveal>
          <svg class="al-journey-line" viewBox="0 0 1000 20" preserveAspectRatio="none" aria-hidden="true">
            <path class="al-draw" pathLength="1" d="M0 10H1000" />
          </svg>
          <ol class="al-journey" role="list">
            {copy.matters_cards.map((card, i) => (
              <li class={`al-why-card al-why-card--${(i % 4) + 1}`} data-al-reveal style={`--d:${i * 130}ms`}>
                <span class="al-why-num">{pad(i + 1)}</span>
                <span class="al-why-icon" set:html={icon(card.icon, 30)} />
                <h3 class="al-why-title">{card.title}</h3>
                <p class="al-why-text">{card.text}</p>
              </li>
            ))}
          </ol>
          </div>
        </div>
      </section>
    )}

    <!-- ====================== 5. DISTINGUISHED ALUMNI (when published) ====================== -->
    {distinguished.length > 0 && (
      <section class="al-section al-distinguished" aria-labelledby="al-dist-h">
        <div class="wrap al-wide">
          <div class="al-head" data-al-reveal>
            {copy.distinguished.eyebrow && <p class="al-eyebrow">{copy.distinguished.eyebrow}</p>}
            <h2 id="al-dist-h" class="al-h2">{copy.distinguished.heading}</h2>
          </div>
          <div class="al-dist-grid">
            {distinguished.map((a, i) => (
              <article class="al-dist-card" data-al-reveal style={`--d:${i * 100}ms`}>
                {a.photo_url ? <img src={a.photo_url} alt={`Portrait of ${a.full_name}`} loading="lazy" class="al-dist-photo" /> : <span class="al-dist-photo al-initials" aria-hidden="true">{initials(a.full_name)}</span>}
                <div class="al-dist-body">
                  <h3 class="al-dist-name">{a.full_name}</h3>
                  {a.current_role && <p class="al-dist-role">{a.current_role}</p>}
                  {a.excerpt && <p class="al-dist-quote">“{a.excerpt}”</p>}
                  <a href={`/about/alumni/${a.slug}`} class="al-link">Read story <span aria-hidden="true">→</span></a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ====================== 6. ALUMNI STORIES ====================== -->
    <section id="stories" class="al-section al-stories" aria-labelledby="al-stories-h">
      <div class="wrap al-wide">
        <div class="al-head al-head--split" data-al-reveal>
          <div>
            {copy.stories.eyebrow && <p class="al-eyebrow">{copy.stories.eyebrow}</p>}
            <h2 id="al-stories-h" class="al-h2" tabindex="-1">{copy.stories.heading}</h2>
            {copy.stories.intro && <p class="al-body al-head-intro">{copy.stories.intro}</p>}
          </div>
          <a href="#share" class="al-btn al-btn--navy" data-al-jump>
            <span set:html={icon('pen', 18)} /> Share Your Story
          </a>
        </div>

        {stories.length > 0 ? (
          <>
            {storyCategories.length > 1 && (
              <div class="al-filters" role="group" aria-label="Filter stories by category" data-story-filters>
                <button type="button" aria-pressed="true" data-filter="all">All</button>
                {storyCategories.map((c) => (
                  <button type="button" aria-pressed="false" data-filter={c}>{ALUMNI_CATEGORY_LABELS[c] ?? c}</button>
                ))}
              </div>
            )}

            <div class="al-story-layout">
              {featuredStory && (
                <article class="al-story al-story--featured" data-category={featuredStory.category ?? ''} data-al-reveal>
                  <div class="al-story-media">
                    {featuredStory.photo_url ? <img src={featuredStory.photo_url} alt="" loading="lazy" /> : <span class="al-initials al-initials--xl" aria-hidden="true">{initials(featuredStory.full_name)}</span>}
                  </div>
                  <div class="al-story-body">
                    {featuredStory.category && <p class="al-tag">{ALUMNI_CATEGORY_LABELS[featuredStory.category] ?? featuredStory.category}</p>}
                    <h3 class="al-story-title al-story-title--lg">{featuredStory.article_title ?? featuredStory.full_name}</h3>
                    {featuredStory.excerpt && <p class="al-story-excerpt">{featuredStory.excerpt}</p>}
                    <p class="al-story-meta">
                      <strong>{featuredStory.full_name}</strong>
                      {[featuredStory.graduation_year && `Class of ${featuredStory.graduation_year}`, featuredStory.programme, featuredStory.current_role].filter(Boolean).map((m) => <span>{m}</span>)}
                    </p>
                    <a href={`/about/alumni/${featuredStory.slug}`} class="al-link">Read story <span aria-hidden="true">→</span></a>
                  </div>
                </article>
              )}

              {moreStories.length > 0 && (
                <div class="al-story-grid" data-story-grid>
                  {moreStories.map((s, i) => (
                    <article class={`al-story${i >= INITIAL_STORIES ? ' is-hidden-more' : ''}`} data-category={s.category ?? ''} data-al-reveal style={`--d:${(i % 3) * 100}ms`}>
                      <div class="al-story-media al-story-media--sm">
                        {s.photo_url ? <img src={s.photo_url} alt="" loading="lazy" /> : <span class="al-initials" aria-hidden="true">{initials(s.full_name)}</span>}
                      </div>
                      <div class="al-story-body">
                        {s.category && <p class="al-tag">{ALUMNI_CATEGORY_LABELS[s.category] ?? s.category}</p>}
                        <h3 class="al-story-title">{s.article_title ?? s.full_name}</h3>
                        {s.excerpt && <p class="al-story-excerpt">{s.excerpt}</p>}
                        <p class="al-story-meta">
                          <strong>{s.full_name}</strong>
                          {[s.graduation_year && `Class of ${s.graduation_year}`, s.programme].filter(Boolean).map((m) => <span>{m}</span>)}
                        </p>
                        <a href={`/about/alumni/${s.slug}`} class="al-link">Read story <span aria-hidden="true">→</span></a>
                      </div>
                    </article>
                  ))}
                </div>
              )}
            </div>
            <p class="al-filter-empty" data-story-empty hidden>No stories in this category yet.</p>
            {moreStories.length > INITIAL_STORIES && (
              <div class="al-center"><button type="button" class="al-btn al-btn--outline" data-story-more>Load more stories</button></div>
            )}
          </>
        ) : (
          <div class="al-empty" data-al-reveal>
            <svg class="al-empty-art" viewBox="0 0 120 120" aria-hidden="true">
              <rect x="22" y="18" width="62" height="80" />
              <path d="M34 36h38M34 48h38M34 60h26" />
              <path class="al-empty-pen" d="M78 92l22-22 8 8-22 22-10 2z" />
            </svg>
            <div>
              <p class="al-empty-title">{copy.texts.stories_empty}</p>
              <p class="al-body">Be the first to tell your Sherubtse story — your journey could inspire the students walking the same paths today.</p>
              <a href="#share" class="al-btn al-btn--navy" data-al-jump>Share Your Story</a>
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- ====================== 7. SUBMIT YOUR STORY ====================== -->
    <section id="share" class="al-section al-share" aria-labelledby="al-share-h">
      <div class="wrap al-wide al-form-layout">
        <div class="al-form-aside" data-al-reveal>
          {copy.story_form.eyebrow && <p class="al-eyebrow">{copy.story_form.eyebrow}</p>}
          <h2 id="al-share-h" class="al-h2" tabindex="-1">{copy.story_form.heading}</h2>
          {copy.story_form.intro && <p class="al-note"><span set:html={icon('shield', 20)} />{copy.story_form.intro}</p>}
        </div>

        <form class="al-form" id="storyForm" novalidate data-al-reveal style="--d:120ms">
          <fieldset class="al-fieldset">
            <legend>About you</legend>
            <div class="al-grid">
              <div class="al-field">
                <label for="story-name">Full Name <span class="al-req" aria-hidden="true">*</span></label>
                <input type="text" id="story-name" name="full_name" required autocomplete="name" />
              </div>
              <div class="al-field">
                <label for="story-email">Email <span class="al-req" aria-hidden="true">*</span></label>
                <input type="email" id="story-email" name="email" required autocomplete="email" />
              </div>
              <div class="al-field">
                <label for="story-year">Graduation Year</label>
                <input type="number" id="story-year" name="graduation_year" min="1968" max="2100" inputmode="numeric" />
              </div>
              <div class="al-field">
                <label for="story-programme">Programme</label>
                <input type="text" id="story-programme" name="programme" />
              </div>
              <div class="al-field">
                <label for="story-role">Current Designation</label>
                <input type="text" id="story-role" name="current_role" autocomplete="organization-title" />
              </div>
              <div class="al-field">
                <label for="story-org">Organization</label>
                <input type="text" id="story-org" name="organization" autocomplete="organization" />
              </div>
            </div>
          </fieldset>

          <fieldset class="al-fieldset">
            <legend>Your story</legend>
            <div class="al-grid">
              <div class="al-field al-span-2">
                <label for="story-title">Article Title <span class="al-req" aria-hidden="true">*</span></label>
                <input type="text" id="story-title" name="article_title" required maxlength="200" />
              </div>
              <div class="al-field al-span-2">
                <label for="story-category">Category</label>
                <select id="story-category" name="category">
                  <option value="">Choose a category</option>
                  {Object.entries(ALUMNI_CATEGORY_LABELS).map(([value, label]) => <option value={value}>{label}</option>)}
                </select>
              </div>
              <div class="al-field al-span-2">
                <label for="story-content">Article Content <span class="al-req" aria-hidden="true">*</span></label>
                <textarea id="story-content" name="story" required rows="9" aria-describedby="story-content-hint"></textarea>
                <p class="al-hint" id="story-content-hint">Write as much as you like — separate paragraphs with a blank line.</p>
              </div>
            </div>
          </fieldset>

          <div class="al-hp" aria-hidden="true">
            <label for="story-hp">Leave this field empty</label>
            <input type="text" id="story-hp" name="hp_field" tabindex="-1" autocomplete="off" />
          </div>

          <div class="al-consent-wrap">
