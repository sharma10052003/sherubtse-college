---
// Alumni overview. Short on purpose: the welcome, the figures and a card for each
// topic; every topic has its own page under /about/alumni/. Every word comes from
// "Alumni – Page" in Strapi (section copy, the figures, and Labels for the topic
// cards); stories, events and chapters appear only when there is published
// content. The newsletter form posts to Strapi's create-only public endpoint.
import AlumniShell from '../../../components/alumni/AlumniShell.astro';
import {
  getAlumniSetting,
  getAlumniCopy,
  getDistinguishedAlumni,
  getAlumniStories,
  getAlumniCount,
  getAlumniEvents,
  getAlumniChapterCount,
} from '../../../lib/content/alumni';
import { makeAlumniLabels } from '../../../lib/content/alumni-labels';
import { getAlumniSections, icon, CONTACT_ICON } from '../../../lib/content/alumni-ui';

const [copy, settings, distinguished, stories, alumniCount, events, chapterCount, sections] = await Promise.all([
  getAlumniCopy(),
  getAlumniSetting(),
  getDistinguishedAlumni(),
  getAlumniStories(60),
  getAlumniCount(),
  getAlumniEvents(),
  getAlumniChapterCount(),
  getAlumniSections(),
]);
const L = copy.labels;
const t = makeAlumniLabels(copy.page_labels);

// Real figures only — no "+" padding, no invented totals.
const totalAlumni = settings.total_alumni_override ?? alumniCount;
const storyCount = stories.length + distinguished.length;
const upcoming = events.filter((e) => !e.is_past).length;
const stats = [
  { key: 'alumni', label: L.total_alumni, value: totalAlumni, icon: 'people' },
  settings.years_of_legacy ? { key: 'years', label: L.years, value: settings.years_of_legacy, icon: 'cap' } : null,
  settings.countries_represented ? { key: 'countries', label: L.countries, value: settings.countries_represented, icon: 'globe' } : null,
  { key: 'stories', label: L.stories, value: storyCount, icon: 'book' },
].filter((s): s is { key: string; label: string; value: number; icon: string } => !!s);

const count = (key: string, n: number) => (n > 0 ? t(key).replace('{count}', String(n)) : '');
const meta: Record<string, string> = {
  stories: count('meta_stories', storyCount),
  events: count('meta_events', upcoming),
  network: settings.show_chapters ? count('meta_chapters', chapterCount) : '',
};
const hub = sections.filter((s) => s.key !== 'overview');
const heroIsVideo = !!settings.hero_background_url && /\.(mp4|webm|mov)$/i.test(settings.hero_background_url);
---

<AlumniShell title="Alumni" description={copy.seo_description ?? undefined} texts={copy.texts}>
    <!-- ====================== 1. HERO ====================== -->
    <section class="al-hero" aria-labelledby="al-hero-title">
      <div class="al-hero-bg" aria-hidden="true">
        {settings.hero_background_url && (heroIsVideo ? (
          <video class="al-hero-media" src={settings.hero_background_url} autoplay muted loop playsinline data-parallax="0.15"></video>
        ) : (
          <img class="al-hero-media" src={settings.hero_background_url} alt="" data-parallax="0.15" />
        ))}
        <svg class="al-hero-rings" viewBox="0 0 600 600">
          <circle pathLength="1" cx="300" cy="300" r="290" />
          <circle pathLength="1" cx="300" cy="300" r="220" />
          <circle pathLength="1" cx="300" cy="300" r="150" />
          <circle pathLength="1" cx="300" cy="300" r="80" />
          <path pathLength="1" d="M300 10v580M10 300h580" />
        </svg>
        <svg class="al-hero-range" data-parallax="0.12" viewBox="0 0 1600 300" preserveAspectRatio="xMidYMax slice">
          <path d="M0 300V200l150-60 120 40 170-110 150 90 120-40 200 120 150-80 170 90 140-50 130 60v140z" />
        </svg>
      </div>

      <div class="wrap al-wide al-hero-inner">
        <nav class="al-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/about">About</a> › <span aria-current="page">Alumni</span></nav>
        {copy.hero.eyebrow && <p class="al-eyebrow al-hero-eyebrow">{copy.hero.eyebrow}</p>}
        <h1 id="al-hero-title" class="al-hero-title">{copy.hero.heading}</h1>
        {copy.hero.intro && <p class="al-hero-intro">{copy.hero.intro}</p>}
        {copy.hero.tagline && (
          <blockquote class="al-hero-quote">
            <span aria-hidden="true">&#8220;</span>{copy.hero.tagline.replace(/^[“"]|[”"]$/g, '')}<span aria-hidden="true">&#8221;</span>
          </blockquote>
        )}
        <div class="al-actions">
          {copy.hero.button_label && <a href="/about/alumni/register" class="al-btn al-btn--gold">{copy.hero.button_label}</a>}
          {copy.hero.secondary_button_label && <a href="/about/alumni/stories" class="al-btn al-btn--ghost">{copy.hero.secondary_button_label}</a>}
        </div>
      </div>
    </section>

    <!-- ====================== 2. STATISTICS ====================== -->
    {settings.show_statistics && (
      <section class="al-stats-wrap" aria-label="Our growing community">
        <div class="wrap al-wide">
          <dl class="al-stats" data-al-reveal>
            {stats.map((s) => (
              <div class="al-stat">
                <span class="al-stat-icon" set:html={icon(s.icon, 22)} />
                <dt class="al-stat-label">{s.label}</dt>
                <dd class="al-stat-value" data-count={s.value}>{s.value.toLocaleString('en-GB')}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}


    <!-- ====================== TOPICS ====================== -->
    <section id="explore" class="al-section al-hub" aria-labelledby="al-hub-h">
      <div class="wrap al-wide">
        <div class="al-head" data-al-reveal>
          {t('hub_eyebrow') && <p class="al-eyebrow">{t('hub_eyebrow')}</p>}
          <h2 id="al-hub-h" class="al-h2">{t('hub_heading')}</h2>
          {t('hub_intro') && <p class="al-lede">{t('hub_intro')}</p>}
        </div>
        <ul class="al-hub-grid" role="list">
          {hub.map((s, i) => (
            <li class="al-hub-item" data-al-reveal style={`--d:${i * 70}ms`}>
              <a class="al-hub-card" href={s.href}>
                <span class="al-hub-fill" aria-hidden="true"></span>
                <span class="al-hub-top">
                  <span class="al-hub-icon" set:html={icon(s.icon, 28)} />
                  {meta[s.key] && <span class="al-hub-meta">{meta[s.key]}</span>}
                </span>
                <h3 class="al-hub-title">{t(`${s.key}_title`)}</h3>
                <p class="al-hub-text">{t(`${s.key}_text`)}</p>
                <span class="al-hub-go">{t('open_label')} <span set:html={icon('arrow', 18)} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>


    <!-- ====================== 3. ABOUT ====================== -->
    <section id="about" class="al-section al-about" aria-labelledby="al-about-h">
      <div class="wrap al-wide al-about-grid">
        <div class="al-about-visual" data-al-reveal aria-hidden="true">
          <svg viewBox="0 0 400 400" class="al-community">
            <g class="al-community-lines">
              <path pathLength="1" d="M200 60L330 140L330 280L200 340L70 280L70 140Z" />
              <path pathLength="1" d="M200 60L200 340M70 140L330 280M330 140L70 280" />
            </g>
            <circle class="al-node al-node--hub" cx="200" cy="200" r="34" />
            {[[200, 60], [330, 140], [330, 280], [200, 340], [70, 280], [70, 140]].map(([x, y], i) => (
              <g class="al-node-group" style={`--d:${300 + i * 120}ms`}>
                <circle class="al-node" cx={x} cy={y} r="22" />
                <circle class="al-node-head" cx={x} cy={y - 6} r="6" />
                <path class="al-node-body" d={`M${x - 10} ${y + 12}a10 10 0 0 1 20 0`} />
              </g>
            ))}
            <text x="200" y="207" class="al-community-label">S</text>
          </svg>
        </div>
        <div class="al-about-copy" data-al-reveal style="--d:120ms">
          {copy.about.eyebrow && <p class="al-eyebrow">{copy.about.eyebrow}</p>}
          <h2 id="al-about-h" class="al-h2" tabindex="-1">{copy.about.heading}</h2>
          {copy.about.intro && <p class="al-lede">{copy.about.intro}</p>}
          {copy.about.paragraphs.map((p) => <p class="al-body">{p}</p>)}
          {copy.about.tagline && <p class="al-highlight">{copy.about.tagline}</p>}
          {copy.about.button_label && <a href="/about/alumni/register" class="al-btn al-btn--navy">{copy.about.button_label}</a>}
        </div>
      </div>
    </section>

    <!-- ====================== 13. NEWSLETTER ====================== -->
    {settings.show_newsletter && (
      <section id="newsletter" class="al-newsletter" aria-labelledby="al-news-h">
        <div class="wrap al-wide al-newsletter-grid">
          <div data-al-reveal>
            {copy.newsletter.eyebrow && <p class="al-eyebrow al-eyebrow--light">{copy.newsletter.eyebrow}</p>}
            <h2 id="al-news-h" class="al-h2 al-h2--light">{copy.newsletter.heading}</h2>
            {copy.newsletter.intro && <p class="al-lede al-lede--light">{copy.newsletter.intro}</p>}
          </div>
          <form class="al-news-form" id="newsletterForm" novalidate data-al-reveal style="--d:120ms">
            <div class="al-news-row">
              <label for="news-email" class="al-sr">Email address</label>
              <input type="email" id="news-email" name="email" required autocomplete="email" placeholder={copy.texts.newsletter_placeholder || 'Your email address'} />
              <button type="submit" class="al-btn al-btn--gold">{copy.newsletter.button_label || 'Subscribe'}</button>
            </div>
            <div class="al-hp" aria-hidden="true">
              <label for="news-hp">Leave this field empty</label>
              <input type="text" id="news-hp" name="hp_field" tabindex="-1" autocomplete="off" />
            </div>
            <p class="al-news-privacy">We'll only use your email to send the alumni newsletter. Ask the Alumni Office to unsubscribe at any time.</p>
            <div class="al-status al-status--light" role="status" aria-live="polite" data-form-status></div>
          </form>
        </div>
      </section>
    )}

    <!-- ====================== 14. CONTACT ====================== -->
    <section id="contact" class="al-section al-contact" aria-labelledby="al-contact-h">
      <div class="wrap al-wide al-contact-grid">
        <div data-al-reveal>
          {copy.contact.eyebrow && <p class="al-eyebrow">{copy.contact.eyebrow}</p>}
          <h2 id="al-contact-h" class="al-h2">{copy.contact.heading}</h2>
          {copy.contact.intro && <p class="al-lede">{copy.contact.intro}</p>}
        </div>
        <ul class="al-contact-list" role="list" data-al-reveal style="--d:120ms">
          {copy.contact_items.map((item) => (
            <li class="al-contact-item">
              <span class="al-contact-icon" set:html={icon(CONTACT_ICON[item.kind] ?? 'phone', 22)} />
              <span class="al-contact-kind">{item.kind === 'phone' ? 'Telephone' : item.kind === 'email' ? 'Email' : item.kind === 'address' ? 'Address' : 'Office'}</span>
              {item.link ? <a href={item.link} class="al-contact-value">{item.label}</a> : <span class="al-contact-value">{item.label}</span>}
            </li>
          ))}
        </ul>
      </div>
    </section>
</AlumniShell>
