          {[
            { id: 'upcoming', list: upcomingEvents, empty: copy.texts.upcoming_empty },
            { id: 'past', list: pastEvents, empty: copy.texts.past_empty },
          ].map((tab) => (
            <div id={`al-panel-${tab.id}`} role="tabpanel" aria-labelledby={`al-tab-${tab.id}`} class="al-tabpanel" hidden={tab.id === 'past'} tabindex="0">
