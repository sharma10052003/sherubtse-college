---
// History & Heritage. Everything is edited in Strapi:
//  - About – History Page: the hero, founding story, the Third King, Father
//    Mackey, motto / emblem / values, documentary link, brochure, and the
//    small wording (Labels);
//  - About – History Timeline / Legacy / Traditions / Gallery: the lists
//    (add, remove and reorder entries there).
// Design: a slowly drifting hero photograph with a giant founding-year
// watermark, a sticky chapter bar that follows your reading, arch-framed
// portraits, a timeline whose gold line draws as you scroll, a heritage
// gallery with a photo viewer, and a navy motto stage. Rounded and moving
// by the project owner's request. Styles: history.css (.hx).
import Layout from '../../layouts/Layout.astro';
import '../../styles/history.css';
import {
  getHistoryContent,
  getHistoryTimeline,
  getHistoryLegacyItems,
  getHistoryTraditionItems,
  getHistoryGalleryImages,
  GALLERY_CATEGORY_LABELS,
  iconPaths,
} from '../../lib/content/history';
import { getLandingPage } from '../../lib/content/landing';

const settle = <T,>(p: Promise<T>, fallback: T) => p.catch(() => fallback);
const [history, timeline, legacyItems, traditionItems, galleryImages, overview] = await Promise.all([
  getHistoryContent(),
  getHistoryTimeline(),
  getHistoryLegacyItems(),
  getHistoryTraditionItems(),
  getHistoryGalleryImages(),
  settle(getLandingPage('about-overview'), null),
]);

// Wording from About – History Page → Labels (defaults match the Strapi seed).
const DEFAULTS: Record<string, string> = {
  years_label: '{count} years of learning', since_label: 'Since {year}', scroll_label: 'Read our story',
  nav_label: 'Chapters', nav_story: 'Founding', nav_people: 'The founders', nav_timeline: 'Milestones', nav_gallery: 'Gallery',
  nav_motto: 'Motto', nav_legacy: 'Legacy', nav_traditions: 'Traditions', nav_video: 'Documentary',
  story_eyebrow: 'Founding Story', story_heading: 'How It Began',
  king_eyebrow: 'Vision of the Third King', king_heading: 'His Majesty Jigme Dorji Wangchuck', mackey_eyebrow: 'Founding Principal',
  timeline_eyebrow: 'Historical Timeline', timeline_heading: 'Milestones',
  gallery_eyebrow: 'Heritage Gallery', gallery_heading: 'Moments from Our History', gallery_all: 'All', gallery_filter_label: 'Filter photos by category',
  motto_eyebrow: 'Motto & Identity', meaning_label: 'What it means', emblem_label: 'The Emblem', values_label: 'Our Values',
  legacy_eyebrow: 'Legacy & Achievements', legacy_heading: 'Our Legacy',
  traditions_eyebrow: 'Traditions & Culture', traditions_heading: 'Living Traditions',
  video_eyebrow: 'Documentary', video_heading: 'Watch Our Story',
  brochure_heading: 'Download the Heritage Brochure', brochure_text: 'A printable keepsake of Sherubtse College’s history, milestones and legacy.', brochure_button: 'Download Brochure',
};
const raw = history?.labels ?? {};
const t = (k: string) => (typeof raw[k] === 'string' && raw[k].trim() ? raw[k].trim() : DEFAULTS[k] ?? '');

// The founding year comes from About – Overview → Labels, like the About page.
const foundedYear = Number((overview?.labels?.founded_value ?? '').match(/\d{4}/)?.[0] ?? 0) || null;
const years = foundedYear ? new Date().getFullYear() - foundedYear : 0;

const presentCategories = [...new Set(galleryImages.map((g) => g.category))];
const people = history ? !!(history.vision_king_text || history.mackey_bio) : false;

// Chapters shown in the sticky bar: only the sections that exist.
const chapters = history
  ? [
      { id: 'story', label: t('nav_story'), show: !!history.founding_story },
      { id: 'founders', label: t('nav_people'), show: people },
      { id: 'timeline', label: t('nav_timeline'), show: timeline.length > 0 },
      { id: 'gallery', label: t('nav_gallery'), show: galleryImages.length > 0 },
      { id: 'motto', label: t('nav_motto'), show: !!history.motto },
      { id: 'legacy', label: t('nav_legacy'), show: legacyItems.length > 0 },
      { id: 'traditions', label: t('nav_traditions'), show: traditionItems.length > 0 },
      { id: 'video', label: t('nav_video'), show: !!history.video_url },
    ].filter((c) => c.show)
  : [];

const initial = (name: string) => (name.replace(/^(Father|Dr\.?|Mr\.?|His Majesty)\s+/i, '').trim()[0] ?? '').toUpperCase();
const arrowDown = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>';
const download = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"/></svg>';
---
<Layout title="History & Heritage" description={history?.hero_intro ?? 'The history of Sherubtse College.'}>
  {!history ? (
    <div class="wrap" style="padding-top:var(--s5);padding-bottom:var(--s7)">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/about">About</a> › <span class="current">History & Heritage</span></nav>
      <h1 class="h1">History & Heritage</h1>
      <p class="small" style="margin-top:var(--s4)">This page will appear here once added in Strapi.</p>
    </div>
  ) : (
    <article class="hx" data-hx>
      <!-- ============ HERO ============ -->
      <header class:list={['hx-hero', { 'hx-hero--photo': history.hero_image_url }]}>
        {history.hero_image_url && (
          <img class="hx-hero-img" src={history.hero_image_url} alt="" style={`object-position:center ${history.hero_image_position}`} loading="eager" decoding="async" fetchpriority="high" />
        )}
        <span class="hx-hero-shade" aria-hidden="true"></span>
        {foundedYear && <span class="hx-mark" aria-hidden="true" data-hx-mark>{foundedYear}</span>}
        <span class="hx-hero-line" aria-hidden="true"></span>
        <div class="wrap hx-hero-inner">
          <nav class="hx-breadcrumb hx-rise" style="--d:0" aria-label="Breadcrumb">
            <a href="/">Home</a><span aria-hidden="true">›</span><a href="/about">About</a><span aria-hidden="true">›</span><span aria-current="page">History & Heritage</span>
          </nav>
          <h1 class="hx-title hx-rise" style="--d:1">{history.hero_title}</h1>
          <p class="hx-subtitle hx-rise" style="--d:2">{history.hero_subtitle}</p>
          <p class="hx-intro hx-rise" style="--d:3">{history.hero_intro}</p>
          <div class="hx-chips hx-rise" style="--d:4">
            {foundedYear && <span class="hx-chip">{t('since_label').replace('{year}', String(foundedYear))}</span>}
            {years > 0 && <span class="hx-chip hx-chip--gold"><strong data-hx-count={years}>{years}</strong>{t('years_label').replace('{count}', '').trim()}</span>}
            {chapters.length > 0 && <a class="hx-chip hx-chip--link" href={`#${chapters[0].id}`}>{t('scroll_label')} <Fragment set:html={arrowDown} /></a>}
          </div>
        </div>
      </header>

      <!-- ============ CHAPTER BAR ============ -->
      {chapters.length > 1 && (
        <nav class="hx-nav" aria-label={t('nav_label')} data-hx-nav>
          <div class="wrap">
            <ul>
              {chapters.map((c) => <li><a href={`#${c.id}`} data-hx-link>{c.label}</a></li>)}
            </ul>
          </div>
        </nav>
      )}

      <!-- ============ FOUNDING STORY ============ -->
      {history.founding_story && (
        <section class="hx-band" id="story" aria-labelledby="hx-story-h">
          <div class="wrap hx-story" data-hx-reveal>
            <header class="hx-head">
              <p class="hx-eyebrow">{t('story_eyebrow')}</p>
              <h2 class="hx-h2" id="hx-story-h">{t('story_heading')}</h2>
            </header>
            <div class="hx-story-card">
              <span class="hx-quote" aria-hidden="true">“</span>
              <p class="hx-dropcap">{history.founding_story}</p>
            </div>
          </div>
        </section>
      )}

      <!-- ============ THE FOUNDERS: the Third King and Father Mackey ============ -->
      {people && (
        <section class="hx-band hx-band--soft" id="founders" aria-label={t('nav_people')}>
          <div class="wrap hx-people">
            {history.vision_king_text && (
              <article class="hx-person" data-hx-reveal style="--i:0">
                <div class="hx-arch">
                  {history.king_photo_url ? (
                    <img src={history.king_photo_url} alt="His Majesty Jigme Dorji Wangchuck, the Third Druk Gyalpo" loading="lazy" decoding="async" />
                  ) : (
                    <span class="hx-initial" aria-hidden="true">{initial(t('king_heading'))}</span>
                  )}
                </div>
                <div class="hx-person-body">
                  <p class="hx-eyebrow">{t('king_eyebrow')}</p>
                  <h2 class="hx-h3">{t('king_heading')}</h2>
                  <p class="hx-prose">{history.vision_king_text}</p>
                </div>
              </article>
            )}
            {history.mackey_bio && (
              <article class="hx-person" data-hx-reveal style="--i:1">
                <div class="hx-arch">
                  {history.mackey_photo_url ? (
                    <img src={history.mackey_photo_url} alt={history.mackey_name} loading="lazy" decoding="async" />
                  ) : (
                    <span class="hx-initial" aria-hidden="true">{initial(history.mackey_name)}</span>
                  )}
                </div>
                <div class="hx-person-body">
                  <p class="hx-eyebrow">{t('mackey_eyebrow')}</p>
                  <h2 class="hx-h3">{history.mackey_name}</h2>
                  <p class="hx-prose">{history.mackey_bio}</p>
                </div>
              </article>
            )}
          </div>
        </section>
      )}

      <!-- ============ TIMELINE ============ -->
      {timeline.length > 0 && (
        <section class="hx-band" id="timeline" aria-labelledby="hx-timeline-h">
          <div class="wrap">
            <header class="hx-head hx-head--center" data-hx-reveal>
              <p class="hx-eyebrow">{t('timeline_eyebrow')}</p>
              <h2 class="hx-h2" id="hx-timeline-h">{t('timeline_heading')}</h2>
            </header>
            <div class="hx-timeline" data-hx-timeline>
              <span class="hx-spine" aria-hidden="true"><span class="hx-spine-fill" data-hx-spine></span></span>
              <ol>
                {timeline.map((item, i) => (
                  <li class:list={['hx-step', i % 2 === 0 ? 'hx-step--left' : 'hx-step--right', { 'hx-step--now': i === timeline.length - 1 && timeline.length > 1 }]} data-hx-reveal>
                    <span class="hx-node" aria-hidden="true"></span>
                    <div class="hx-step-card">
                      <span class="hx-year">{item.year}</span>
                      <h3 class="hx-step-title">{item.event}</h3>
                      {item.description && <p class="hx-step-text">{item.description}</p>}
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </section>
      )}

      <!-- ============ HERITAGE GALLERY ============ -->
      {galleryImages.length > 0 && (
        <section class="hx-band hx-band--soft" id="gallery" aria-labelledby="hx-gallery-h">
          <div class="wrap">
            <header class="hx-head" data-hx-reveal>
              <p class="hx-eyebrow">{t('gallery_eyebrow')}</p>
              <h2 class="hx-h2" id="hx-gallery-h">{t('gallery_heading')}</h2>
            </header>
            {presentCategories.length > 1 && (
              <div class="hx-filters" role="group" aria-label={t('gallery_filter_label')}>
                <button type="button" class="is-active" data-filter="all" aria-pressed="true">{t('gallery_all')}</button>
                {presentCategories.map((cat) => (
                  <button type="button" data-filter={cat} aria-pressed="false">{GALLERY_CATEGORY_LABELS[cat]}</button>
                ))}
              </div>
            )}
            <div class="hx-gallery">
              {galleryImages.map((img, i) => (
                <button type="button" class="hx-photo" data-category={img.category} data-index={i}>
                  <img src={img.image_url ?? ''} alt={img.caption ?? ''} loading="lazy" decoding="async" />
                  {img.caption && <span class="hx-photo-caption">{img.caption}</span>}
                </button>
              ))}
            </div>
          </div>
          <div class="hx-lightbox" id="hxLightbox" hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
            <button type="button" class="hx-lb-btn hx-lb-close" id="hxLbClose" aria-label="Close photo viewer">✕</button>
            <button type="button" class="hx-lb-btn hx-lb-prev" id="hxLbPrev" aria-label="Previous photo">‹</button>
            <figure class="hx-lb-figure">
              <img src="" alt="" id="hxLbImage" />
              <figcaption id="hxLbCaption"></figcaption>
            </figure>
            <button type="button" class="hx-lb-btn hx-lb-next" id="hxLbNext" aria-label="Next photo">›</button>
          </div>
        </section>
      )}

      <!-- ============ MOTTO & IDENTITY ============ -->
      {history.motto && (
        <section class="hx-motto" id="motto" aria-labelledby="hx-motto-h">
          <span class="hx-motto-pattern" aria-hidden="true"></span>
          <div class="wrap">
            <div class="hx-motto-head" data-hx-reveal>
              <p class="hx-eyebrow hx-eyebrow--light">{t('motto_eyebrow')}</p>
              <h2 class="hx-motto-text" id="hx-motto-h"><span aria-hidden="true">“</span>{history.motto}<span aria-hidden="true">”</span></h2>
            </div>
            {(history.motto_meaning || history.emblem_meaning || history.values_text) && (
              <div class="hx-motto-grid">
                {history.motto_meaning && (
                  <div class="hx-motto-card" data-hx-reveal style="--i:0">
                    <h3>{t('meaning_label')}</h3>
                    <p>{history.motto_meaning}</p>
                  </div>
                )}
                {history.emblem_meaning && (
                  <div class="hx-motto-card" data-hx-reveal style="--i:1">
                    <h3>{t('emblem_label')}</h3>
                    <p>{history.emblem_meaning}</p>
                  </div>
                )}
                {history.values_text && (
                  <div class="hx-motto-card" data-hx-reveal style="--i:2">
                    <h3>{t('values_label')}</h3>
                    <p>{history.values_text}</p>
                  </div>
                )}
              </div>
            )}
          </div>
        </section>
      )}

      <!-- ============ LEGACY ============ -->
      {legacyItems.length > 0 && (
        <section class="hx-band" id="legacy" aria-labelledby="hx-legacy-h">
          <div class="wrap">
            <header class="hx-head" data-hx-reveal>
              <p class="hx-eyebrow">{t('legacy_eyebrow')}</p>
              <h2 class="hx-h2" id="hx-legacy-h">{t('legacy_heading')}</h2>
            </header>
            <ul class="hx-cards">
              {legacyItems.map((item, i) => (
                <li class="hx-card" data-hx-reveal style={`--i:${i}`}>
                  <span class="hx-card-fill" aria-hidden="true"></span>
                  <span class="hx-card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths(item.icon)} />
                  </span>
                  <p class="hx-card-text">{item.text}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <!-- ============ TRADITIONS ============ -->
      {traditionItems.length > 0 && (
        <section class="hx-band hx-band--soft" id="traditions" aria-labelledby="hx-trad-h">
          <div class="wrap">
            <header class="hx-head" data-hx-reveal>
              <p class="hx-eyebrow">{t('traditions_eyebrow')}</p>
              <h2 class="hx-h2" id="hx-trad-h">{t('traditions_heading')}</h2>
            </header>
            <ul class="hx-cards hx-cards--trad">
              {traditionItems.map((item, i) => (
                <li class="hx-card" data-hx-reveal style={`--i:${i}`}>
                  <span class="hx-card-fill" aria-hidden="true"></span>
                  <span class="hx-card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths(item.icon)} />
                  </span>
                  <h3 class="hx-card-title">{item.title}</h3>
                  {item.description && <p class="hx-card-text">{item.description}</p>}
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <!-- ============ DOCUMENTARY ============ -->
      {history.video_url && (
        <section class="hx-band" id="video" aria-labelledby="hx-video-h">
          <div class="wrap hx-video-wrap" data-hx-reveal>
            <header class="hx-head hx-head--center">
              <p class="hx-eyebrow">{t('video_eyebrow')}</p>
              <h2 class="hx-h2" id="hx-video-h">{t('video_heading')}</h2>
            </header>
            <div class="hx-video">
              {/\.mp4($|\?)/i.test(history.video_url) ? (
                <video controls src={history.video_url}></video>
              ) : (
                <iframe src={history.video_url} title="Sherubtse College documentary" allowfullscreen loading="lazy"></iframe>
              )}
            </div>
          </div>
        </section>
      )}

      <!-- ============ BROCHURE ============ -->
      {history.brochure_url && (
        <section class="hx-end">
          <div class="wrap">
            <div class="hx-brochure" data-hx-reveal>
              <div>
                <h2 class="hx-brochure-title">{t('brochure_heading')}</h2>
                <p>{t('brochure_text')}</p>
              </div>
              <a class="hx-btn" href={history.brochure_url} download>{t('brochure_button')} <Fragment set:html={download} /></a>
            </div>
          </div>
        </section>
      )}
    </article>
  )}
</Layout>

<script>
  const root = document.querySelector<HTMLElement>('[data-hx]');
  if (root) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    // ---- Sticky chapter bar: sits under the site header, highlights the chapter being read ----
    const masthead = document.querySelector('.masthead');
    const setTop = () => root.style.setProperty('--hx-top', `${masthead ? masthead.getBoundingClientRect().height : 0}px`);
    setTop();
    window.addEventListener('resize', setTop);
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-hx-link]'));
    if (links.length && 'IntersectionObserver' in window) {
      const byId = new Map(links.map((a) => [a.getAttribute('href')!.slice(1), a]));
      const spy = new IntersectionObserver(
        (entries) =>
          entries.forEach((en) => {
            if (!en.isIntersecting) return;
            links.forEach((a) => a.removeAttribute('aria-current'));
            const a = byId.get(en.target.id);
            if (a) {
              a.setAttribute('aria-current', 'true');
              a.scrollIntoView({ block: 'nearest', inline: 'center', behavior: reduce ? 'auto' : 'smooth' });
            }
          }),
        { rootMargin: '-35% 0px -60% 0px' },
      );
      byId.forEach((_, id) => {
        const s = document.getElementById(id);
        if (s) spy.observe(s);
      });
    }

    // ---- Hero: the founding-year watermark drifts as you scroll; the years count up ----
    const mark = root.querySelector<HTMLElement>('[data-hx-mark]');
    if (mark && !reduce) {
      let ticking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            mark.style.setProperty('--shift', `${Math.min(window.scrollY, 900) * -0.18}px`);
            ticking = false;
          });
        },
        { passive: true },
      );
    }
    const counter = root.querySelector<HTMLElement>('[data-hx-count]');
    if (counter && !reduce) {
      const target = Number(counter.dataset.hxCount);
      const t0 = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / 1400);
        counter.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      };
      counter.textContent = '0';
      requestAnimationFrame(step);
    }

    // ---- Timeline: the gold line fills as you scroll ----
    const timeline = root.querySelector<HTMLElement>('[data-hx-timeline]');
    const fill = root.querySelector<HTMLElement>('[data-hx-spine]');
    if (timeline && fill) {
      if (reduce) {
        fill.style.transform = 'scaleY(1)';
      } else {
        let ticking = false;
        const update = () => {
          const rect = timeline.getBoundingClientRect();
          const vh = window.innerHeight;
          const pct = Math.max(0, Math.min(1, (vh * 0.6 - rect.top) / (rect.height + vh * 0.1)));
          fill.style.transform = `scaleY(${pct})`;
          // A step lights up once the line reaches it.
          timeline.querySelectorAll<HTMLElement>('.hx-step').forEach((s) => s.classList.toggle('is-lit', s.getBoundingClientRect().top < vh * 0.6));
          ticking = false;
        };
        window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
        window.addEventListener('resize', update);
        update();
      }
    }

    // ---- Gallery filter + photo viewer ----
    const grid = root.querySelector('.hx-gallery');
    if (grid) {
      const items = Array.from(root.querySelectorAll<HTMLButtonElement>('.hx-photo'));
      const images = items.map((el) => ({ src: el.querySelector('img')?.getAttribute('src') ?? '', caption: el.querySelector('img')?.getAttribute('alt') ?? '' }));
      const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.hx-filters button'));
      buttons.forEach((btn) =>
        btn.addEventListener('click', () => {
          buttons.forEach((b) => { b.classList.remove('is-active'); b.setAttribute('aria-pressed', 'false'); });
          btn.classList.add('is-active');
          btn.setAttribute('aria-pressed', 'true');
          items.forEach((item) => { item.hidden = !(btn.dataset.filter === 'all' || item.dataset.category === btn.dataset.filter); });
        }),
      );

      const lb = document.getElementById('hxLightbox');
      if (lb && images.length) {
        const img = document.getElementById('hxLbImage') as HTMLImageElement;
        const cap = document.getElementById('hxLbCaption')!;
        const closeBtn = document.getElementById('hxLbClose')!;
        let current = 0;
        let lastFocused: HTMLElement | null = null;
        const show = (i: number) => {
          current = (i + images.length) % images.length;
          img.src = images[current].src;
          img.alt = images[current].caption;
          cap.textContent = images[current].caption;
        };
        const open = (i: number) => { lastFocused = document.activeElement as HTMLElement | null; show(i); lb.hidden = false; document.body.style.overflow = 'hidden'; closeBtn.focus(); };
        const close = () => { lb.hidden = true; document.body.style.overflow = ''; lastFocused?.focus(); };
        items.forEach((it) => it.addEventListener('click', () => open(parseInt(it.dataset.index ?? '0', 10))));
        closeBtn.addEventListener('click', close);
        document.getElementById('hxLbPrev')!.addEventListener('click', () => show(current - 1));
        document.getElementById('hxLbNext')!.addEventListener('click', () => show(current + 1));
        lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
        document.addEventListener('keydown', (e) => {
          if (lb.hidden) return;
          if (e.key === 'Escape') close();
          if (e.key === 'ArrowLeft') show(current - 1);
          if (e.key === 'ArrowRight') show(current + 1);
        });
      }
    }

    // ---- Gentle reveal (cards slide in from the side on the timeline) ----
    if (!reduce && 'IntersectionObserver' in window) {
      root.classList.add('hx-anim');
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((en) => {
            if (!en.isIntersecting) return;
            en.target.classList.add('is-in');
            io.unobserve(en.target);
          }),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
      );
      root.querySelectorAll('[data-hx-reveal]').forEach((el) => io.observe(el));
    }
    void fine;
  }
</script>
