---
// Departments gateway. The three department panels (expanding photo panels with a
// live canvas motif each) are unchanged; everything around them is new: a hero
// where the departments orbit the College, heads of department, a programme
// finder, and links onward. Built on the "department" content type
// (departments.ts); hero text and wording are Academics – Departments Page in
// Strapi. Every number is counted from what Strapi returns. Styles: the panels
// keep departments.css; the rest is departments-page.css (.dx).
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/departments.css';
import '../../../styles/departments-page.css';
import { getDepartments, getDepartmentsPage } from '../../../lib/content/departments';
import { getFacultyDirectory } from '../../../lib/content/faculty';
import { DEPARTMENTS_HERO_DEFAULTS, makeDepartmentsLabels } from '../../../lib/content/departments-labels';

const [departments, page, people] = await Promise.all([
  getDepartments(),
  getDepartmentsPage(),
  getFacultyDirectory().catch(() => []),
]);
const t = makeDepartmentsLabels(page.labels);
const fill = (s: string, n: number) => s.replace('{count}', String(n));
const eyebrow = page.hero_eyebrow || DEPARTMENTS_HERO_DEFAULTS.hero_eyebrow;
const heading = page.hero_heading || DEPARTMENTS_HERO_DEFAULTS.hero_heading;
const intro = page.hero_intro || DEPARTMENTS_HERO_DEFAULTS.hero_intro;

const totalProgrammes = departments.reduce((n, d) => n + d.programmes.length, 0);
const totalFaculty = departments.reduce((n, d) => n + d.faculty_count, 0);
const legacyYears = new Date().getFullYear() - 1968;
const stats = [
  { label: t('stat_departments'), value: departments.length, plus: false },
  { label: t('stat_programmes'), value: totalProgrammes, plus: false },
  { label: t('stat_faculty'), value: totalFaculty, plus: false },
  { label: t('stat_years'), value: legacyYears, plus: true },
].filter((s) => s.value > 0);

// One live-canvas motif per department, layered behind (or, for a
// department with a banner photo, over) its panel's media — picked for
// subject-matter fit rather than assigned arbitrarily: a spider-web
// network for Mathematical & Data Sciences (a graph is the most literal
// data-science visual there is), a rising bar chart with a trend line for
// the social sciences (Economics, Political Science and Management all
// read in growth/trend terms), and a drifting set of lab/plant/animal/atom
// marks for the natural sciences — its own programmes (Life Science,
// Chemistry, Physics) rather than an unrelated stream of falling text.
// Falls back sensibly for any department not yet in the map so a future
// fourth department never breaks the grid.
const SHOWCASE: Record<string, { fx: 'web' | 'lab' | 'growth'; motif: string }> = {
  'humanities-social-sciences': { fx: 'growth', motif: 'Where growth is measured' },
  'mathematical-data-sciences': { fx: 'web', motif: 'Where data connects' },
  'natural-sciences': { fx: 'lab', motif: 'Where science comes alive' },
};
function showcaseFor(slug: string) {
  return SHOWCASE[slug] ?? { fx: 'growth', motif: 'Discover the department' };
}

const shortName = (n: string) => n.replace(/^Department of\s+/i, '');
const programmeCount = (n: number) => fill(n === 1 ? t('count_one') : t('count_many'), n);
const initialsOf = (n: string) =>
  n.replace(/^(Dr\.?|Dasho|Mr\.?|Ms\.?)\s+/i, '').split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]!.toUpperCase()).join('');

const photoBySlug = new Map(people.map((p) => [p.slug, p.photo_url]));
const heads = departments
  .filter((d) => d.head)
  .map((d) => ({ dept: d, head: d.head!, photo: photoBySlug.get(d.head!.slug) ?? null }));

const allProgrammes = departments.flatMap((d) => d.programmes.map((p) => ({ p, d })));
const levels = Array.from(new Set(allProgrammes.map((x) => x.p.level)));
const levelLabel = (l: string) => (l === 'postgraduate' ? t('level_postgraduate') : t('level_undergraduate'));

const ICONS: Record<string, string> = {
  growth: '<path d="M4 20V13M10 20V7M16 20v-9M2 21h20"/><path d="m3 9 5-4 5 3 7-6"/>',
  web: '<circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="M7 6h10M6.3 7.7l4.7 8.6M17.7 7.7 13 16.3"/>',
  lab: '<path d="M9 3h6M10 3v6l-5.5 9.5A1.7 1.7 0 0 0 6 21h12a1.7 1.7 0 0 0 1.5-2.5L14 9V3"/><path d="M7.5 15h9"/>',
  cap: '<path d="M12 3 2 8l10 5 10-5-10-5z"/><path d="M6 10.5v5.5c0 1.5 3 3 6 3s6-1.5 6-3v-5.5"/><path d="M22 8v6"/>',
  people: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14c2 .6 3.5 2.6 3.5 6"/>',
  pen: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
};
const svg = (name: string, size = 24) =>
  `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name] ?? ICONS.cap}</svg>`;
---

<Layout title="Departments" description="The academic departments of Sherubtse College: programmes, faculty and areas of expertise.">
  <div class="dx" data-dx>
    <!-- =========================== HERO =========================== -->
    <header class="dx-hero">
      <span class="dx-glow dx-glow--a" aria-hidden="true"></span>
      <span class="dx-glow dx-glow--b" aria-hidden="true"></span>
      <div class="wrap dx-wide dx-hero-grid">
        <div class="dx-hero-text">
          <nav class="dx-breadcrumb dx-rise" style="--d:0" aria-label="Breadcrumb">
            <a href="/">Home</a><span aria-hidden="true">›</span><a href="/academics">Academics</a><span aria-hidden="true">›</span><span aria-current="page">Departments</span>
          </nav>
          <p class="dx-eyebrow dx-rise" style="--d:1">{eyebrow}</p>
          <h1 class="dx-title dx-rise" style="--d:2">{heading}</h1>
          <p class="dx-intro dx-rise" style="--d:3">{intro}</p>
          {stats.length > 0 && (
            <ul class="dx-stats dx-rise" style="--d:4">
              {stats.map((s) => (
                <li class="dx-stat">
                  <span class="dx-stat-ring" aria-hidden="true"></span>
                  <p class="dx-stat-value"><span data-dx-count={s.value}>{s.value}</span>{s.plus && <span class="plus">+</span>}</p>
                  <p class="dx-stat-label">{s.label}</p>
                </li>
              ))}
            </ul>
          )}
        </div>

        {departments.length > 0 && (
          <div class="dx-orbit dx-rise" style="--d:3" role="group" aria-label={t('orbit_label')}>
            <span class="dx-ring dx-ring--1" aria-hidden="true"></span>
            <span class="dx-ring dx-ring--2" aria-hidden="true"></span>
            <span class="dx-core" aria-hidden="true" set:html={svg('cap', 56)} />
            <ul class="dx-planets" role="list">
              {departments.map((d, i) => (
                <li class="dx-planet" style={`--a:${-90 + (i * 360) / departments.length}deg`}>
                  <span class="dx-hold">
                    <a href={`#dept-${d.slug}`} data-dx-planet>
                      <span class="dx-planet-dot" set:html={svg(showcaseFor(d.slug).fx, 38)} />
                      <span class="dx-planet-name">{shortName(d.name)}</span>
                      <span class="dx-planet-meta">{programmeCount(d.programmes.length)}</span>
                    </a>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </header>

    {departments.length === 0 ? (
      <div class="wrap dx-wide" style="padding-block:var(--s7)">
        <p class="small">Departments will appear here once added in Strapi.</p>
      </div>
    ) : (
      <>
        <!-- =========================== THE THREE PANELS =========================== -->
        <section class="dx-section dx-panels-head" aria-labelledby="dx-panels-h">
          <div class="wrap dx-wide">
            <header class="dx-head" data-dx-reveal>
              <p class="dx-kicker">{t('panels_eyebrow')}</p>
              <h2 class="dx-h2" id="dx-panels-h">{fill(t('panels_heading'), departments.length)}</h2>
              <p class="dx-hint">{t('panels_hint')}</p>
            </header>
          </div>
        </section>

      <section class="dept-section dept-section-cards">
        <div class="wrap dx-wide">
          <div class="dept-panels reveal" id="dept-panels">
            {departments.map((d, i) => {
              const { fx, motif } = showcaseFor(d.slug);
              return (
                <article
                  id={`dept-${d.slug}`}
                  class="dept-panel"
                  tabindex="0"
                  data-fx={fx}
                  style={`--accent:${d.theme_color ?? 'var(--gold)'}`}
                >
                  <div class={`dept-panel-media${d.banner_url ? ' has-photo' : ''}`}>
                    {d.banner_url && <img src={d.banner_url} alt="" loading="lazy" />}
                    <canvas class="dept-panel-fx" aria-hidden="true"></canvas>
                  </div>
                  <div class="dept-panel-wash" aria-hidden="true"></div>

                  <div class="dept-panel-label">
                    <span class="dept-panel-num">0{i + 1}</span>
                    <h2>{d.name}</h2>
                    <small>
                      {d.programmes.length} programme{d.programmes.length === 1 ? '' : 's'} &middot; {d.faculty_count} faculty &middot; {motif}
                    </small>
                  </div>

                  <div class="dept-panel-card">
                    <h3>{d.name}</h3>
                    <span class="dept-panel-rule" aria-hidden="true"></span>
                    {d.head && (
                      <p class="dept-panel-hod"><strong>Head of Department</strong> {d.head.full_name}</p>
                    )}
                    {(d.description || d.short_description) && (
                      <p class="dept-panel-desc">{d.description ?? d.short_description}</p>
                    )}
                    {d.programmes.length > 0 && (
                      <div class="dept-card-chips">
                        {d.programmes.map((p) => (
                          <a class="tag tag-gold" href={`/academics/programmes/${p.slug}`}>{p.programme_name}</a>
                        ))}
                      </div>
                    )}
                    <div class="dept-panel-footer">
                      <p class="dept-panel-faculty"><strong>{d.faculty_count}</strong> faculty members</p>
                      <a class="dept-panel-cta" href={`/academics/departments/${d.slug}`}>
                        Explore department <span aria-hidden="true">→</span>
                      </a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>

        <!-- =========================== HEADS OF DEPARTMENT =========================== -->
        {heads.length > 0 && (
          <section class="dx-section dx-heads" aria-labelledby="dx-heads-h">
            <div class="wrap dx-wide">
              <header class="dx-head" data-dx-reveal>
                <p class="dx-kicker">{t('heads_eyebrow')}</p>
                <h2 class="dx-h2" id="dx-heads-h">{t('heads_heading')}</h2>
              </header>
              <ul class="dx-hgrid" role="list">
                {heads.map(({ dept, head, photo }, i) => (
                  <li class="dx-hitem" data-dx-reveal style={`--d:${i * 90}ms`}>
                    <article class="dx-hcard" aria-labelledby={`dx-h-${head.slug}`}>
                      <a class="dx-hlink" href={`/about/faculty/${head.slug}`} aria-labelledby={`dx-h-${head.slug}`}></a>
                      <span class="dx-fill" aria-hidden="true"></span>
                      <div class="dx-arch">
                        {photo ? <img src={photo} alt="" width="236" height="295" loading="lazy" decoding="async" /> : <span class="dx-monogram" aria-hidden="true">{initialsOf(head.full_name)}</span>}
                      </div>
                      <div class="dx-hbody">
                        <p class="dx-tag">{shortName(dept.name)}</p>
                        <h3 class="dx-hname" id={`dx-h-${head.slug}`}>{head.full_name}</h3>
                        <p class="dx-hrole">{t('head_role')}</p>
                        <span class="dx-go" aria-hidden="true">{t('profile_label')} <Fragment set:html={svg('arrow', 18)} /></span>
                      </div>
                    </article>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}

        <!-- =========================== PROGRAMME FINDER =========================== -->
        {allProgrammes.length > 0 && (
          <section class="dx-section dx-prog" id="programmes" aria-labelledby="dx-prog-h">
            <div class="wrap dx-wide">
              <header class="dx-head" data-dx-reveal>
                <p class="dx-kicker">{t('programmes_eyebrow')}</p>
                <h2 class="dx-h2" id="dx-prog-h">{t('programmes_heading')}</h2>
                <p class="dx-lede">{t('programmes_intro')}</p>
              </header>

              <div class="dx-bar">
                <label class="dx-search">
                  <span set:html={svg('search', 20)} />
                  <input type="search" data-dx-q placeholder={t('search_placeholder')} aria-label={t('search_label')} autocomplete="off" />
                </label>
                <div class="dx-chips" role="group" aria-label={t('programmes_heading')}>
                  <button type="button" class="dx-chip is-on" data-dx-dept="" aria-pressed="true">{t('all_label')}<span>{allProgrammes.length}</span></button>
                  {departments.filter((d) => d.programmes.length > 0).map((d) => (
                    <button type="button" class="dx-chip" data-dx-dept={d.slug} aria-pressed="false">{shortName(d.name)}<span>{d.programmes.length}</span></button>
                  ))}
                  {levels.length > 1 && levels.map((l) => (
                    <button type="button" class="dx-chip" data-dx-level={l} aria-pressed="false">{levelLabel(l)}<span>{allProgrammes.filter((x) => x.p.level === l).length}</span></button>
                  ))}
                </div>
                <p class="dx-count" role="status" aria-live="polite" data-dx-count-text data-one={t('count_one')} data-many={t('count_many')}>{programmeCount(allProgrammes.length)}</p>
              </div>

              <ul class="dx-pgrid" role="list">
                {allProgrammes.map(({ p, d }, i) => (
                  <li class="dx-pitem" data-dx-item data-dept={d.slug} data-level={p.level} data-text={`${p.programme_name} ${d.name} ${levelLabel(p.level)}`.toLowerCase()} data-dx-reveal style={`--d:${(i % 4) * 70}ms`}>
                    <a class="dx-pcard" href={`/academics/programmes/${p.slug}`} style={`--accent:${d.theme_color ?? 'var(--gold)'}`}>
                      <span class="dx-fill" aria-hidden="true"></span>
                      <p class="dx-level">{levelLabel(p.level)}</p>
                      <h3 class="dx-pname">{p.programme_name}</h3>
                      <p class="dx-pdept">{shortName(d.name)}</p>
                      <span class="dx-go">{t('open_label')} <Fragment set:html={svg('arrow', 18)} /></span>
                    </a>
                  </li>
                ))}
              </ul>

              <div class="dx-none" data-dx-none hidden>
                <p>{t('empty_message')}</p>
                <button type="button" class="dx-btn" data-dx-clear>{t('clear_label')}</button>
              </div>
            </div>
          </section>
        )}

        <!-- =========================== KEEP EXPLORING =========================== -->
        <section class="dx-section dx-more" aria-labelledby="dx-more-h">
          <div class="wrap dx-wide">
            <h2 class="dx-sr" id="dx-more-h" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">{t('more_heading')}</h2>
            <ul class="dx-mgrid" role="list">
              {[
                { href: '/student-life', icon: 'people', title: t('student_title'), text: t('student_text'), button: t('student_button') },
                { href: '/research', icon: 'lab', title: t('research_title'), text: t('research_text'), button: t('research_button') },
                { href: '/admissions', icon: 'pen', title: t('admissions_title'), text: t('admissions_text'), button: t('admissions_button') },
              ].map((c, i) => (
                <li data-dx-reveal style={`--d:${i * 90}ms`}>
                  <a class="dx-mcard" href={c.href}>
                    <span class="dx-fill" aria-hidden="true"></span>
                    <span class="dx-micon" set:html={svg(c.icon, 30)} />
                    <h3 class="dx-mtitle">{c.title}</h3>
                    <p class="dx-mtext">{c.text}</p>
                    <span class="dx-go">{c.button} <Fragment set:html={svg('arrow', 18)} /></span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      </>
    )}
  </div>
</Layout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-dx]');
    if (!root) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // The programme filter bar sticks just under the site header.
    const masthead = document.querySelector('.masthead');
    const setTop = () => root.style.setProperty('--dx-top', `${masthead ? masthead.getBoundingClientRect().height : 0}px`);
    setTop();
    addEventListener('resize', setTop, { passive: true });

    // ---- Reveals, and the hero figures count up once ----
    if (!reduce && 'IntersectionObserver' in window) {
      root.classList.add('dx-anim');
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
      root.querySelectorAll('[data-dx-reveal]').forEach((el) => io.observe(el));
      const run = (el) => {
        const end = Number(el.getAttribute('data-dx-count')) || 0;
        const t0 = performance.now();
        const tick = (now) => {
          const p = Math.min(1, (now - t0) / 1300);
          el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        el.textContent = '0';
        requestAnimationFrame(tick);
      };
      const cio = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { run(e.target); cio.unobserve(e.target); } }), { threshold: 0.5 });
      root.querySelectorAll('[data-dx-count]').forEach((n) => cio.observe(n));
    }

    // ---- A planet in the hero opens its department panel ----
    root.querySelectorAll('[data-dx-planet]').forEach((a) => a.addEventListener('click', (e) => {
      const panel = document.getElementById((a.getAttribute('href') || '').slice(1));
      if (!panel) return;
      e.preventDefault();
      e.stopPropagation();
      document.querySelectorAll('.dept-panel').forEach((p) => p.classList.toggle('is-open', p === panel));
      panel.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
      panel.focus({ preventScroll: true });
    }));

    // ---- Programme finder: department, level and search ----
    const items = Array.from(root.querySelectorAll('[data-dx-item]'));
    if (!items.length) return;
    const input = root.querySelector('[data-dx-q]');
    const count = root.querySelector('[data-dx-count-text]');
    const none = root.querySelector('[data-dx-none]');
    const deptChips = Array.from(root.querySelectorAll('[data-dx-dept]'));
    const levelChips = Array.from(root.querySelectorAll('[data-dx-level]'));
    let dept = '';
    let level = '';
    const apply = () => {
      const words = (input.value || '').toLowerCase().split(/\s+/).filter(Boolean);
      let n = 0;
      items.forEach((li) => {
        const ok = (!dept || li.dataset.dept === dept) && (!level || li.dataset.level === level) && words.every((w) => li.dataset.text.includes(w));
        li.hidden = !ok;
        if (ok) { n++; li.classList.add('is-in'); }
      });
      deptChips.forEach((c) => { const on = (c.dataset.dxDept || '') === dept; c.classList.toggle('is-on', on); c.setAttribute('aria-pressed', String(on)); });
      levelChips.forEach((c) => { const on = c.dataset.dxLevel === level; c.classList.toggle('is-on', on); c.setAttribute('aria-pressed', String(on)); });
      count.textContent = (n === 1 ? count.dataset.one : count.dataset.many).replace('{count}', String(n));
      none.hidden = n > 0;
    };
    deptChips.forEach((c) => c.addEventListener('click', () => { dept = c.dataset.dxDept || ''; apply(); }));
    levelChips.forEach((c) => c.addEventListener('click', () => { level = level === c.dataset.dxLevel ? '' : c.dataset.dxLevel; apply(); }));
    input.addEventListener('input', apply);
    root.querySelector('[data-dx-clear]')?.addEventListener('click', () => { dept = ''; level = ''; input.value = ''; apply(); input.focus(); });
  })();
</script>

<script>
  // "Explore Our Departments" — expanding panels, each with a live canvas
  // motif drawn behind it when there's no banner photo to show instead.
  // The widen/reveal itself is plain CSS (flex-grow on desktop, height on
  // mobile); this drives the three canvas effects and opens/closes a
  // panel on tap or keyboard for devices without hover.
  (function () {
    const root = document.getElementById('dept-panels');
    if (!root) return;

    const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const CAN_HOVER = window.matchMedia('(hover: hover)').matches;
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.dept-panel'));
    if (panels.length === 0) return;
    const medias = panels.map((p) => p.querySelector<HTMLElement>('.dept-panel-media')!);

    function readColor(el: HTMLElement, varName: string) {
      const v = getComputedStyle(el).getPropertyValue(varName).trim();
      const ctx = document.createElement('canvas').getContext('2d')!;
      ctx.fillStyle = v || '#f0b429';
      const hex = ctx.fillStyle as string;
      return { r: parseInt(hex.slice(1, 3), 16), g: parseInt(hex.slice(3, 5), 16), b: parseInt(hex.slice(5, 7), 16) };
    }
    function rgba(c: { r: number; g: number; b: number }, a: number) {
      return `rgba(${c.r},${c.g},${c.b},${a})`;
    }

    // Spider-web network — drifting nodes, a line between any two closer
    // than LINK px. Fits the humanities/social-sciences panel: a network of
    // connected ideas.
    class WebFx {
      color: { r: number; g: number; b: number };
      nodes: { x: number; y: number; vx: number; vy: number; r: number }[] = [];
      w = 0;
      h = 0;
      LINK = 120;
      constructor(color: { r: number; g: number; b: number }) {
        this.color = color;
      }
      resize(w: number, h: number) {
        if (this.w && this.h) {
          const sx = w / this.w;
          const sy = h / this.h;
          for (const n of this.nodes) {
            n.x *= sx;
            n.y *= sy;
          }
        }
        this.w = w;
        this.h = h;
        const target = Math.round(Math.min(110, (w * h) / 8200));
        while (this.nodes.length > target) this.nodes.pop();
        while (this.nodes.length < target) {
          this.nodes.push({
            x: Math.random() * w,
            y: Math.random() * h,
            vx: (Math.random() - 0.5) * 20,
            vy: (Math.random() - 0.5) * 20,
            r: Math.random() * 1.3 + 0.6,
          });
        }
      }
      draw(ctx: CanvasRenderingContext2D, dt: number, hot: boolean) {
        const { w, h, nodes: n } = this;
        const speed = hot ? 1 : 0.35;
        for (const a of n) {
          a.x += a.vx * dt * speed;
          a.y += a.vy * dt * speed;
          if (a.x < 0) { a.x = 0; a.vx *= -1; } else if (a.x > w) { a.x = w; a.vx *= -1; }
          if (a.y < 0) { a.y = 0; a.vy *= -1; } else if (a.y > h) { a.y = h; a.vy *= -1; }
        }
        ctx.lineWidth = 1;
        for (let i = 0; i < n.length; i++) {
          const a = n[i];
          for (let j = i + 1; j < n.length; j++) {
            const b = n[j];
            const dx = a.x - b.x;
            const dy = a.y - b.y;
            if (dx > this.LINK || dx < -this.LINK || dy > this.LINK || dy < -this.LINK) continue;
            const d = Math.sqrt(dx * dx + dy * dy);
            if (d > this.LINK) continue;
            ctx.strokeStyle = rgba(this.color, (1 - d / this.LINK) * (hot ? 0.55 : 0.28));
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
          ctx.fillStyle = rgba(this.color, hot ? 0.9 : 0.55);
          ctx.beginPath();
          ctx.arc(a.x, a.y, a.r, 0, 6.2832);
          ctx.fill();
        }
      }
    }

    // A handful of drifting, slowly rotating marks — a flask, a leaf, an
    // atom's orbits, a paw print — cycling through the natural-sciences
    // panel's own programmes (Chemistry, Life Science, Physics) instead of
    // an unrelated stream of falling characters.
    type LabItem = { kind: 'flask' | 'leaf' | 'atom' | 'paw' | 'dna'; x: number; y: number; vx: number; vy: number; size: number; rot: number; rotSpeed: number; phase: number };
    class LabFx {
      color: { r: number; g: number; b: number };
      items: LabItem[] = [];
      w = 0;
      h = 0;
      t = 0;
      constructor(color: { r: number; g: number; b: number }) {
        this.color = color;
      }
      resize(w: number, h: number) {
        this.w = w;
        this.h = h;
        const kinds: LabItem['kind'][] = ['flask', 'leaf', 'atom', 'paw', 'dna'];
        const count = Math.max(5, Math.round((w * h) / 9500));
        this.items = [];
        for (let i = 0; i < count; i++) {
          this.items.push({
            kind: kinds[i % kinds.length],
            x: Math.random() * w,
            y: Math.random() * h,
            vx: (Math.random() - 0.5) * 9,
            vy: (Math.random() - 0.5) * 9,
            size: 15 + Math.random() * 13,
            rot: Math.random() * 6.2832,
            rotSpeed: (Math.random() - 0.5) * 0.5,
            phase: Math.random() * 6.2832,
          });
        }
      }
      draw(ctx: CanvasRenderingContext2D, dt: number, hot: boolean) {
        this.t += dt * (hot ? 1 : 0.3);
        const speed = hot ? 1 : 0.3;
        ctx.lineWidth = 1.4;
        ctx.lineCap = 'round';
        for (const it of this.items) {
          it.x += it.vx * dt * speed;
          it.y += it.vy * dt * speed;
          it.rot += it.rotSpeed * dt * speed;
          const pad = it.size * 1.6;
          if (it.x < -pad) it.x = this.w + pad;
          else if (it.x > this.w + pad) it.x = -pad;
          if (it.y < -pad) it.y = this.h + pad;
          else if (it.y > this.h + pad) it.y = -pad;
          const pulse = 0.55 + 0.45 * Math.sin(this.t * 0.8 + it.phase);
          const a = (hot ? 0.85 : 0.42) * pulse;
          ctx.strokeStyle = rgba(this.color, a);
          ctx.fillStyle = rgba(this.color, a * 0.85);
          this.drawItem(ctx, it);
        }
      }
      drawItem(ctx: CanvasRenderingContext2D, it: LabItem) {
        const s = it.size;
        ctx.save();
        ctx.translate(it.x, it.y);
        ctx.rotate(it.rot);
        if (it.kind === 'flask') {
          ctx.beginPath();
          ctx.moveTo(-s * 0.16, -s * 0.9);
          ctx.lineTo(s * 0.16, -s * 0.9);
          ctx.lineTo(s * 0.16, -s * 0.25);
          ctx.lineTo(s * 0.62, s * 0.65);
          ctx.quadraticCurveTo(s * 0.62, s * 0.95, s * 0.32, s * 0.95);
          ctx.lineTo(-s * 0.32, s * 0.95);
          ctx.quadraticCurveTo(-s * 0.62, s * 0.95, -s * 0.62, s * 0.65);
          ctx.lineTo(-s * 0.16, -s * 0.25);
          ctx.closePath();
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(-s * 0.22, -s * 0.9);
          ctx.lineTo(s * 0.22, -s * 0.9);
          ctx.stroke();
        } else if (it.kind === 'leaf') {
          ctx.beginPath();
          ctx.moveTo(0, -s);
          ctx.bezierCurveTo(s * 0.85, -s * 0.5, s * 0.85, s * 0.6, 0, s);
          ctx.bezierCurveTo(-s * 0.85, s * 0.6, -s * 0.85, -s * 0.5, 0, -s);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(0, -s * 0.82);
          ctx.lineTo(0, s * 0.82);
          ctx.stroke();
        } else if (it.kind === 'atom') {
          ctx.beginPath();
          ctx.arc(0, 0, s * 0.14, 0, 6.2832);
          ctx.fill();
          for (let k = 0; k < 3; k++) {
            const ringRot = k * 1.0472;
            ctx.save();
            ctx.rotate(ringRot);
            ctx.beginPath();
            ctx.ellipse(0, 0, s, s * 0.4, 0, 0, 6.2832);
            ctx.stroke();
            const ang = this.t * 1.4 + k * 2.0944;
            ctx.beginPath();
            ctx.arc(Math.cos(ang) * s, Math.sin(ang) * s * 0.4, s * 0.09, 0, 6.2832);
            ctx.fill();
            ctx.restore();
          }
        } else if (it.kind === 'paw') {
          ctx.beginPath();
          ctx.ellipse(0, s * 0.25, s * 0.45, s * 0.35, 0, 0, 6.2832);
          ctx.fill();
          const toe = s * 0.17;
          const toes: [number, number][] = [[-s * 0.4, -s * 0.4], [-s * 0.15, -s * 0.62], [s * 0.15, -s * 0.62], [s * 0.4, -s * 0.4]];
          for (const [tx, ty] of toes) {
            ctx.beginPath();
            ctx.arc(tx, ty, toe, 0, 6.2832);
            ctx.fill();
          }
        } else {
          // DNA double helix — two out-of-phase strands with rungs between
          // them, the item's own slow rotation reading as the helix twist.
          const steps = 12;
          const turns = 1.6;
          const amp = s * 0.42;
          const top = -s;
          const bottom = s;
          let prev: { x1: number; x2: number; y: number } | null = null;
          for (let k = 0; k <= steps; k++) {
            const yFrac = k / steps;
            const y = top + yFrac * (bottom - top);
            const phase = yFrac * turns * 6.2832;
            const x1 = Math.sin(phase) * amp;
            const x2 = Math.sin(phase + Math.PI) * amp;
            if (prev) {
              ctx.beginPath();
              ctx.moveTo(prev.x1, prev.y);
              ctx.lineTo(x1, y);
              ctx.stroke();
              ctx.beginPath();
              ctx.moveTo(prev.x2, prev.y);
              ctx.lineTo(x2, y);
              ctx.stroke();
            }
            if (k % 3 === 0) {
              ctx.beginPath();
              ctx.moveTo(x1, y);
              ctx.lineTo(x2, y);
              ctx.stroke();
            }
            prev = { x1, x2, y };
          }
        }
        ctx.restore();
      }
    }

    // Rising bar chart with a connecting trend line — fits the social
    // sciences panel: Economics, Political Science and Management all
    // read in growth, trend and measured-progress terms.
    class GrowthFx {
      color: { r: number; g: number; b: number };
      bars: { base: number; amp: number; phase: number; speed: number }[] = [];
      w = 0;
      h = 0;
      t = 0;
      constructor(color: { r: number; g: number; b: number }) {
        this.color = color;
      }
      resize(w: number, h: number) {
        this.w = w;
        this.h = h;
        const count = Math.max(6, Math.round(w / 46));
        this.bars = [];
        for (let i = 0; i < count; i++) {
          this.bars.push({
            base: 0.22 + Math.random() * 0.3,
            amp: 0.15 + Math.random() * 0.28,
            phase: Math.random() * 6.2832,
            speed: 0.35 + Math.random() * 0.5,
          });
        }
      }
      draw(ctx: CanvasRenderingContext2D, dt: number, hot: boolean) {
        this.t += dt * (hot ? 1 : 0.35);
        const { w, h, bars: n } = this;
        const gap = w / n.length;
        const barW = gap * 0.42;
        const points: { x: number; y: number }[] = [];
        for (let i = 0; i < n.length; i++) {
          const b = n[i];
          const frac = b.base + b.amp * (0.5 + 0.5 * Math.sin(this.t * b.speed + b.phase));
          const barH = Math.max(6, frac * h * 0.7);
          const x = i * gap + gap / 2;
          const y = h - barH;
          ctx.fillStyle = rgba(this.color, hot ? 0.4 : 0.2);
          ctx.fillRect(x - barW / 2, y, barW, barH);
          points.push({ x, y: y - 6 });
        }
        ctx.lineWidth = 2;
        ctx.strokeStyle = rgba(this.color, hot ? 0.95 : 0.55);
        ctx.beginPath();
        points.forEach((p, i) => (i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y)));
        ctx.stroke();
        for (const p of points) {
          ctx.fillStyle = rgba(this.color, hot ? 1 : 0.65);
          ctx.beginPath();
          ctx.arc(p.x, p.y, hot ? 3 : 2, 0, 6.2832);
          ctx.fill();
        }
      }
    }

    const FX = { web: WebFx, lab: LabFx, growth: GrowthFx };
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const scenes = panels.flatMap((panel, i) => {
      const media = medias[i];
      const canvas = media?.querySelector<HTMLCanvasElement>('.dept-panel-fx');
      if (!media || !canvas) return [];
      const kind = (panel.dataset.fx as keyof typeof FX) || 'growth';
      const scene = {
        panel,
        canvas,
        ctx: canvas.getContext('2d')!,
        fx: new FX[kind](readColor(panel, '--accent')),
        w: 0,
        h: 0,
        tick: 0,
      };
      function size() {
        const r = media!.getBoundingClientRect();
        if (!r.width || !r.height) return;
        scene.w = r.width;
        scene.h = r.height;
        canvas!.width = Math.round(r.width * dpr);
        canvas!.height = Math.round(r.height * dpr);
        scene.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        scene.fx.resize(r.width, r.height);
      }
      size();
      new ResizeObserver(size).observe(media);
      return [scene];
    });

    let last = performance.now();
    let running = true;
    function frame(now: number) {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      if (running) {
        for (const s of scenes) {
          if (!s.w) continue;
          const hot = s.panel.matches(':hover, .is-open, :focus-visible');
          s.tick++;
          if (!hot && s.tick % 3) continue;
          s.ctx.clearRect(0, 0, s.w, s.h);
          s.fx.draw(s.ctx, hot ? dt : dt * 3, hot);
        }
      }
      requestAnimationFrame(frame);
    }

    if (scenes.length > 0) {
      if (REDUCED) {
        scenes.forEach((s) => s.fx.draw(s.ctx, 0, false));
      } else {
        requestAnimationFrame(frame);
        new IntersectionObserver(
          (entries) => {
            running = entries[0]?.isIntersecting ?? true;
            last = performance.now();
          },
          { threshold: 0 }
        ).observe(root);
      }
    }

    // Tap/keyboard open for devices without hover — matches the reference
    // component's behaviour exactly: one panel open at a time, Escape or a
    // click outside closes it.
    function open(target: HTMLElement | null) {
      panels.forEach((p) => p.classList.toggle('is-open', p === target));
    }
    panels.forEach((panel) => {
      panel.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.dept-panel-cta')) return;
        if (!CAN_HOVER) e.preventDefault();
        open(panel.classList.contains('is-open') && !CAN_HOVER ? null : panel);
      });
      panel.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(panel); }
        if (e.key === 'Escape') open(null);
      });
    });
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.dept-panel')) open(null);
    });
  })();
</script>
