---
// Departments gateway — a full editorial page rather than a plain listing,
// built on the "department" content type (departments.ts), which is where
// this data actually lives (the old Unit-based source this page used to
// read had no academic-kind records to show). Every number below is real:
// counted from what Strapi returns, not authored copy that could drift.
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/section-landing.css';
import '../../../styles/departments.css';
import { getDepartments } from '../../../lib/content/departments';

const departments = await getDepartments();

const totalProgrammes = departments.reduce((n, d) => n + d.programmes.length, 0);
const totalFaculty = departments.reduce((n, d) => n + d.faculty_count, 0);
const legacyYears = new Date().getFullYear() - 1968;

const beyondImage = departments.find((d) => d.banner_url)?.banner_url ?? null;

// One live-canvas motif per department, used behind a card's media area
// when it has no banner photo to show instead — picked for subject-matter
// fit rather than assigned arbitrarily: a spider-web network for
// Mathematical & Data Sciences (a graph is the most literal data-science
// visual there is), a flowing current for the social sciences, and falling
// elements for the natural sciences. Falls back sensibly for any
// department not yet in the map so a future fourth department never
// breaks the grid.
const SHOWCASE: Record<string, { fx: 'web' | 'rain' | 'wave'; motif: string }> = {
  'humanities-social-sciences': { fx: 'wave', motif: 'Where ideas flow' },
  'mathematical-data-sciences': { fx: 'web', motif: 'Where data connects' },
  'natural-sciences': { fx: 'rain', motif: 'Where elements fall' },
};
function showcaseFor(slug: string) {
  return SHOWCASE[slug] ?? { fx: 'wave', motif: 'Discover the department' };
}
---
<Layout
  title="Departments"
  description="The academic departments of Sherubtse College — programmes, faculty and areas of expertise."
>
  <header class="sl-head dept-hero">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> › <a href="/academics">Academics</a> › <span class="current">Departments</span>
      </nav>
      <p class="sl-eyebrow">Academics</p>
      <h1 class="sl-title">Explore Our Departments</h1>
      <span class="sl-rule" aria-hidden="true"></span>
      <p class="sl-intro">
        Three departments carry Sherubtse College's undergraduate teaching — each with its own faculty, programmes
        and academic character. Start with the department closest to what you want to study.
      </p>
    </div>
  </header>

  {departments.length === 0 ? (
    <div class="wrap" style="padding-block:var(--s7)">
      <p class="small">Departments will appear here once added in Strapi.</p>
    </div>
  ) : (
    <>
      <section class="dept-section dept-section-cards">
        <div class="wrap">
          <div class="dept-panels reveal" id="dept-panels">
            {departments.map((d, i) => {
              const { fx, motif } = showcaseFor(d.slug);
              return (
                <article
                  class="dept-panel"
                  tabindex="0"
                  data-fx={fx}
                  style={`--accent:${d.theme_color ?? 'var(--gold)'}`}
                >
                  <div class={`dept-panel-media${d.banner_url ? ' has-photo' : ''}`}>
                    {d.banner_url && <img src={d.banner_url} alt="" loading="lazy" />}
                    <canvas class="dept-panel-fx" aria-hidden="true"></canvas>
                  </div>
                  <div class="dept-panel-wash" aria-hidden="true"></div>

                  <div class="dept-panel-label">
                    <span class="dept-panel-num">0{i + 1}</span>
                    <h2>{d.name}</h2>
                    <small>
                      {d.programmes.length} programme{d.programmes.length === 1 ? '' : 's'} &middot; {d.faculty_count} faculty &middot; {motif}
                    </small>
                  </div>

                  <div class="dept-panel-card">
                    <h3>{d.name}</h3>
                    <span class="dept-panel-rule" aria-hidden="true"></span>
                    {d.head && (
                      <p class="dept-panel-hod"><strong>Head of Department</strong> {d.head.full_name}</p>
                    )}
                    {(d.description || d.short_description) && (
                      <p class="dept-panel-desc">{d.description ?? d.short_description}</p>
                    )}
                    {d.programmes.length > 0 && (
                      <div class="dept-card-chips">
                        {d.programmes.map((p) => (
                          <a class="tag tag-gold" href={`/academics/programmes/${p.slug}`}>{p.programme_name}</a>
                        ))}
                      </div>
                    )}
                    <div class="dept-panel-footer">
                      <p class="dept-panel-faculty"><strong>{d.faculty_count}</strong> faculty members</p>
                      <a class="dept-panel-cta" href={`/academics/departments/${d.slug}`}>
                        Explore department <span aria-hidden="true">→</span>
                      </a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <section class="dept-section dept-stats">
        <div class="wrap">
          <div class="dept-section-head">
            <p class="dept-eyebrow">By the numbers</p>
            <h2 class="dept-section-title" style="color:#fff">A small college, taught closely</h2>
          </div>
          <div class="dept-stat-grid">
            <div class="dept-stat reveal">
              <span class="dept-stat-num"><span data-count-to={departments.length}>0</span></span>
              <span class="dept-stat-label">Academic departments</span>
            </div>
            <div class="dept-stat reveal">
              <span class="dept-stat-num"><span data-count-to={totalProgrammes}>0</span></span>
              <span class="dept-stat-label">Undergraduate programmes</span>
            </div>
            <div class="dept-stat reveal">
              <span class="dept-stat-num"><span data-count-to={totalFaculty}>0</span></span>
              <span class="dept-stat-label">Faculty members</span>
            </div>
            <div class="dept-stat reveal">
              <span class="dept-stat-num"><span data-count-to={legacyYears}>0</span><span class="plus">+</span></span>
              <span class="dept-stat-label">Years since founding, 1968</span>
            </div>
          </div>
        </div>
      </section>

      <section class="dept-section">
        <div class="wrap">
          <div class="dept-section-head">
            <p class="dept-eyebrow">Full directory</p>
            <h2 class="dept-section-title">Every department, expanded</h2>
          </div>
          <div class="dept-accordion reveal" data-dept-accordion>
            {departments.map((d, i) => (
              <div class="dept-accordion-item">
                <h3>
                  <button type="button" class="dept-accordion-trigger" aria-expanded="false" aria-controls={`dept-acc-${d.slug}`} data-dept-trigger>
                    <span class="dept-accordion-num">0{i + 1}</span>
                    <span class="dept-accordion-name">{d.name}</span>
                    <span class="dept-accordion-meta">{d.programmes.length} programmes &middot; {d.faculty_count} faculty</span>
                    <svg class="dept-accordion-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                  </button>
                </h3>
                <div class="dept-accordion-panel" id={`dept-acc-${d.slug}`} data-dept-panel>
                  <div class="dept-accordion-panel-inner">
                    <div>
                      {(d.description || d.short_description) && (
                        <p class="dept-accordion-desc">{d.description ?? d.short_description}</p>
                      )}
                      {d.programmes.length > 0 && (
                        <div class="dept-card-chips">
                          {d.programmes.map((p) => (
                            <a class="tag tag-gold" href={`/academics/programmes/${p.slug}`}>{p.programme_name}</a>
                          ))}
                        </div>
                      )}
                    </div>
                    <div class="dept-accordion-side">
                      {d.head && <p><strong>Head of Department</strong><br />{d.head.full_name}</p>}
                      <p><strong>{d.faculty_count}</strong> faculty members</p>
                      <a class="btn-quiet" href={`/academics/departments/${d.slug}`}>View full department</a>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="dept-beyond reveal">
        {beyondImage && (
          <div class="dept-beyond-media"><img src={beyondImage} alt="" loading="lazy" /></div>
        )}
        <div class="wrap">
          <div class="dept-beyond-body">
            <p class="dept-eyebrow">Beyond the syllabus</p>
            <h2 class="dept-beyond-title">Learning Beyond the Classroom</h2>
            <p class="dept-beyond-desc">
              A Sherubtse education runs past the timetable — clubs, field visits, campus events and residential
              life on the Kanglung hillside shape students as much as any lecture hall does. Departments teach the
              subject; the wider campus is where it's put into practice.
            </p>
            <a class="btn btn-primary" href="/student-life">Discover student life</a>
          </div>
        </div>
      </section>

      <section class="dept-section">
        <div class="wrap">
          <div class="dept-section-head">
            <p class="dept-eyebrow">Research &amp; expertise</p>
            <h2 class="dept-section-title">Programmes our faculty build expertise around</h2>
            <p class="dept-section-desc">
              Every programme below sits inside one of the three departments above — a working map of where
              Sherubtse's teaching and research strength currently concentrates.
            </p>
          </div>
          <div class="dept-expertise-grid">
            {departments.flatMap((d) =>
              d.programmes.map((p) => (
                <a class="dept-expertise-chip reveal" href={`/academics/programmes/${p.slug}`}>
                  <span class="dept-expertise-chip-level">{p.level === 'postgraduate' ? 'Postgraduate' : 'Undergraduate'}</span>
                  <span class="dept-expertise-chip-name">{p.programme_name}</span>
                  <span class="dept-expertise-chip-dept">{d.name}</span>
                </a>
              ))
            )}
          </div>
          <p class="dept-expertise-cta">
            <a class="btn btn-secondary" href="/research">Visit Research &amp; Innovation →</a>
          </p>
        </div>
      </section>
    </>
  )}
</Layout>

<script>
  // Count-up for the stats band — the sitewide reveal script (Layout.astro)
  // only handles opacity/transform, so numeric counters get their own small
  // observer here, generalised to run every [data-count-to] on the page
  // rather than the single counter SectionLanding's split hero uses.
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const counters = Array.from(document.querySelectorAll<HTMLElement>('.dept-stat-num [data-count-to]'));

  function runCounter(el: HTMLElement) {
    const target = Number(el.dataset.countTo ?? '0');
    if (prefersReducedMotion) {
      el.textContent = String(target);
      return;
    }
    const duration = 1100;
    const start = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = String(Math.round(eased * target));
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  if (counters.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          runCounter(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.4 }
    );
    counters.forEach((el) => observer.observe(el));
  } else {
    counters.forEach(runCounter);
  }

  // "Explore Our Departments" — expanding panels, each with a live canvas
  // motif drawn behind it when there's no banner photo to show instead.
  // The widen/reveal itself is plain CSS (flex-grow on desktop, height on
  // mobile); this drives the three canvas effects and opens/closes a
  // panel on tap or keyboard for devices without hover.
  (function () {
    const root = document.getElementById('dept-panels');
    if (!root) return;

    const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const CAN_HOVER = window.matchMedia('(hover: hover)').matches;
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.dept-panel'));
    if (panels.length === 0) return;
    const medias = panels.map((p) => p.querySelector<HTMLElement>('.dept-panel-media')!);

    function readColor(el: HTMLElement, varName: string) {
      const v = getComputedStyle(el).getPropertyValue(varName).trim();
      const ctx = document.createElement('canvas').getContext('2d')!;
      ctx.fillStyle = v || '#f0b429';
      const hex = ctx.fillStyle as string;
      return { r: parseInt(hex.slice(1, 3), 16), g: parseInt(hex.slice(3, 5), 16), b: parseInt(hex.slice(5, 7), 16) };
    }
    function rgba(c: { r: number; g: number; b: number }, a: number) {
      return `rgba(${c.r},${c.g},${c.b},${a})`;
    }

    // Spider-web network — drifting nodes, a line between any two closer
    // than LINK px. Fits the humanities/social-sciences panel: a network of
    // connected ideas.
    class WebFx {
      color: { r: number; g: number; b: number };
      nodes: { x: number; y: number; vx: number; vy: number; r: number }[] = [];
      w = 0;
      h = 0;
      LINK = 120;
      constructor(color: { r: number; g: number; b: number }) {
        this.color = color;
      }
      resize(w: number, h: number) {
        if (this.w && this.h) {
          const sx = w / this.w;
          const sy = h / this.h;
          for (const n of this.nodes) {
            n.x *= sx;
            n.y *= sy;
          }
        }
        this.w = w;
        this.h = h;
        const target = Math.round(Math.min(110, (w * h) / 8200));
        while (this.nodes.length > target) this.nodes.pop();
        while (this.nodes.length < target) {
          this.nodes.push({
            x: Math.random() * w,
            y: Math.random() * h,
            vx: (Math.random() - 0.5) * 20,
            vy: (Math.random() - 0.5) * 20,
            r: Math.random() * 1.3 + 0.6,
          });
        }
      }
      draw(ctx: CanvasRenderingContext2D, dt: number, hot: boolean) {
        const { w, h, nodes: n } = this;
        const speed = hot ? 1 : 0.35;
        for (const a of n) {
          a.x += a.vx * dt * speed;
          a.y += a.vy * dt * speed;
          if (a.x < 0) { a.x = 0; a.vx *= -1; } else if (a.x > w) { a.x = w; a.vx *= -1; }
          if (a.y < 0) { a.y = 0; a.vy *= -1; } else if (a.y > h) { a.y = h; a.vy *= -1; }
        }
        ctx.lineWidth = 1;
        for (let i = 0; i < n.length; i++) {
          const a = n[i];
          for (let j = i + 1; j < n.length; j++) {
            const b = n[j];
            const dx = a.x - b.x;
            const dy = a.y - b.y;
            if (dx > this.LINK || dx < -this.LINK || dy > this.LINK || dy < -this.LINK) continue;
            const d = Math.sqrt(dx * dx + dy * dy);
            if (d > this.LINK) continue;
            ctx.strokeStyle = rgba(this.color, (1 - d / this.LINK) * (hot ? 0.55 : 0.28));
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
          ctx.fillStyle = rgba(this.color, hot ? 0.9 : 0.55);
          ctx.beginPath();
          ctx.arc(a.x, a.y, a.r, 0, 6.2832);
          ctx.fill();
        }
      }
    }

    // Falling data-stream glyphs — fits the mathematics/data-science panel.
    const GLYPHS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+-=∑∫πθ';
    class RainFx {
      color: { r: number; g: number; b: number };
      cols: { y: number; speed: number; tail: number; chars: { row: number; ch: string }[] }[] = [];
      size = 15;
      w = 0;
      h = 0;
      constructor(color: { r: number; g: number; b: number }) {
        this.color = color;
      }
      resize(w: number, h: number) {
        this.w = w;
        this.h = h;
        const count = Math.max(1, Math.floor(w / this.size));
        const rows = Math.ceil(h / this.size) + 4;
        this.cols = [];
        for (let i = 0; i < count; i++) {
          this.cols.push({ y: Math.random() * rows, speed: 6 + Math.random() * 11, tail: 10 + ((Math.random() * 12) | 0), chars: [] });
        }
      }
      draw(ctx: CanvasRenderingContext2D, dt: number, hot: boolean) {
        const s = this.size;
        const rows = Math.ceil(this.h / s) + 4;
        const speed = hot ? 1 : 0.3;
        ctx.font = `600 ${s - 2}px Consolas, monospace`;
        ctx.textBaseline = 'top';
        for (let i = 0; i < this.cols.length; i++) {
          const c = this.cols[i];
          c.y += c.speed * dt * speed;
          if (c.y - c.tail > rows) { c.y = -2; c.speed = 6 + Math.random() * 11; c.chars.length = 0; }
          const head = Math.floor(c.y);
          if (!c.chars.length || c.chars[0].row !== head) {
            c.chars.unshift({ row: head, ch: GLYPHS[(Math.random() * GLYPHS.length) | 0] });
            if (c.chars.length > c.tail) c.chars.length = c.tail;
          }
          for (let k = 0; k < c.chars.length; k++) {
            const g = c.chars[k];
            const y = g.row * s;
            if (y < -s || y > this.h) continue;
            const fade = 1 - k / c.tail;
            ctx.fillStyle = k === 0 ? `rgba(255,255,255,${hot ? 0.9 : 0.45})` : rgba(this.color, fade * fade * (hot ? 0.9 : 0.4));
            ctx.fillText(g.ch, i * s, y);
          }
        }
      }
    }

    // Flowing wave grid — fits the natural-sciences panel: fields and flow.
    class WaveFx {
      color: { r: number; g: number; b: number };
      t = 0;
      w = 0;
      h = 0;
      constructor(color: { r: number; g: number; b: number }) {
        this.color = color;
      }
      resize(w: number, h: number) {
        this.w = w;
        this.h = h;
      }
      draw(ctx: CanvasRenderingContext2D, dt: number, hot: boolean) {
        this.t += dt * (hot ? 1 : 0.3);
        const { w, h } = this;
        const lines = 22;
        const step = 16;
        const amp = hot ? 20 : 11;
        ctx.lineWidth = 1;
        for (let i = 0; i < lines; i++) {
          const baseY = (i / (lines - 1)) * h;
          const depth = i / (lines - 1);
          ctx.strokeStyle = rgba(this.color, (0.08 + depth * 0.4) * (hot ? 1 : 0.55));
          ctx.beginPath();
          for (let x = 0; x <= w + step; x += step) {
            const y =
              baseY +
              Math.sin(x * 0.008 + this.t * 1.1 + i * 0.35) * amp * depth +
              Math.sin(x * 0.019 - this.t * 0.7 + i * 0.18) * amp * 0.45 * depth;
            if (x === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          }
          ctx.stroke();
        }
      }
    }

    const FX = { web: WebFx, rain: RainFx, wave: WaveFx };
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const scenes = panels.flatMap((panel, i) => {
      const media = medias[i];
      const canvas = media?.querySelector<HTMLCanvasElement>('.dept-panel-fx');
      if (!media || !canvas) return [];
      const kind = (panel.dataset.fx as keyof typeof FX) || 'wave';
      const scene = {
        panel,
        canvas,
        ctx: canvas.getContext('2d')!,
        fx: new FX[kind](readColor(panel, '--accent')),
        w: 0,
        h: 0,
        tick: 0,
      };
      function size() {
        const r = media!.getBoundingClientRect();
        if (!r.width || !r.height) return;
        scene.w = r.width;
        scene.h = r.height;
        canvas!.width = Math.round(r.width * dpr);
        canvas!.height = Math.round(r.height * dpr);
        scene.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        scene.fx.resize(r.width, r.height);
      }
      size();
      new ResizeObserver(size).observe(media);
      return [scene];
    });

    let last = performance.now();
    let running = true;
    function frame(now: number) {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      if (running) {
        for (const s of scenes) {
          if (!s.w) continue;
          const hot = s.panel.matches(':hover, .is-open, :focus-visible');
          s.tick++;
          if (!hot && s.tick % 3) continue;
          s.ctx.clearRect(0, 0, s.w, s.h);
          s.fx.draw(s.ctx, hot ? dt : dt * 3, hot);
        }
      }
      requestAnimationFrame(frame);
    }

    if (scenes.length > 0) {
      if (REDUCED) {
        scenes.forEach((s) => s.fx.draw(s.ctx, 0, false));
      } else {
        requestAnimationFrame(frame);
        new IntersectionObserver(
          (entries) => {
            running = entries[0]?.isIntersecting ?? true;
            last = performance.now();
          },
          { threshold: 0 }
        ).observe(root);
      }
    }

    // Tap/keyboard open for devices without hover — matches the reference
    // component's behaviour exactly: one panel open at a time, Escape or a
    // click outside closes it.
    function open(target: HTMLElement | null) {
      panels.forEach((p) => p.classList.toggle('is-open', p === target));
    }
    panels.forEach((panel) => {
      panel.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.dept-panel-cta')) return;
        if (!CAN_HOVER) e.preventDefault();
        open(panel.classList.contains('is-open') && !CAN_HOVER ? null : panel);
      });
      panel.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(panel); }
        if (e.key === 'Escape') open(null);
      });
    });
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.dept-panel')) open(null);
    });
  })();

  // Expandable directory — smooth height transition rather than the
  // instant show/hide a plain [hidden] toggle would give.
  const accordion = document.querySelector<HTMLElement>('[data-dept-accordion]');
  if (accordion) {
    const triggers = Array.from(accordion.querySelectorAll<HTMLButtonElement>('[data-dept-trigger]'));
    triggers.forEach((trigger) => {
      const panel = document.getElementById(trigger.getAttribute('aria-controls') ?? '');
      if (!panel) return;
      trigger.addEventListener('click', () => {
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';
        trigger.setAttribute('aria-expanded', String(!isOpen));
        panel.style.height = isOpen ? `${panel.scrollHeight}px` : '0px';
        requestAnimationFrame(() => {
          panel.style.height = isOpen ? '0px' : `${panel.scrollHeight}px`;
        });
        panel.addEventListener(
          'transitionend',
          () => {
            if (trigger.getAttribute('aria-expanded') === 'true') panel.style.height = 'auto';
          },
          { once: true }
        );
      });
    });
  }
</script>
