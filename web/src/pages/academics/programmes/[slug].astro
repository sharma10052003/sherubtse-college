---
import Layout from '../../../layouts/Layout.astro';
import { getProgrammes, getProgrammeBySlug } from '../../../lib/content/programmes';

export async function getStaticPaths() {
  const programmes = await getProgrammes();
  return programmes.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const programme = await getProgrammeBySlug(slug as string);
if (!programme) return Astro.redirect('/academics/programmes', 404);
---
<Layout title={programme.programme_name} description={programme.short_description ?? undefined}>
  <div class="wrap" style="padding-top:var(--s5)">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> › <a href="/academics">Academics</a> › <a href="/academics/programmes">Programmes</a> ›{' '}
      <span class="current">{programme.programme_name}</span>
    </nav>

    <h1 class="h1">{programme.programme_name}</h1>

    <div class="tbl-wrap fact-bar">
      <div><span class="fact-label">Award</span><b>{programme.degree_type ?? '—'}</b></div>
      <div><span class="fact-label">Duration</span><b>{programme.duration ?? '—'}</b></div>
      <div><span class="fact-label">Department</span><b>{programme.department_name ?? '—'}</b></div>
      <div><span class="fact-label">Annual Fee</span><b>{programme.annual_fee ? `Nu. ${programme.annual_fee.toLocaleString()}` : '—'}</b></div>
      <div><span class="fact-label">Intake</span><b>{programme.intake_status ?? '—'}</b></div>
    </div>

    <div class="two-col" style="margin-top:var(--s6);padding-bottom:var(--s7)">
      <div>
        {programme.overview && (<><h2 class="h2">Overview</h2><p>{programme.overview}</p></>)}
        {programme.admission_requirements && (<><h2 class="h2">Entry requirements</h2><p>{programme.admission_requirements}</p></>)}
        {programme.curriculum.length > 0 && (
          <>
            <h2 class="h2">Programme structure</h2>
            {programme.curriculum.map((block) => (
              <details class="curriculum-block">
                <summary>{block.label}</summary>
                <p style="white-space:pre-line">{block.courses}</p>
              </details>
            ))}
          </>
        )}
        {programme.career_opportunities && (<><h2 class="h2">Careers</h2><p>{programme.career_opportunities}</p></>)}
        {programme.faqs.length > 0 && (
          <>
            <h2 class="h2">Frequently asked questions</h2>
            {programme.faqs.map((f) => (
              <details class="curriculum-block">
                <summary>{f.question}</summary>
                <p>{f.answer}</p>
              </details>
            ))}
          </>
        )}
      </div>
      <div>
        <a href="/admissions/apply" class="btn btn-primary" style="display:block;text-align:center;margin-bottom:var(--s5)">Apply now</a>
        {programme.coordinator && (
          <>
            <h2 class="h2" style="font-size:1rem">Coordinator</h2>
            <p class="small"><a href={`/people/${programme.coordinator.slug}`}>{programme.coordinator.full_name}</a></p>
          </>
        )}
      </div>
    </div>
  </div>
</Layout>

<style>
  .fact-bar {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s4);
    background: var(--paper-2);
    border-top: 2px solid var(--navy);
    padding: var(--s4);
    margin-top: var(--s4);
    font-size: 0.85rem;
  }
  @media (min-width: 760px) {
    .fact-bar {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .fact-label {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.62rem;
    color: var(--ink-2);
    margin-bottom: 4px;
  }
  .two-col {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s6);
  }
  @media (min-width: 1024px) {
    .two-col {
      grid-template-columns: 2fr 1fr;
    }
  }
  .curriculum-block {
    border: 1px solid var(--line);
    padding: var(--s3) var(--s4);
    margin-bottom: var(--s3);
  }
  .curriculum-block summary {
    cursor: pointer;
    font-weight: 600;
  }
</style>
