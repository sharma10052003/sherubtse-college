---
// Student Life landing page. Everything is edited in Strapi:
//  - Student Life – Overview: eyebrow, heading, intro, hero photos, hero
//    buttons, the boxes, the extra sections and the small wording (Labels);
//  - Clubs: the club ribbon and the "Find your club" section (active clubs).
// The hero is this page's own: a stack of photos that fan out and shuffle,
// a waving prayer-flag strip and a ribbon of every club. The boxes are the
// shared landing-page boxes (components/LandingCards.astro).
// Rounded, moving design by the project owner's request. Styles: student-life.css (.sx).
import Layout from '../../layouts/Layout.astro';
import LandingCards from '../../components/LandingCards.astro';
import '../../styles/student-life.css';
import { getLandingPage } from '../../lib/content/landing';
import { strapiGet, type StrapiListResponse } from '../../lib/strapi';

const [page, clubsRes] = await Promise.all([
  getLandingPage('student-life-overview'),
  strapiGet<StrapiListResponse<any>>('clubs', {
    fields: ['name', 'slug', 'category'],
    filters: { is_active: { $eq: true } },
    sort: ['name:asc'],
    pagination: { pageSize: 200 },
  }),
]);

// Wording from Student Life – Overview → Labels (defaults match the Strapi seed).
const DEFAULTS: Record<string, string> = {
  clubs_count: '{count} clubs & societies',
  ribbon_label: 'Clubs & societies',
  clubs_heading: 'Find your club',
  clubs_intro: 'Student-run clubs, units, societies and forums. Pick an interest to narrow the list.',
  clubs_filter_all: 'All',
  clubs_all_link: 'See all clubs & societies',
  meta_clubs: '{count} clubs',
  photo_prev: 'Previous photo',
  photo_next: 'Next photo',
  photo_pause: 'Pause photos',
  photo_play: 'Play photos',
  explore_label: 'Explore',
};
const raw = page?.labels ?? {};
const t = (k: string) => (typeof raw[k] === 'string' && raw[k].trim() ? raw[k].trim() : DEFAULTS[k] ?? '');
const fill = (k: string, n: number) => t(k).replace('{count}', String(n));

const heading = page?.heading ?? 'Student Life';
const photos = (page?.hero_photos ?? []).slice(0, 8);
const buttons = page?.hero_buttons ?? [];
const slideMs = (page?.hero_slide_seconds ?? 3) * 1000;

// Clubs: initials for the round badge — an acronym in brackets if the name has one.
const initials = (name: string) => {
  const acr = name.match(/\(([A-Z]{2,6})\)/)?.[1];
  if (acr) return acr.slice(0, 4);
  const words = name.replace(/[^A-Za-z\s]/g, ' ').split(/\s+/).filter((w) => w && !/^(of|and|the|for|club|unit|society|sherubtse)$/i.test(w));
  return (words.slice(0, 2).map((w) => w[0]).join('') || name.slice(0, 2)).toUpperCase();
};
const clubs = ((clubsRes?.data ?? []) as any[])
  .filter((c) => c.name && c.slug)
  .map((c) => ({ name: c.name as string, url: `/student-life/clubs/${c.slug}`, category: (c.category as string) || '', badge: initials(c.name) }));
const categories = [...new Map(clubs.filter((c) => c.category).map((c) => [c.category, clubs.filter((x) => x.category === c.category).length])).entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const catKey = (c: string) => c.toLowerCase().replace(/[^a-z0-9]+/g, '-');

// Boxes, with a live note on the clubs box.
const pathOf = (url: string) => url.replace(/[?#].*$/, '').replace(/\/$/, '');
const cards = (page?.cards ?? []).map((c) => ({ ...c, meta: pathOf(c.url) === '/student-life/clubs' && clubs.length ? fill('meta_clubs', clubs.length) : '' }));

const external = (url: string) => /^https?:\/\//i.test(url);
const arrow = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const blocks = page?.blocks ?? [];
const textBlocks = blocks.filter((b) => b.kind === 'text');
const otherBlocks = blocks.filter((b) => b.kind !== 'text');
---
<Layout title={heading} description={page?.seo_description ?? page?.intro ?? undefined}>
  <div class="sx" data-sx>
    <!-- ============ HERO ============ -->
    <header class:list={['sx-hero', { 'sx-hero--photos': photos.length > 0 }]}>
      <span class="sx-flags" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
      <span class="sx-glow sx-glow--gold" aria-hidden="true"></span>
      <span class="sx-glow sx-glow--blue" aria-hidden="true"></span>
      <div class="wrap sx-hero-grid">
        <div class="sx-hero-text">
          <nav class="sx-breadcrumb sx-rise" style="--d:0" aria-label="Breadcrumb">
            <a href="/">Home</a><span aria-hidden="true">›</span><span aria-current="page">{heading}</span>
          </nav>
          {page?.eyebrow && page.eyebrow !== heading && <p class="sx-eyebrow sx-rise" style="--d:1">{page.eyebrow}</p>}
          <h1 class="sx-title sx-rise" style="--d:2">{heading}</h1>
          {page?.intro && <p class="sx-intro sx-rise" style="--d:3">{page.intro}</p>}
          {(buttons.length > 0 || clubs.length > 0) && (
            <div class="sx-actions sx-rise" style="--d:4">
              {buttons.map((b, i) => (
                <a class:list={['sx-btn', i === 0 ? 'sx-btn--gold' : 'sx-btn--line']} href={b.url} {...(external(b.url) ? { target: '_blank', rel: 'noopener' } : {})}>{b.label}</a>
              ))}
              {clubs.length > 0 && <span class="sx-live"><span class="sx-live-dot" aria-hidden="true"></span>{fill('clubs_count', clubs.length)}</span>}
            </div>
          )}
        </div>

        {photos.length > 0 && (
          <div class="sx-deck sx-rise" style="--d:3" data-sx-deck data-sx-interval={slideMs} aria-roledescription="carousel" aria-label={heading}>
            <ul class="sx-deck-cards">
              {photos.map((p, i) => (
                <li class="sx-photo" data-rank={i} aria-hidden={i === 0 ? undefined : 'true'}>
                  <img src={p.src} srcset={p.srcset ?? undefined} sizes="(min-width: 1000px) 34vw, 80vw" alt={p.alt} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
                  {p.alt && <span class="sx-photo-caption">{p.alt}</span>}
                </li>
              ))}
            </ul>
            {photos.length > 1 && (
              <div class="sx-deck-controls">
                <button type="button" class="sx-round" data-sx-prev aria-label={t('photo_prev')} title={t('photo_prev')}>
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
                </button>
                <ol class="sx-dots" aria-hidden="true">{photos.map((_, i) => <li class:list={{ 'is-on': i === 0 }}></li>)}</ol>
                <button type="button" class="sx-round" data-sx-toggle aria-label={t('photo_pause')} title={t('photo_pause')} data-pause={t('photo_pause')} data-play={t('photo_play')}>
                  <svg class="sx-ico-pause" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
                  <svg class="sx-ico-play" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                </button>
                <button type="button" class="sx-round" data-sx-next aria-label={t('photo_next')} title={t('photo_next')}>
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                </button>
              </div>
            )}
          </div>
        )}
      </div>

      {clubs.length > 0 && (
        <div class="sx-ribbon">
          <p class="sx-ribbon-label">{t('ribbon_label')}</p>
          <div class="sx-ribbon-view">
            <ul class="sx-ribbon-track" style={`--n:${clubs.length}`}>
              {[0, 1].map((copy) =>
                clubs.map((c) => (
                  <li aria-hidden={copy === 1 ? 'true' : undefined}>
                    <a href={c.url} tabindex={copy === 1 ? '-1' : undefined}><span>{c.badge}</span>{c.name}</a>
                  </li>
                )),
              )}
            </ul>
          </div>
        </div>
      )}
    </header>

    <!-- ============ BOXES ============ -->
    <section class="sx-band" aria-label={heading}>
      <div class="wrap">
        {cards.length > 0 ? (
          <LandingCards cards={cards} exploreLabel={t('explore_label')} label={heading} />
        ) : (
          <p class="sx-empty">This page is temporarily unavailable. Please check back shortly.</p>
        )}
      </div>
    </section>

    <!-- ============ FIND YOUR CLUB ============ -->
    {clubs.length > 0 && (
      <section class="sx-band sx-band--soft" id="clubs" aria-labelledby="sx-clubs-h">
        <div class="wrap">
          <div class="sx-clubs" data-sx-clubs>
            <header class="sx-clubs-head">
              <div>
                <h2 class="sx-h2" id="sx-clubs-h">{t('clubs_heading')}</h2>
                {t('clubs_intro') && <p class="sx-lede">{t('clubs_intro')}</p>}
              </div>
              <a class="sx-pill-link" href="/student-life/clubs">{t('clubs_all_link')} <Fragment set:html={arrow} /></a>
            </header>
            {categories.length > 1 && (
              <div class="sx-chips" role="group" aria-label={t('clubs_heading')}>
                <button type="button" class="sx-chip" data-cat="all" aria-pressed="true">{t('clubs_filter_all')} <span>{clubs.length}</span></button>
                {categories.map(([name, n]) => (
                  <button type="button" class="sx-chip" data-cat={catKey(name)} aria-pressed="false">{name} <span>{n}</span></button>
                ))}
              </div>
            )}
            <ul class="sx-club-grid" aria-live="polite">
              {clubs.map((c, i) => (
                <li class="sx-club" data-cat={catKey(c.category)} style={`--i:${i % 12}`}>
                  <a href={c.url}>
                    <span class="sx-club-badge" aria-hidden="true">{c.badge}</span>
                    <span class="sx-club-text">
                      <span class="sx-club-name">{c.name}</span>
                      {c.category && <span class="sx-club-cat">{c.category}</span>}
                    </span>
                    <span class="sx-club-go" aria-hidden="true"><Fragment set:html={arrow} /></span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    <!-- ============ EXTRA SECTIONS (Strapi “Sections”) ============ -->
    {blocks.length > 0 && (
      <section class="sx-band" aria-label={heading}>
        <div class="wrap">
          {textBlocks.length > 0 && (
            <div class="sx-panels">
              {textBlocks.map((b, i) => b.kind === 'text' && (
                <article class="sx-panel" data-sx-reveal style={`--i:${i}`}>
                  {b.heading && <h2 class="sx-panel-title">{b.heading}</h2>}
                  {b.paragraphs.map((p) => <p>{p}</p>)}
                </article>
              ))}
            </div>
          )}
          {otherBlocks.map((b) => (
            b.kind === 'image-text' ? (
              <article class:list={['sx-imgtext', { 'sx-imgtext--left': b.side === 'left' }]} data-sx-reveal>
                {b.image_url && <img src={b.image_url} alt={b.image_alt} loading="lazy" decoding="async" />}
                <div>
                  {b.heading && <h2 class="sx-panel-title">{b.heading}</h2>}
                  {b.paragraphs.map((p) => <p>{p}</p>)}
                </div>
              </article>
            ) : b.kind === 'cta' ? (
              <aside class="sx-cta" data-sx-reveal>
                <div>
                  <h2 class="sx-cta-title">{b.heading}</h2>
                  {b.text && <p>{b.text}</p>}
                </div>
                {b.button_label && b.button_url && <a class="sx-btn sx-btn--gold" href={b.button_url}>{b.button_label}</a>}
              </aside>
            ) : null
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-sx]');
    if (!root) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---- Photo stack: the front photo flips to the back every few seconds ----
    const deck = root.querySelector('[data-sx-deck]');
    if (deck) {
      const cards = Array.from(deck.querySelectorAll('.sx-photo'));
      const dots = Array.from(deck.querySelectorAll('.sx-dots li'));
      const toggle = deck.querySelector('[data-sx-toggle]');
      let order = cards.map((_, i) => i);
      let playing = !reduce && cards.length > 1;
      let timer = null;
      const paint = () => {
        order.forEach((card, rank) => {
          cards[card].dataset.rank = String(Math.min(rank, 4));
          cards[card].setAttribute('aria-hidden', rank === 0 ? 'false' : 'true');
        });
        dots.forEach((d, i) => d.classList.toggle('is-on', i === order[0]));
      };
      const step = (dir) => {
        if (cards.length < 2) return;
        if (dir > 0) {
          const front = cards[order[0]];
          front.classList.remove('is-flip');
          void front.offsetWidth;
          if (!reduce) front.classList.add('is-flip');
          order.push(order.shift());
        } else {
          order.unshift(order.pop());
        }
        paint();
      };
      const schedule = () => { clearInterval(timer); if (playing) timer = setInterval(() => step(1), Number(deck.dataset.sxInterval) || 3000); };
      const setPlaying = (on) => {
        playing = on;
        deck.classList.toggle('is-paused', !on);
        if (toggle) toggle.setAttribute('aria-label', on ? toggle.dataset.pause : toggle.dataset.play);
        if (toggle) toggle.title = toggle.getAttribute('aria-label');
        schedule();
      };
      deck.querySelector('[data-sx-next]')?.addEventListener('click', () => { step(1); schedule(); });
      deck.querySelector('[data-sx-prev]')?.addEventListener('click', () => { step(-1); schedule(); });
      toggle?.addEventListener('click', () => setPlaying(!playing));
      deck.addEventListener('pointerenter', () => clearInterval(timer));
      deck.addEventListener('pointerleave', schedule);
      deck.addEventListener('focusin', () => clearInterval(timer));
      deck.addEventListener('focusout', schedule);
      deck.querySelector('.sx-deck-cards')?.addEventListener('click', () => { step(1); schedule(); });
      paint();
      setPlaying(playing);
    }

    // ---- Find your club: filter by interest ----
    const box = root.querySelector('[data-sx-clubs]');
    if (box) {
      const chips = Array.from(box.querySelectorAll('[data-cat]')).filter((el) => el.tagName === 'BUTTON');
      const tiles = Array.from(box.querySelectorAll('.sx-club'));
      chips.forEach((chip) => chip.addEventListener('click', () => {
        const cat = chip.dataset.cat;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        let n = 0;
        tiles.forEach((tile) => {
          const on = cat === 'all' || tile.dataset.cat === cat;
          tile.hidden = !on;
          if (on && !reduce) { tile.style.setProperty('--i', String(n++ % 12)); tile.classList.remove('is-pop'); void tile.offsetWidth; tile.classList.add('is-pop'); }
        });
      }));
    }

    // ---- Gentle reveal ----
    if (reduce || !('IntersectionObserver' in window)) return;
    root.classList.add('sx-anim');
    const io = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (!en.isIntersecting) return;
      en.target.classList.add('is-in');
      io.unobserve(en.target);
    }), { rootMargin: '0px 0px -6% 0px', threshold: 0.05 });
    root.querySelectorAll('[data-sx-reveal], .sx-club').forEach((el) => io.observe(el));
  })();
</script>
