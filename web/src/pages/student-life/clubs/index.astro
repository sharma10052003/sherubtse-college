---
import Layout from '../../../layouts/Layout.astro';
import { strapiGet } from '../../../lib/strapi';
import type { StrapiListResponse } from '../../../lib/strapi';

const res = await strapiGet<StrapiListResponse<any>>('clubs', {
  fields: ['name', 'slug', 'category', 'is_active'],
  filters: { is_active: { $eq: true } },
  sort: 'name:asc',
  pagination: { pageSize: 100 },
});
const clubs = res?.data ?? [];
---
<Layout title="Clubs & Societies" description="Student clubs and societies at Sherubtse College.">
  <div class="wrap" style="padding-top:var(--s5);padding-bottom:var(--s7)">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/student-life">Student Life</a> › <span class="current">Clubs & Societies</span></nav>
    <h1 class="h1">Clubs &amp; Societies</h1>
    <div class="cards" style="margin-top:var(--s6)">
      {clubs.length > 0 ? clubs.map((c: any) => (
        <div class="card">
          <h3 class="h3">{c.name}</h3>
          {c.category && <p>{c.category}</p>}
          <a href={`/student-life/clubs/${c.slug}`} class="btn-quiet">View club</a>
        </div>
      )) : <p class="small">Clubs will appear here once added in Strapi.</p>}
    </div>
  </div>
</Layout>
