---
import UnitTemplate from '../../../components/templates/UnitTemplate.astro';
import { getClubBySlug } from '../../../lib/content/clubs';
import { strapiGet } from '../../../lib/strapi';
import type { StrapiListResponse } from '../../../lib/strapi';

export async function getStaticPaths() {
  const res = await strapiGet<StrapiListResponse<{ slug: string }>>('clubs', {
    fields: ['slug'],
    pagination: { pageSize: 100 },
  });
  return (res?.data ?? []).map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const unit = await getClubBySlug(slug as string);
if (!unit) return Astro.redirect('/student-life/clubs', 404);
---
<UnitTemplate
  unit={unit}
  breadcrumb={[
    { label: 'Home', url: '/' },
    { label: 'Student Life', url: '/student-life' },
    { label: 'Clubs & Societies', url: '/student-life/clubs' },
    { label: unit.name, url: `/student-life/clubs/${unit.slug}` },
  ]}
/>
