{
  "kind": "singleType",
  "collectionName": "president_content",
  "info": {
    "singularName": "president-content",
    "pluralName": "president-contents",
    "displayName": "President Content"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "position": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "message": {
      "type": "text",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "signature": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "button_text": {
      "type": "string",
      "default": "Read Full Message",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "button_url": {
      "type": "string",
      "default": "/about/president"
    }
  }
}
