{
  "kind": "collectionType",
  "collectionName": "research_centres",
  "info": {
    "singularName": "research-centre",
    "pluralName": "research-centres",
    "displayName": "Research – Centres"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "lead": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::person.person"
    },
    "members": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::person.person"
    },
    "focus_areas": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::expertise.expertise"
    },
    "external_link": {
      "type": "string"
    },
    "description": {
      "type": "richtext"
    },
    "owning_unit": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::unit.unit",
      "required": true
    },
    "last_reviewed": {
      "type": "date",
      "required": true
    },
    "review_interval": {
      "type": "enumeration",
      "enum": [
        "semester",
        "annual",
        "none"
      ],
      "default": "none"
    },
    "expires_at": {
      "type": "datetime"
    },
    "acronym": {
      "type": "string"
    },
    "summary": {
      "type": "text",
      "maxLength": 400
    },
    "themes": {
      "type": "text"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "logo_alt": {
      "type": "string"
    },
    "display_order": {
      "type": "integer",
      "default": 0
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    }
  }
}
