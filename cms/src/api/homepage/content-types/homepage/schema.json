{
  "kind": "singleType",
  "collectionName": "homepage",
  "info": {
    "singularName": "homepage",
    "pluralName": "homepages",
    "displayName": "Home – Page",
    "description": "The homepage: the hero at the top, then the sections in the order listed under “Sections”."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "hero_eyebrow": {
      "type": "string"
    },
    "hero_heading": {
      "type": "string"
    },
    "statement": {
      "type": "text"
    },
    "hero_badge": {
      "type": "string"
    },
    "hero_buttons": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link-item"
    },
    "hero_video": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "videos"
      ]
    },
    "hero_images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "hero_image_alt": {
      "type": "string"
    },
    "hero_overlay": {
      "type": "enumeration",
      "enum": [
        "light",
        "medium",
        "strong"
      ],
      "default": "medium"
    },
    "hero_align": {
      "type": "enumeration",
      "enum": [
        "left",
        "center"
      ],
      "default": "left"
    },
    "hero_video_on_phones": {
      "type": "boolean",
      "default": false
    },
    "show_ticker": {
      "type": "boolean",
      "default": true
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "home.highlights",
        "home.notices",
        "home.events",
        "home.introduction",
        "home.message",
        "home.programmes",
        "home.research",
        "home.campus",
        "home.stats",
        "home.resources",
        "home.link-cards",
        "sections.rich-text",
        "sections.image-text",
        "sections.call-to-action"
      ]
    },
    "labels": {
      "type": "component",
      "repeatable": false,
      "component": "home.labels"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "text"
    }
  }
}
