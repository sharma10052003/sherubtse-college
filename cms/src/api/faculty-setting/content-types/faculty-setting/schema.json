{
  "kind": "singleType",
  "collectionName": "faculty_settings",
  "info": {
    "singularName": "faculty-setting",
    "pluralName": "faculty-settings",
    "displayName": "About – Faculty Page"
  },
  "options": {
    "draftAndPublish": false
  },
