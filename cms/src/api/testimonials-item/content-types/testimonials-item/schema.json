{
  "kind": "collectionType",
  "collectionName": "testimonials_items",
  "info": {
    "singularName": "testimonials-item",
    "pluralName": "testimonials-items",
    "displayName": "Testimonials Item"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "photo": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "name": { "type": "string", "required": true },
    "role": { "type": "enumeration", "enum": ["student", "faculty", "alumni", "industry"], "default": "student" },
    "quote": { "type": "text", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "rating": { "type": "integer", "min": 1, "max": 5 },
    "sort_order": { "type": "integer", "default": 0 }
  }
}
