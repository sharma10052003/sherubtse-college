{
  "kind": "collectionType",
  "collectionName": "programme_timetables",
  "info": {
    "singularName": "programme-timetable",
    "pluralName": "programme-timetables",
    "displayName": "Programme Timetable"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "programme": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::programme.programme",
      "required": true
    },
    "year": { "type": "string", "required": true },
    "semester": { "type": "string", "required": true },
    "timetable_file": { "type": "media", "multiple": false, "allowedTypes": ["files"] }
  }
}
