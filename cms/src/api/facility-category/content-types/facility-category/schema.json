{
  "kind": "collectionType",
  "collectionName": "facility_categories",
  "info": {
    "singularName": "facility-category",
    "pluralName": "facility-categories",
    "displayName": "About – Campus Facilities: Categories",
    "description": "Filter categories for the facility directory and gallery. Inactive categories are hidden."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "icon": {
      "type": "enumeration",
      "enum": [
        "book",
        "screen",
        "study",
        "journal",
        "flask",
        "microscope",
        "atom",
        "shield",
        "tools",
        "sport",
        "home",
        "heart",
        "health",
        "wifi",
        "people",
        "pin",
        "clock",
        "link",
        "star"
      ],
      "default": "star"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "display_order": {
      "type": "integer",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  }
}
