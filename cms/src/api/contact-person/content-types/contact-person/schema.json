{
  "kind": "collectionType",
  "collectionName": "contact_people",
  "info": {
    "singularName": "contact-person",
    "pluralName": "contact-people",
    "displayName": "Contact Directory Entry"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "full_name": { "type": "string" },
    "role_title": { "type": "string" },
    "group_title": { "type": "string", "required": true },
    "group_description": { "type": "text" },
    "group_icon": { "type": "string" },
    "group_order": { "type": "integer", "default": 0 },
    "display_order": { "type": "integer", "default": 0 },
    "photo": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "email": { "type": "email" },
    "phone": { "type": "string" },
    "office_location": { "type": "string" },
    "bio": { "type": "text" }
  }
}
