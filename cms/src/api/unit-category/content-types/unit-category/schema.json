{
  "kind": "collectionType",
  "collectionName": "unit_categories",
  "info": {
    "singularName": "unit-category",
    "pluralName": "unit-categories",
    "displayName": "About – Administrative Units: Categories",
    "description": "Groups for the Administrative Units directory. Only categories with published units are shown."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "display_order": {
      "type": "integer",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  }
}
