{
  "kind": "collectionType",
  "collectionName": "vacancy_announcements",
  "info": {
    "singularName": "vacancy-announcement",
    "pluralName": "vacancy-announcements",
    "displayName": "News & Notices – Vacancy Announcements"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "vacancy_announcement",
        "re_vacancy_announcement",
        "shortlisted_written",
        "shortlisted_viva",
        "selection_result",
        "general_notice"
      ],
      "required": true
    },
    "position_name": {
      "type": "string"
    },
    "date_posted": {
      "type": "date",
      "required": true
    },
    "application_deadline": {
      "type": "date"
    },
    "description": {
      "type": "richtext",
      "required": true
    },
    "attachment": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "posting_status": {
      "type": "enumeration",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open",
      "required": true
    },
    "additional_notes": {
      "type": "richtext"
    },
    "position_openings": {
      "type": "component",
      "repeatable": true,
      "component": "announcements.position-opening"
    },
    "written_exam_date": {
      "type": "date"
    },
    "written_exam_time": {
      "type": "string"
    },
    "written_exam_venue": {
      "type": "string"
    },
    "written_exam_shortlist": {
      "type": "component",
      "repeatable": true,
      "component": "announcements.written-exam-candidate"
    },
    "viva_date": {
      "type": "date"
    },
    "viva_time": {
      "type": "string"
    },
    "viva_venue": {
      "type": "string"
    },
    "viva_shortlist": {
      "type": "component",
      "repeatable": true,
      "component": "announcements.shortlist-row"
    },
    "result_date": {
      "type": "date"
    },
    "final_selected": {
      "type": "component",
      "repeatable": true,
      "component": "announcements.shortlist-row"
    }
  }
}
