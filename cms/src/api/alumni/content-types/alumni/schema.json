{
  "kind": "collectionType",
  "collectionName": "alumni_profiles",
  "info": {
    "singularName": "alumni",
    "pluralName": "alumnis",
    "displayName": "Alumni"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "full_name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "full_name" },
    "graduation_year": { "type": "integer" },
    "programme": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::programme.programme"
    },
    "current_role": { "type": "string" },
    "story": { "type": "richtext" },
    "consent": { "type": "boolean", "default": false },
    "photo": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "owning_unit": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::unit.unit",
      "required": true
    },
    "last_reviewed": { "type": "date", "required": true }
  }
}
