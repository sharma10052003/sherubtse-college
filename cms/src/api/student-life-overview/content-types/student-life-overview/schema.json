{
  "kind": "singleType",
  "collectionName": "student_life_overview",
  "info": {
    "singularName": "student-life-overview",
    "pluralName": "student-life-overviews",
    "displayName": "Student Life – Overview"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "eyebrow": {
      "type": "string"
    },
    "heading": {
      "type": "string",
      "required": true
    },
    "intro": {
      "type": "text",
      "required": true
    },
    "hero_photos": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "hero_buttons": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link-item"
    },
    "hero_slide_seconds": {
      "type": "integer",
      "default": 3,
      "min": 1,
      "max": 15
    },
    "featured": {
      "type": "boolean",
      "default": true
    },
    "cards": {
      "type": "component",
      "repeatable": true,
      "component": "shared.landing-card"
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.rich-text",
        "sections.image-text",
        "sections.call-to-action"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "labels": {
      "type": "json"
    }
  }
}
