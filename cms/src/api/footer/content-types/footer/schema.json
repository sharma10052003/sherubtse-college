      "type": "string"
    },
    "map_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "contact_heading": {
      "type": "string",
      "default": "Contact"
    },
    "copyright_text": {
      "type": "string"
    },
    "bottom_links": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link-item"
    }
  }
