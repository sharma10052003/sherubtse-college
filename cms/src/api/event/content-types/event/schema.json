{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": { "type": "string", "required": true },
    "description": { "type": "richtext" },
    "starts_at": { "type": "datetime", "required": true },
    "ends_at": { "type": "datetime" },
    "venue": { "type": "string" },
    "open_to": { "type": "enumeration", "enum": ["public", "students", "staff", "invited"] },
    "registration_link": { "type": "string" },
    "owning_unit": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::unit.unit",
      "required": true
    },
    "last_reviewed": { "type": "date", "required": true },
    "review_interval": { "type": "enumeration", "enum": ["semester", "annual", "none"], "default": "none" },
    "expires_at": { "type": "datetime", "required": true }
  }
}
