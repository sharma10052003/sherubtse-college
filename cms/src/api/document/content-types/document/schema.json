{
  "kind": "collectionType",
  "collectionName": "documents",
  "info": {
    "singularName": "document",
    "pluralName": "documents",
    "displayName": "Document"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": { "type": "string", "required": true },
    "file": { "type": "media", "multiple": false, "allowedTypes": ["files"], "required": true },
    "category": {
      "type": "enumeration",
      "enum": ["policy", "form", "timetable", "guide", "report", "other"]
    },
    "version": { "type": "string" },
    "effective_date": { "type": "date" },
    "review_date": { "type": "date" },
    "is_current": { "type": "boolean", "default": true },
    "source_note": { "type": "text" },
    "owning_unit": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::unit.unit",
      "required": true
    },
    "last_reviewed": { "type": "date", "required": true },
    "review_interval": { "type": "enumeration", "enum": ["semester", "annual", "none"], "default": "none" },
    "expires_at": { "type": "datetime" }
  }
}
