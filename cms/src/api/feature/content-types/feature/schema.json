{
  "kind": "collectionType",
  "collectionName": "features",
  "info": {
    "singularName": "feature",
    "pluralName": "features",
    "displayName": "News & Notices – Features"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title" },
    "standfirst": { "type": "text", "required": true },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::person.person"
    },
    "author_name": { "type": "string" },
    "hero_image": { "type": "media", "multiple": false, "allowedTypes": ["images"], "required": true },
    "body": { "type": "richtext", "required": true },
    "theme": {
      "type": "enumeration",
      "enum": ["research", "student_life", "alumni", "campus", "history", "people"]
    },
    "related_people": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::person.person"
    },
    "related_units": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::unit.unit"
    },
    "owning_unit": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::unit.unit",
      "required": true
    },
    "last_reviewed": { "type": "date", "required": true }
  }
}
