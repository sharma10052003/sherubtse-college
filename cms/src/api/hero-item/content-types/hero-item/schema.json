{
  "kind": "collectionType",
  "collectionName": "hero_items",
  "info": {
    "singularName": "hero-item",
    "pluralName": "hero-items",
    "displayName": "Hero Item"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "item_type": { "type": "enumeration", "enum": ["stat", "badge"], "required": true },
    "icon": { "type": "string", "required": true },
    "value": { "type": "string" },
    "suffix": { "type": "string" },
    "label": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "sort_order": { "type": "integer", "default": 0 }
  }
}
