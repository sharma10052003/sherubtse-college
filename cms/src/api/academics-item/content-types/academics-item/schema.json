{
  "kind": "collectionType",
  "collectionName": "academics_items",
  "info": {
    "singularName": "academics-item",
    "pluralName": "academics-items",
    "displayName": "Academics Item"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "icon": { "type": "string", "required": true },
    "title": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "description": { "type": "text", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "button_url": { "type": "string" },
    "sort_order": { "type": "integer", "default": 0 }
  }
}
