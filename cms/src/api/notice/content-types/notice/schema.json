{
  "kind": "collectionType",
  "collectionName": "notices",
  "info": {
    "singularName": "notice",
    "pluralName": "notices",
    "displayName": "Notice"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": { "type": "string", "required": true },
    "body": { "type": "richtext", "required": true },
    "category": {
      "type": "enumeration",
      "enum": ["admissions", "registration", "results", "fees", "tender", "general"],
      "required": true
    },
    "owning_unit": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::unit.unit",
      "required": true
    },
    "audience": { "type": "json" },
    "publish_at": { "type": "datetime", "required": true },
    "expires_at": { "type": "datetime", "required": true },
    "urgency": { "type": "enumeration", "enum": ["normal", "urgent"], "default": "normal" },
    "attachments": {
      "type": "component",
      "repeatable": true,
      "component": "shared.attachment"
    },
    "featured_for_international": { "type": "boolean", "default": false },
    "last_reviewed": { "type": "date", "required": true },
    "review_interval": { "type": "enumeration", "enum": ["semester", "annual", "none"], "default": "none" }
  }
}
