{
  "kind": "collectionType",
  "collectionName": "facility_gallery_images",
  "info": {
    "singularName": "facility-gallery-image",
    "pluralName": "facility-gallery-images",
    "displayName": "About – Campus Facilities: Gallery",
    "description": "Real Sherubtse photographs for the Campus Gallery. Always add alternative text."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "required": true
    },
    "caption": {
      "type": "string"
    },
    "alt_text": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::facility-category.facility-category"
    },
    "facility": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::facility.facility"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "display_order": {
      "type": "integer",
      "default": 0
    }
  }
}
