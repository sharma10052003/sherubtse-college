{
  "collectionName": "components_home_stats",
  "info": {
    "displayName": "Facts & Figures",
    "icon": "chartBubble",
    "description": "Verified figures only. The section hides itself when none are verified."
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string"
    },
    "intro": {
      "type": "text"
    },
    "is_visible": {
      "type": "boolean",
      "default": true
    },
    "background": {
      "type": "enumeration",
      "enum": [
        "white",
        "soft",
        "navy"
      ],
      "default": "white"
    },
    "width": {
      "type": "enumeration",
      "enum": [
        "full",
        "half"
      ],
      "default": "full"
    },
    "anchor": {
      "type": "string",
      "regex": "^[a-z0-9-]*$"
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "home.stat"
    },
    "button_label": {
      "type": "string"
    },
    "button_url": {
      "type": "string"
    }
  }
}
