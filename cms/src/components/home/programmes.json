{
  "collectionName": "components_home_programmes",
  "info": {
    "displayName": "Programmes",
    "icon": "book",
    "description": "Programme cards. Pick programmes to show them in that order; leave empty to show all."
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string"
    },
    "intro": {
      "type": "text"
    },
    "is_visible": {
      "type": "boolean",
      "default": true
    },
    "background": {
      "type": "enumeration",
      "enum": [
        "white",
        "soft",
        "navy"
      ],
      "default": "white"
    },
    "width": {
      "type": "enumeration",
      "enum": [
        "full",
        "half"
      ],
      "default": "full"
    },
    "anchor": {
      "type": "string",
      "regex": "^[a-z0-9-]*$"
    },
    "programmes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::programme.programme"
    },
    "limit": {
      "type": "integer",
      "default": 8,
      "min": 1,
      "max": 24
    },
    "button_label": {
      "type": "string"
    },
    "button_url": {
      "type": "string"
    }
  }
}
