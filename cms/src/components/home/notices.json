{
  "collectionName": "components_home_notices",
  "info": {
    "displayName": "News & Notices",
    "icon": "bell",
    "description": "The latest notices, vacancies and announcements (the same feed as the Announcements page)."
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string"
    },
    "intro": {
      "type": "text"
    },
    "is_visible": {
      "type": "boolean",
      "default": true
    },
    "background": {
      "type": "enumeration",
      "enum": [
        "white",
        "soft",
        "navy"
      ],
      "default": "white"
    },
    "width": {
      "type": "enumeration",
      "enum": [
        "full",
        "half"
      ],
      "default": "full"
    },
    "anchor": {
      "type": "string",
      "regex": "^[a-z0-9-]*$"
    },
    "limit": {
      "type": "integer",
      "default": 5,
      "min": 1,
      "max": 12
    },
    "pinned_first": {
      "type": "boolean",
      "default": true
    },
    "empty_text": {
      "type": "string"
    },
    "button_label": {
      "type": "string"
    },
    "button_url": {
      "type": "string"
    }
  }
}
