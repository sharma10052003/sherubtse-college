{
  "collectionName": "components_home_messages",
  "info": {
    "displayName": "Leadership Message",
    "icon": "quote",
    "description": "A message from the President. Hidden until a message is entered."
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string"
    },
    "intro": {
      "type": "text"
    },
    "is_visible": {
      "type": "boolean",
      "default": true
    },
    "background": {
      "type": "enumeration",
      "enum": [
        "white",
        "soft",
        "navy"
      ],
      "default": "white"
    },
    "width": {
      "type": "enumeration",
      "enum": [
        "full",
        "half"
      ],
      "default": "full"
    },
    "anchor": {
      "type": "string",
      "regex": "^[a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "message": {
      "type": "richtext"
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "photo_alt": {
      "type": "string"
    },
    "button_label": {
      "type": "string"
    },
    "button_url": {
      "type": "string"
    }
  }
}
