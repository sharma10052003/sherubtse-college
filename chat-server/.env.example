# “Ask Sherubtse” AI chat server. Copy to chat-server/.env (never commit .env).

# Free key from https://aistudio.google.com (Get API key). Without it the
# assistant still works, showing matching pages instead of written answers.
GEMINI_API_KEY=

# Gemini model. gemini-3.1-flash-lite was the steadiest on the free tier
# (Oct 2026). Check the names your key may use at https://aistudio.google.com/rate-limit
GEMINI_MODEL=gemini-3.1-flash-lite

# Most AI answers per day (Bhutan time). Keep it under your free-tier limit;
# after it, the assistant shows matching pages until midnight.
DAILY_LIMIT=1000

# Per visitor, to stop one person using up the day's answers.
PER_VISITOR_PER_MINUTE=6
PER_VISITOR_PER_DAY=60

# The built website the assistant reads (relative to this folder).
# On the server: /var/www/sherubtse
SITE_DIR=../web/dist

CHAT_PORT=4600

# Tried when the main model is busy. Leave empty to skip.
GEMINI_BACKUP_MODEL=gemini-3.5-flash-lite
